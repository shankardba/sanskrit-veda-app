{
  "id": "sri-rudram-namakam",
  "title": {
    "devanagari": "श्री रुद्रं नमकम्",
    "iast": "Śrī Rudraṁ Namakam"
  },
  "source": {
    "site": "vignanam.org",
    "devanagari_url": "https://vignanam.org/devanagari/sri-rudram-namakam.html",
    "iast_url": "https://vignanam.org/english/sri-rudram-namakam.html"
  },
  "colophon": {
    "devanagari": "कृष्ण यजुर्वेदीय तैत्तिरीय संहिता / चतुर्थं-वैँश्वदेव-ङ्काण्ड-म्पञ्चमः प्रपाठकः",
    "iast": "kṛṣṇa yajurvēdīya taittirīya saṃhitā / chaturthaṃ vaiśvadēva-ṅkāṇḍa-mpañchamaḥ prapāṭhakaḥ"
  },
  "sections": [
    {
      "label": "1",
      "lines": [
        {
          "n": 1,
          "devanagari": "ओ-न्नमो भगवते॑ रुद्रा॒य ॥",
          "iast": "ō-nnamō bhagavatē̍ rudrā̠ya ॥"
        },
        {
          "n": 2,
          "devanagari": "नम॑स्ते रुद्र म॒न्यव॑ उ॒तोत॒ इष॑वे॒ नमः॑ ।",
          "iast": "nama̍stē rudra ma̠nyava̍ u̠tōta̠ iṣa̍vē̠ nama̍ḥ ।"
        },
        {
          "n": 3,
          "devanagari": "नम॑स्ते अस्तु॒ धन्व॑ने बा॒हुभ्या॑मु॒त ते॒ नमः॑ ॥",
          "iast": "nama̍stē astu̠ dhanva̍nē bā̠hubhyā̍mu̠ta tē̠ nama̍ḥ ॥"
        },
        {
          "n": 4,
          "devanagari": "या त॒ इषुः॑ शि॒वत॑मा शि॒व-म्ब॒भूव॑ ते॒ धनुः॑ ।",
          "iast": "yā ta̠ iṣu̍-śśi̠vata̍mā śi̠va-mba̠bhūva̍ tē̠ dhanu̍ḥ ।"
        },
        {
          "n": 5,
          "devanagari": "शि॒वा श॑र॒व्या॑ या तव॒ तया॑ नो रुद्र मृडय ।",
          "iast": "śi̠vā śa̍ra̠vyā̍ yā tava̠ tayā̍ nō rudra mṛḍaya ।"
        },
        {
          "n": 6,
          "devanagari": "या ते॑ रुद्र शि॒वा त॒नूरघो॒रा-ऽपा॑पकाशिनी ।",
          "iast": "yā tē̍ rudra śi̠vā ta̠nūraghō̠rā-'pā̍pakāśinī ।"
        },
        {
          "n": 7,
          "devanagari": "तया॑ नस्त॒नुवा॒ शन्त॑मया॒ गिरि॑शन्ता॒भिचा॑कशीहि ॥",
          "iast": "tayā̍ nasta̠nuvā̠ śanta̍mayā̠ giri̍śantā̠bhichā̍kaśīhi ॥"
        },
        {
          "n": 8,
          "devanagari": "यामिषु॑-ङ्गिरिशन्त॒ हस्ते॒ बिभ॒र्​ष्यस्त॑वे ।",
          "iast": "yāmiṣu̍-ṅgiriśanta̠ hastē̠ bibha̠r​ṣyasta̍vē ।"
        },
        {
          "n": 9,
          "devanagari": "शि॒वा-ङ्गि॑रित्र॒ ता-ङ्कु॑रु॒ मा हिग्ं॑सीः॒ पुरु॑ष॒-ञ्जग॑त्॥",
          "iast": "śi̠vā-ṅgi̍ritra̠ tā-ṅku̍ru̠ mā hig̍ṃsī̠ḥ puru̍ṣa̠-ñjaga̍t॥"
        },
        {
          "n": 10,
          "devanagari": "शि॒वेन॒ वच॑सा त्वा॒ गिरि॒शाच्छा॑ वदामसि ।",
          "iast": "śi̠vēna̠ vacha̍sā tvā̠ giri̠śāchChā̍ vadāmasi ।"
        },
        {
          "n": 11,
          "devanagari": "यथा॑ न॒-स्सर्व॒मिज्जग॑दय॒क्ष्मग्ं सु॒मना॒ अस॑त् ॥",
          "iast": "yathā̍ na̠-ssarva̠mijjaga̍daya̠kṣmagṃ su̠manā̠ asa̍t ॥"
        },
        {
          "n": 12,
          "devanagari": "अध्य॑वोचदधिव॒क्ता प्र॑थ॒मो दैव्यो॑ भि॒षक् ।",
          "iast": "adhya̍vōchadadhiva̠ktā pra̍tha̠mō daivyō̍ bhi̠ṣak ।"
        },
        {
          "n": 13,
          "devanagari": "अहीग्॑श्च॒ सर्वा᳚ञ्ज॒म्भय॒न्-थ्सर्वा᳚श्च यातुधा॒न्यः॑ ॥",
          "iast": "ahīg̍ścha̠ sarvā̎mja̠mbhaya̠n-thsarvā̎ścha yātudhā̠nya̍ḥ ॥"
        },
        {
          "n": 14,
          "devanagari": "अ॒सौ यस्ता॒म्रो अ॑रु॒ण उ॒त ब॒भ्रुस्सु॑म॒ङ्गलः॑ ।",
          "iast": "a̠sau yastā̠mrō a̍ru̠ṇa u̠ta ba̠bhrussu̍ma̠ṅgala̍ḥ ।"
        },
        {
          "n": 15,
          "devanagari": "ये चे॒माग्ं रु॒द्रा अ॒भितो॑ दि॒क्षु श्रि॒ता-स्स॑हस्र॒शो-ऽवै॑षा॒ग्ं॒ हेड॑ ईमहे ॥",
          "iast": "yē chē̠māgṃ ru̠drā a̠bhitō̍ di̠kṣu śri̠tā-ssa̍hasra̠śō-'vai̍ṣā̠gṃ̠ hēḍa̍ īmahē ॥"
        },
        {
          "n": 16,
          "devanagari": "अ॒सौ यो॑-ऽव॒सर्प॑ति॒ नील॑ग्रीवो॒ विलो॑हितः ।",
          "iast": "a̠sau yō̍-'va̠sarpa̍ti̠ nīla̍grīvō̠ vilō̍hitaḥ ।"
        },
        {
          "n": 17,
          "devanagari": "उ॒तैन॑-ङ्गो॒पा अ॑दृश॒न्नदृ॑शन्नुदहा॒र्यः॑ ।",
          "iast": "u̠taina̍-ṅgō̠pā a̍dṛśa̠nnadṛ̍śannudahā̠rya̍ḥ ।"
        },
        {
          "n": 18,
          "devanagari": "उ॒तैनं॒-विँश्वा॑ भू॒तानि॒ स दृ॒ष्टो मृ॑डयाति नः ॥",
          "iast": "u̠taina̠ṃ viśvā̍ bhū̠tāni̠ sa dṛ̠ṣṭō mṛ̍ḍayāti naḥ ॥"
        },
        {
          "n": 19,
          "devanagari": "नमो॑ अस्तु॒ नील॑ग्रीवाय सहस्रा॒क्षाय॑ मी॒ढुषे᳚ ।",
          "iast": "namō̍ astu̠ nīla̍grīvāya sahasrā̠kṣāya̍ mī̠ḍhuṣē̎ ।"
        },
        {
          "n": 20,
          "devanagari": "अथो॒ ये अ॑स्य॒ सत्वा॑नो॒-ऽह-न्तेभ्यो॑-ऽकर॒न्नमः॑ ॥",
          "iast": "athō̠ yē a̍sya̠ satvā̍nō̠-'ha-ntēbhyō̍-'kara̠nnama̍ḥ ॥"
        },
        {
          "n": 21,
          "devanagari": "प्रमु॑ञ्च॒ धन्व॑न॒स्त्वमु॒भयो॒रार्त्नि॑ यो॒र्ज्याम् ।",
          "iast": "pramu̍ñcha̠ dhanva̍na̠stvamu̠bhayō̠rārtni̍ yō̠rjyām ।"
        },
        {
          "n": 22,
          "devanagari": "याश्च॑ ते॒ हस्त॒ इष॑वः॒ परा॒ ता भ॑गवो वप ॥",
          "iast": "yāścha̍ tē̠ hasta̠ iṣa̍va̠ḥ parā̠ tā bha̍gavō vapa ॥"
        },
        {
          "n": 23,
          "devanagari": "अ॒व॒तत्य॒ धनु॒स्त्वग्ं सह॑स्राक्ष॒ शते॑षुधे ।",
          "iast": "a̠va̠tatya̠ dhanu̠stvagṃ saha̍srākṣa̠ śatē̍ṣudhē ।"
        },
        {
          "n": 24,
          "devanagari": "नि॒शीर्य॑ श॒ल्याना॒-म्मुखा॑ शि॒वो नः॑ सु॒मना॑ भव ॥",
          "iast": "ni̠śīrya̍ śa̠lyānā̠-mmukhā̍ śi̠vō na̍-ssu̠manā̍ bhava ॥"
        },
        {
          "n": 25,
          "devanagari": "विज्य॒-न्धनुः॑ कप॒र्दिनो॒ विश॑ल्यो॒ बाण॑वाग्ं उ॒त ।",
          "iast": "vijya̠-ndhanu̍ḥ kapa̠rdinō̠ viśa̍lyō̠ bāṇa̍vāgṃ u̠ta ।"
        },
        {
          "n": 26,
          "devanagari": "अने॑शन्न॒स्येष॑व आ॒भुर॑स्य निष॒ङ्गथिः॑ ॥",
          "iast": "anē̍śanna̠syēṣa̍va ā̠bhura̍sya niṣa̠ṅgathi̍ḥ ॥"
        },
        {
          "n": 27,
          "devanagari": "या ते॑ हे॒तिर्मी॑डुष्टम॒ हस्ते॑ ब॒भूव॑ ते॒ धनुः॑ ।",
          "iast": "yā tē̍ hē̠tirmī̍ḍuṣṭama̠ hastē̍ ba̠bhūva̍ tē̠ dhanu̍ḥ ।"
        },
        {
          "n": 28,
          "devanagari": "तया॒-ऽस्मान्, वि॒श्वत॒स्त्वम॑य॒क्ष्मया॒ परि॑ब्भुज ॥",
          "iast": "tayā̠-'smān, vi̠śvata̠stvama̍ya̠kṣmayā̠ pari̍bbhuja ॥"
        },
        {
          "n": 29,
          "devanagari": "नम॑स्ते अ॒स्त्वायु॑धा॒याना॑तताय धृ॒ष्णवे᳚ ।",
          "iast": "nama̍stē a̠stvāyu̍dhā̠yānā̍tatāya dhṛ̠ṣṇavē̎ ।"
        },
        {
          "n": 30,
          "devanagari": "उ॒भाभ्या॑मु॒त ते॒ नमो॑ बा॒हुभ्या॒-न्तव॒ धन्व॑ने ॥",
          "iast": "u̠bhābhyā̍mu̠ta tē̠ namō̍ bā̠hubhyā̠-ntava̠ dhanva̍nē ॥"
        },
        {
          "n": 31,
          "devanagari": "परि॑ ते॒ धन्व॑नो हे॒तिर॒स्मान् वृ॑णक्तु वि॒श्वतः॑ ।",
          "iast": "pari̍ tē̠ dhanva̍nō hē̠tira̠smān vṛ̍ṇaktu vi̠śvata̍ḥ ।"
        },
        {
          "n": 32,
          "devanagari": "अथो॒ य इ॑षु॒धिस्तवा॒रे अ॒स्मन्निधे॑हि॒ तम् ॥ 1 ॥",
          "iast": "athō̠ ya i̍ṣu̠dhistavā̠rē a̠smannidhē̍hi̠ tam ॥ 1 ॥"
        }
      ]
    },
    {
      "label": "2",
      "lines": [
        {
          "n": 33,
          "devanagari": "श्री शम्भ॑वे॒ नमः॑ ॥",
          "iast": "śrī śambha̍vē̠ nama̍ḥ ॥"
        },
        {
          "n": 34,
          "devanagari": "नम॑स्ते अस्तु भगवन्-विश्वेश्व॒राय॑ महादे॒वाय॑ त्र्यम्ब॒काय॑  त्रिपुरान्त॒काय॑ त्रिकाग्निका॒लाय॑ कालाग्निरु॒द्राय॑  नीलक॒ण्ठाय॑ मृत्युञ्ज॒याय॑ सर्वेश्व॒राय॑  सदाशि॒वाय॑ [शङ्क॒राय॑] श्रीम-न्महादे॒वाय॒ नमः॑ ।",
          "iast": "nama̍stē astu bhagavan-viśvēśva̠rāya̍ mahādē̠vāya̍ tryamba̠kāya̍  tripurānta̠kāya̍ trikāgnikā̠lāya̍ kālāgniru̠drāya̍  nīlaka̠ṇṭhāya̍ mṛtyuñja̠yāya̍ sarvēśva̠rāya̍  sadāśi̠vāya̍ [śaṅka̠rāya̍] śrīma-nmahādē̠vāya̠ nama̍ḥ ।"
        },
        {
          "n": 35,
          "devanagari": "नमो॒ हिर॑ण्य बाहवे सेना॒न्ये॑ दि॒शा-ञ्च॒ पत॑ये॒ नमो॒",
          "iast": "namō̠ hira̍ṇya bāhavē sēnā̠nyē̍ di̠śā-ñcha̠ pata̍yē̠ namō̠"
        },
        {
          "n": 36,
          "devanagari": "नमो॑ वृ॒क्षेभ्यो॒ हरि॑केशेभ्यः पशू॒ना-म्पत॑ये॒ नमो॒",
          "iast": "namō̍ vṛ̠kṣēbhyō̠ hari̍kēśēbhyaḥ paśū̠nā-mpata̍yē̠ namō̠"
        },
        {
          "n": 37,
          "devanagari": "नमः॑ स॒स्पिञ्ज॑राय॒ त्विषी॑मते पथी॒ना-म्पत॑ये॒ नमो॒",
          "iast": "nama̍-ssa̠spiñja̍rāya̠ tviṣī̍matē pathī̠nā-mpata̍yē̠ namō̠"
        },
        {
          "n": 38,
          "devanagari": "नमो॑ बभ्लु॒शाय॑ विव्या॒धिने-ऽन्ना॑ना॒-म्पत॑ये॒ नमो॒",
          "iast": "namō̍ babhlu̠śāya̍ vivyā̠dhinē-'nnā̍nā̠-mpata̍yē̠ namō̠"
        },
        {
          "n": 39,
          "devanagari": "नमो॒ हरि॑केशायोपवी॒तिने॑ पु॒ष्टाना॒-म्पत॑ये॒ नमो॒",
          "iast": "namō̠ hari̍kēśāyōpavī̠tinē̍ pu̠ṣṭānā̠-mpata̍yē̠ namō̠"
        },
        {
          "n": 40,
          "devanagari": "नमो॑ भ॒वस्य॑ हे॒त्यै जग॑ता॒-म्पत॑ये॒ नमो॒",
          "iast": "namō̍ bha̠vasya̍ hē̠tyai jaga̍tā̠-mpata̍yē̠ namō̠"
        },
        {
          "n": 41,
          "devanagari": "नमो॑ रु॒द्राया॑तता॒विने॒ क्षेत्रा॑णा॒-म्पत॑ये॒ नमो॒",
          "iast": "namō̍ ru̠drāyā̍tatā̠vinē̠ kṣētrā̍ṇā̠-mpata̍yē̠ namō̠"
        },
        {
          "n": 42,
          "devanagari": "नम॑स्सू॒तायाह॑न्त्याय॒ वना॑ना॒-म्पत॑ये॒ नमो॒",
          "iast": "nama̍ssū̠tāyāha̍ntyāya̠ vanā̍nā̠-mpata̍yē̠ namō̠"
        },
        {
          "n": 43,
          "devanagari": "नमो॒ रोहि॑ताय स्थ॒पत॑ये वृ॒क्षाणा॒-म्पत॑ये॒ नमो॒",
          "iast": "namō̠ rōhi̍tāya stha̠pata̍yē vṛ̠kṣāṇā̠-mpata̍yē̠ namō̠"
        },
        {
          "n": 44,
          "devanagari": "नमो॑ म॒न्त्रिणे॑ वाणि॒जाय॒ कक्षा॑णा॒-म्पत॑ये॒ नमो॒",
          "iast": "namō̍ ma̠ntriṇē̍ vāṇi̠jāya̠ kakṣā̍ṇā̠-mpata̍yē̠ namō̠"
        },
        {
          "n": 45,
          "devanagari": "नमो॑ भुव॒न्तये॑ वारिवस्कृ॒ता-यौष॑धीना॒-म्पत॑ये॒ नमो॒",
          "iast": "namō̍ bhuva̠ntayē̍ vārivaskṛ̠tā-yauṣa̍dhīnā̠-mpata̍yē̠ namō̠"
        },
        {
          "n": 46,
          "devanagari": "नम॑ उ॒च्चैर्घो॑षायाक्र॒न्दय॑ते पत्ती॒ना-म्पत॑ये॒ नमो॒",
          "iast": "nama̍ u̠chchairghō̍ṣāyākra̠ndaya̍tē pattī̠nā-mpata̍yē̠ namō̠"
        },
        {
          "n": 47,
          "devanagari": "नमः॑ कृत्स्नवी॒ताय॒ धाव॑ते॒ सत्त्व॑ना॒-म्पत॑ये॒ नमः॑ ॥ 2 ॥",
          "iast": "nama̍ḥ kṛtsnavī̠tāya̠ dhāva̍tē̠ sattva̍nā̠-mpata̍yē̠ nama̍ḥ ॥ 2 ॥"
        }
      ]
    },
    {
      "label": "3",
      "lines": [
        {
          "n": 48,
          "devanagari": "नम॒-स्सह॑मानाय निव्या॒धिन॑ आव्या॒धिनी॑ना॒-म्पत॑ये॒ नमो॒",
          "iast": "nama̠-ssaha̍mānāya nivyā̠dhina̍ āvyā̠dhinī̍nā̠-mpata̍yē̠ namō̠"
        },
        {
          "n": 49,
          "devanagari": "नमः॑ ककु॒भाय॑ निष॒ङ्गिणे᳚ स्ते॒नाना॒-म्पत॑ये॒ नमो॒",
          "iast": "nama̍ḥ kaku̠bhāya̍ niṣa̠ṅgiṇē̎ stē̠nānā̠-mpata̍yē̠ namō̠"
        },
        {
          "n": 50,
          "devanagari": "नमो॑ निष॒ङ्गिण॑ इषुधि॒मते॒ तस्क॑राणा॒-म्पत॑ये॒ नमो॒",
          "iast": "namō̍ niṣa̠ṅgiṇa̍ iṣudhi̠matē̠ taska̍rāṇā̠-mpata̍yē̠ namō̠"
        },
        {
          "n": 51,
          "devanagari": "नमो॒ वञ्च॑ते परि॒वञ्च॑ते स्तायू॒ना-म्पत॑ये॒ नमो॒",
          "iast": "namō̠ vañcha̍tē pari̠vañcha̍tē stāyū̠nā-mpata̍yē̠ namō̠"
        },
        {
          "n": 52,
          "devanagari": "नमो॑ निचे॒रवे॑ परिच॒रायार॑ण्याना॒-म्पत॑ये॒ नमो॒",
          "iast": "namō̍ nichē̠ravē̍ paricha̠rāyāra̍ṇyānā̠-mpata̍yē̠ namō̠"
        },
        {
          "n": 53,
