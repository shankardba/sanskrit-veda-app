{
  "id": "tiruvirattai-manimalai",
  "language": "tamil",
  "title": {
    "devanagari": "திருஇரட்டை மணிமாலை",
    "iast": "Tiruiraṭṭai Maṇimālai"
  },
  "source": {
    "site": "projectmadurai.org",
    "devanagari_url": "https://www.projectmadurai.org/pm_etexts/utf8/pmuni0126.html",
    "note": "By Kāraikkāl Ammaiyār. Tamil text from Project Madurai's Unicode edition, in its own metrical word-division, with its recitation marks ((2), *) dropped. ISO 15919 transliteration generated by scripts/tamil_to_iso.py; English translation prepared for this app."
  },
  "colophon": {
    "devanagari": "திருச்சிற்றம்பலம்",
    "iast": "tirucciṟṟampalam"
  },
  "sectionUnit": "Verse",
  "sections": [
    {
      "label": "1",
      "lines": [
        {
          "n": 1,
          "devanagari": "கிளர்ந்துந்து வெந்துயர் வந்தடும் போதஞ்சி நெஞ்சம்என்பாய்த்",
          "iast": "kiḷarntuntu ventuyar vantaṭum pōtañci neñcameṉpāyt"
        },
        {
          "n": 2,
          "devanagari": "தளர்ந்திங் கிருத்தல் தவிர்திகண் டாய்தள ராதுவந்தி",
          "iast": "taḷarntiṅ kiruttal tavirtikaṇ ṭāytaḷa rātuvanti"
        },
        {
          "n": 3,
          "devanagari": "வளர்ந்துந்து கங்கையும் வானத் திடைவளர் கோட்டுவெள்ளை",
          "iast": "vaḷarntuntu kaṅkaiyum vāṉat tiṭaivaḷar kōṭṭuveḷḷai"
        },
        {
          "n": 4,
          "devanagari": "இளந்திங் களும்எருக் கும்மிருக் குஞ்சென்னி ஈசனுக்கே",
          "iast": "iḷantiṅ kaḷumeruk kummiruk kuñceṉṉi īcaṉukkē"
        }
      ]
    },
    {
      "label": "2",
      "lines": [
        {
          "n": 5,
          "devanagari": "ஈசன் அவன்அல்லா தில்லை எனநினைந்து",
          "iast": "īcaṉ avaṉallā tillai eṉaniṉaintu"
        },
        {
          "n": 6,
          "devanagari": "கூசி மனத்தகத்துக் கொண்டிருந்து - பேசி",
          "iast": "kūci maṉattakattuk koṇṭiruntu - pēci"
        },
        {
          "n": 7,
          "devanagari": "மறவாது வாழ்வாரை மண்ணுலகத் தென்றும்",
          "iast": "maṟavātu vāḻvārai maṇṇulakat teṉṟum"
        },
        {
          "n": 8,
          "devanagari": "பிறவாமைக் காக்கும் பிரான்",
          "iast": "piṟavāmaik kākkum pirāṉ"
        }
      ]
    },
    {
      "label": "3",
      "lines": [
        {
          "n": 9,
          "devanagari": "பிரானென்று தன்னைப்பன் னாள்பர வித்தொழு வார்இடர்கண்",
          "iast": "pirāṉeṉṟu taṉṉaippaṉ ṉāḷpara vittoḻu vāriṭarkaṇ"
        },
        {
          "n": 10,
          "devanagari": "டிரான்என்ன நிற்கின்ற ஈசன்கண் டீர்இன வண்டுகிண்டிப்",
          "iast": "ṭirāṉeṉṉa niṟkiṉṟa īcaṉkaṇ ṭīriṉa vaṇṭukiṇṭip"
        },
        {
          "n": 11,
          "devanagari": "பொராநின்ற கொன்றைப் பொதும்பர்க் கிடந்துபொம் மென்றுறைவாய்",
          "iast": "porāniṉṟa koṉṟaip potumpark kiṭantupom meṉṟuṟaivāy"
        },
        {
          "n": 12,
          "devanagari": "அராநின் றிரைக்குஞ் சடைச்செம்பொன் நீள்முடி அந்தணனே",
          "iast": "arāniṉ ṟiraikkuñ caṭaiccempoṉ nīḷmuṭi antaṇaṉē"
        }
      ]
    },
    {
      "label": "4",
      "lines": [
        {
          "n": 13,
          "devanagari": "அந்தணனைத் தஞ்செமென் றாட்பட்டார் ஆழாமே",
          "iast": "antaṇaṉait tañcemeṉ ṟāṭpaṭṭār āḻāmē"
        },
        {
          "n": 14,
          "devanagari": "வந்தணைந்து காத்தளிக்கும் வல்லாளன் - கொந்தணைந்த",
          "iast": "vantaṇaintu kāttaḷikkum vallāḷaṉ - kontaṇainta"
        },
        {
          "n": 15,
          "devanagari": "பொன்கண்டாற் பூணாதே கோள்நாகம் பூண்டானே",
          "iast": "poṉkaṇṭāṟ pūṇātē kōḷnākam pūṇṭāṉē"
        },
        {
          "n": 16,
          "devanagari": "என்கண்டாய் நெஞ்சே இனி",
          "iast": "eṉkaṇṭāy neñcē iṉi"
        }
      ]
    },
    {
      "label": "5",
      "lines": [
        {
          "n": 17,
          "devanagari": "இனிவார் சடையினிற் கங்கையென் பாளைஅங் கத்திருந்த",
          "iast": "iṉivār caṭaiyiṉiṟ kaṅkaiyeṉ pāḷaiaṅ kattirunta"
        },
        {
          "n": 18,
          "devanagari": "கனிவாய் மலைமங்கை காணில்என் செய்திகை யிற்சிலையால்",
          "iast": "kaṉivāy malaimaṅkai kāṇileṉ ceytikai yiṟcilaiyāl"
        },
        {
          "n": 19,
          "devanagari": "முனிவார் திரிபுரம் மூன்றும்வெந் தன்றுசெந் தீயில்முழ்கத்",
          "iast": "muṉivār tiripuram mūṉṟumven taṉṟucen tīyilmuḻkat"
        },
        {
          "n": 20,
          "devanagari": "தனிவார் கணைஒன்றி னால்மிகக் கோத்தஎஞ் சங்கரனே",
          "iast": "taṉivār kaṇaioṉṟi ṉālmikak kōttaeñ caṅkaraṉē"
        }
      ]
    },
    {
      "label": "6",
      "lines": [
        {
          "n": 21,
          "devanagari": "சங்கரனைத் தாழ்ந்த சடையானை அச்சடைமேற்",
          "iast": "caṅkaraṉait tāḻnta caṭaiyāṉai accaṭaimēṟ"
        },
        {
          "n": 22,
          "devanagari": "பொங்கரவம் வைத்துகந்த புண்ணியனை - அங்கொருநாள்",
          "iast": "poṅkaravam vaittukanta puṇṇiyaṉai - aṅkorunāḷ"
        },
        {
          "n": 23,
          "devanagari": "ஆவாவென் றாழாமைக் காப்பானை எப்பொழுதும்",
          "iast": "āvāveṉ ṟāḻāmaik kāppāṉai eppoḻutum"
        },
        {
          "n": 24,
          "devanagari": "ஓவாது நெஞ்சே உரை",
          "iast": "ōvātu neñcē urai"
        }
      ]
    },
    {
      "label": "7",
      "lines": [
        {
          "n": 25,
          "devanagari": "உரைக்கப் படுவதும் ஒன்றுண்டு கேட்கிற்செவ் வான்தொடைமேல்",
          "iast": "uraikkap paṭuvatum oṉṟuṇṭu kēṭkiṟcev vāṉtoṭaimēl"
        },
        {
          "n": 26,
          "devanagari": "இரைக்கின்ற பாம்பினை என்றும் தொடேல்இழிந் தோட்டந்தெங்கும்",
          "iast": "iraikkiṉṟa pāmpiṉai eṉṟum toṭēliḻin tōṭṭanteṅkum"
        },
        {
          "n": 27,
          "devanagari": "திரைக்கின்ற கங்கையும் தேன்நின்ற கொன்றையும் செஞ்சடைமேல்",
          "iast": "tiraikkiṉṟa kaṅkaiyum tēṉniṉṟa koṉṟaiyum ceñcaṭaimēl"
        },
        {
          "n": 28,
          "devanagari": "விரைக்கின்ற வன்னியுஞ் சென்னித் தலைவைத்த வேதியனே",
          "iast": "viraikkiṉṟa vaṉṉiyuñ ceṉṉit talaivaitta vētiyaṉē"
        }
      ]
    },
    {
      "label": "8",
      "lines": [
        {
          "n": 29,
          "devanagari": "வேதியனை வேதப் பொருளானை வேதத்துக்",
          "iast": "vētiyaṉai vētap poruḷāṉai vētattuk"
        },
        {
          "n": 30,
          "devanagari": "காதியனை ஆதிரைநன் னாளானைச் - சோதிப்பான்",
          "iast": "kātiyaṉai ātirainaṉ ṉāḷāṉaic - cōtippāṉ"
        },
        {
          "n": 31,
          "devanagari": "வல்லேன மாய்ப்புக்கு மாலவனும் மாட்டாது",
          "iast": "vallēṉa māyppukku mālavaṉum māṭṭātu"
        },
        {
          "n": 32,
          "devanagari": "கில்லேன மாஎன்றான் கீழ்",
          "iast": "killēṉa māeṉṟāṉ kīḻ"
        }
      ]
    },
    {
      "label": "9",
      "lines": [
        {
          "n": 33,
          "devanagari": "கீழா யினதுன்ப வெள்ளக் கடல்தள்ளி உள்ளுறப்போய்",
          "iast": "kīḻā yiṉatuṉpa veḷḷak kaṭaltaḷḷi uḷḷuṟappōy"
        },
        {
          "n": 34,
          "devanagari": "வீழா திருந்தின்பம் வேண்டுமென் பீர்விர வார்புரங்கள்",
          "iast": "vīḻā tiruntiṉpam vēṇṭumeṉ pīrvira vārpuraṅkaḷ"
        },
        {
          "n": 35,
          "devanagari": "பாழா யிடக்கண்ட கண்டன்எண் தோளன்பைம் பொற்கழலே",
          "iast": "pāḻā yiṭakkaṇṭa kaṇṭaṉeṇ tōḷaṉpaim poṟkaḻalē"
        },
        {
          "n": 36,
          "devanagari": "தாழா திறைஞ்சிப் பணிந்துபன் னாளும் தலைநின்மினே",
          "iast": "tāḻā tiṟaiñcip paṇintupaṉ ṉāḷum talainiṉmiṉē"
        }
      ]
    },
    {
      "label": "10",
      "lines": [
        {
          "n": 37,
          "devanagari": "தலையாய ஐந்தினையுஞ் சாதித்துத் தாழ்ந்து",
          "iast": "talaiyāya aintiṉaiyuñ cātittut tāḻntu"
        },
        {
          "n": 38,
          "devanagari": "தலையா யினஉணர்ந்தோர்காண்பர் - தலையாய",
          "iast": "talaiyā yiṉauṇarntōrkāṇpar - talaiyāya"
        },
        {
          "n": 39,
          "devanagari": "அண்டத்தான் ஆதிரையான் ஆலாலம் உண்டிருண்ட",
          "iast": "aṇṭattāṉ ātiraiyāṉ ālālam uṇṭiruṇṭa"
        },
        {
          "n": 40,
          "devanagari": "கண்டத்தான் செம்பொற் கழல்",
          "iast": "kaṇṭattāṉ cempoṟ kaḻal"
        }
      ]
    },
    {
      "label": "11",
      "lines": [
        {
          "n": 41,
          "devanagari": "கழற்கொண்ட சேவடி காணலுற் றார்தம்மைப் பேணலுற்றார்",
          "iast": "kaḻaṟkoṇṭa cēvaṭi kāṇaluṟ ṟārtammaip pēṇaluṟṟār"
        },
        {
          "n": 42,
          "devanagari": "நிழற்கண்ட போழ்தத்து நில்லா வினைநிகர் ஏதுமின்றித்",
          "iast": "niḻaṟkaṇṭa pōḻtattu nillā viṉainikar ētumiṉṟit"
        },
        {
          "n": 43,
          "devanagari": "தழற்கொண்ட சோதிச் செம் மேனிஎம் மானைக்கைம் மாமலர்தூய்த்",
          "iast": "taḻaṟkoṇṭa cōtic cem mēṉiem māṉaikkaim māmalartūyt"
        },
        {
          "n": 44,
          "devanagari": "தொழக்கண்டு நிற்கிற்கு மோதுன்னி நம்மடுந் தொல்வினையே",
          "iast": "toḻakkaṇṭu niṟkiṟku mōtuṉṉi nammaṭun tolviṉaiyē"
        }
      ]
    },
    {
      "label": "12",
      "lines": [
        {
          "n": 45,
          "devanagari": "தொல்லை வினைவந்து சூழாமுன் தாழாமே",
          "iast": "tollai viṉaivantu cūḻāmuṉ tāḻāmē"
        },
        {
          "n": 46,
          "devanagari": "ஒல்லை வணங்கி உமையென்னும்- மெல்லியல்ஓர்",
          "iast": "ollai vaṇaṅki umaiyeṉṉum- melliyalōr"
        },
        {
          "n": 47,
          "devanagari": "கூற்றானைக் கூற்றுருவங் காய்ந்தானை வாய்ந்திலங்கு",
          "iast": "kūṟṟāṉaik kūṟṟuruvaṅ kāyntāṉai vāyntilaṅku"
        },
        {
          "n": 48,
          "devanagari": "நீற்றானை நெஞ்சே நினை",
          "iast": "nīṟṟāṉai neñcē niṉai"
        }
      ]
    },
    {
      "label": "13",
      "lines": [
        {
          "n": 49,
          "devanagari": "நினையா தொழிதிகண் டாய்நெஞ்ச மேஇங்கோர் தஞ்சமென்று",
          "iast": "niṉaiyā toḻitikaṇ ṭāyneñca mēiṅkōr tañcameṉṟu"
        },
        {
          "n": 50,
          "devanagari": "மனையா ளையும்மக்கள் தம்மையும் தேறியோர் ஆறுபுக்கு",
          "iast": "maṉaiyā ḷaiyummakkaḷ tammaiyum tēṟiyōr āṟupukku"
        },
        {
          "n": 51,
          "devanagari": "நனையாச் சடைமுடி நம்பன்நந் தாதைநொந் தாதசெந்தீ",
          "iast": "naṉaiyāc caṭaimuṭi nampaṉnan tātainon tātacentī"
        },
        {
          "n": 52,
          "devanagari": "அனையான் அமரர் பிரான்அண்ட வாணன் அடித்தலமே",
          "iast": "aṉaiyāṉ amarar pirāṉaṇṭa vāṇaṉ aṭittalamē"
        }
      ]
    },
    {
      "label": "14",
      "lines": [
        {
          "n": 53,
          "devanagari": "அடித்தலத்தின் அன்றரக்கன் ஐந்நான்கு தோளும்",
          "iast": "aṭittalattiṉ aṉṟarakkaṉ ainnāṉku tōḷum"
        },
        {
          "n": 54,
          "devanagari": "முடித்தலமும் நீமுரித்த வாறென் - முடித்தலத்தில்",
          "iast": "muṭittalamum nīmuritta vāṟeṉ - muṭittalattil"
        },
        {
          "n": 55,
          "devanagari": "ஆறாடி ஆறா அனலாடி அவ்வனலின்",
          "iast": "āṟāṭi āṟā aṉalāṭi avvaṉaliṉ"
        },
        {
          "n": 56,
          "devanagari": "நீறாடி நெய்யாடி நீ",
          "iast": "nīṟāṭi neyyāṭi nī"
        }
      ]
    },
    {
      "label": "15",
      "lines": [
        {
          "n": 57,
          "devanagari": "நீநின்று தானவர் மாமதில் மூன்றும் நிரந்துடனே",
          "iast": "nīniṉṟu tāṉavar māmatil mūṉṟum nirantuṭaṉē"
        },
        {
          "n": 58,
          "devanagari": "தீநின்று வேவச் சிலைதொட்ட வாறென் றிரங்குவல்வாய்ப்",
          "iast": "tīniṉṟu vēvac cilaitoṭṭa vāṟeṉ ṟiraṅkuvalvāyp"
        },
        {
          "n": 59,
          "devanagari": "பேய்நின்று பாடப் பெருங்கா டரங்காப் பெயர்ந்துநட்டம்",
          "iast": "pēyniṉṟu pāṭap peruṅkā ṭaraṅkāp peyarntunaṭṭam"
        },
        {
          "n": 60,
          "devanagari": "போய்நின்று பூதந் தொழச்செய்யும் மொய்கழற் புண்ணியனே",
          "iast": "pōyniṉṟu pūtan toḻacceyyum moykaḻaṟ puṇṇiyaṉē"
        }
      ]
    },
    {
      "label": "16",
      "lines": [
        {
          "n": 61,
          "devanagari": "புண்ணியங்கள் செய்தனவும் பொய்ந்நெறிக்கட் சாராமே",
          "iast": "puṇṇiyaṅkaḷ ceytaṉavum poynneṟikkaṭ cārāmē"
        },
        {
          "n": 62,
          "devanagari": "எண்ணியோ ரைந்தும் இசைந்தனவால் - திண்ணிய",
          "iast": "eṇṇiyō raintum icaintaṉavāl - tiṇṇiya"
        },
        {
          "n": 63,
          "devanagari": "கைம்மாவின் ஈருரிவை மூவுருவும் போர்த்துகந்த",
          "iast": "kaimmāviṉ īrurivai mūvuruvum pōrttukanta"
        },
        {
          "n": 64,
          "devanagari": "அம்மானுக் காட்பட்ட அன்பு",
          "iast": "ammāṉuk kāṭpaṭṭa aṉpu"
        }
      ]
    },
    {
      "label": "17",
      "lines": [
        {
          "n": 65,
          "devanagari": "அன்பால் அடைவதெவ் வாறுகொல் மேலதோர் ஆடரவம்",
          "iast": "aṉpāl aṭaivatev vāṟukol mēlatōr āṭaravam"
        },
        {
          "n": 66,
          "devanagari": "தன்பால் ஒருவரைச் சாரஒட் டாதது வேயும்அன்றி",
          "iast": "taṉpāl oruvaraic cāraoṭ ṭātatu vēyumaṉṟi"
        },
        {
          "n": 67,
          "devanagari": "முன்பா யினதலை யோடுகள் கோத்தவை ஆர்த்துவெள்ளை",
          "iast": "muṉpā yiṉatalai yōṭukaḷ kōttavai ārttuveḷḷai"
        },
        {
          "n": 68,
          "devanagari": "என்பா யினவும் அணிந்தங்கோர் ஏறுகந் தேறுவதே",
          "iast": "eṉpā yiṉavum aṇintaṅkōr ēṟukan tēṟuvatē"
        }
      ]
    },
    {
      "label": "18",
      "lines": [
        {
          "n": 69,
          "devanagari": "ஏறலால் ஏறமற் றில்லையே எம்பெருமான்",
          "iast": "ēṟalāl ēṟamaṟ ṟillaiyē emperumāṉ"
        },
        {
          "n": 70,
          "devanagari": "ஆறெலாம் பாயும் அவிர்சடையார் - வேறோர்",
          "iast": "āṟelām pāyum avircaṭaiyār - vēṟōr"
        },
        {
          "n": 71,
          "devanagari": "படங்குலவு நாகமுமிழ் பண்டமரர் சூழ்ந்த",
          "iast": "paṭaṅkulavu nākamumiḻ paṇṭamarar cūḻnta"
        },
        {
          "n": 72,
          "devanagari": "தடங்கடல்நஞ் சுண்டார் தமக்கு",
          "iast": "taṭaṅkaṭalnañ cuṇṭār tamakku"
        }
      ]
    },
    {
      "label": "19",
      "lines": [
        {
          "n": 73,
          "devanagari": "தமக்கென்றும் இன்பணி செய்திருப் பேமுக்குத் தாம்ஒருநாள்",
          "iast": "tamakkeṉṟum iṉpaṇi ceytirup pēmukkut tāmorunāḷ"
        },
        {
          "n": 74,
          "devanagari": "எமக்கொன்று சொன்னால் அருளுங்கொ லாமிணை யாதுமின்றிச்",
          "iast": "emakkoṉṟu coṉṉāl aruḷuṅko lāmiṇai yātumiṉṟic"
        },
        {
          "n": 75,
          "devanagari": "சுமக்கின்ற பிள்ளைவெள்ளேறொப்ப தொன்றுதொண் டைக்கனிவாய்",
          "iast": "cumakkiṉṟa piḷḷaiveḷḷēṟoppa toṉṟutoṇ ṭaikkaṉivāy"
        },
        {
          "n": 76,
          "devanagari": "உமைக்கென்று தேடிப் பெறாதுட னேகொண்ட உத்தமரே",
          "iast": "umaikkeṉṟu tēṭip peṟātuṭa ṉēkoṇṭa uttamarē"
        }
      ]
    },
    {
      "label": "20",
      "lines": [
        {
          "n": 77,
          "devanagari": "உத்தமராய் வாழ்வார் உலந்தக்கால் உற்றார்கள்",
          "iast": "uttamarāy vāḻvār ulantakkāl uṟṟārkaḷ"
        },
        {
          "n": 78,
          "devanagari": "செத்த மரம்அடுக்கித் தீயாமுன் - உத்தமனாம்",
          "iast": "cetta maramaṭukkit tīyāmuṉ - uttamaṉām"
        },
        {
          "n": 79,
          "devanagari": "நீளாழி நஞ்சுண்ட நெய்யாடி தன்திறமே",
          "iast": "nīḷāḻi nañcuṇṭa neyyāṭi taṉtiṟamē"
        },
        {
          "n": 80,
          "devanagari": "கேளாழி நெஞ்சே கிளர்ந்து",
          "iast": "kēḷāḻi neñcē kiḷarntu"
        }
      ]
    }
  ]
}
