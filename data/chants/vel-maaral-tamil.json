    {
      "label": "23",
      "lines": [
        {
          "n": 1,
          "devanagari": "பழுத்தமுது தமிழ்ப்பலகை இருக்குமொரு",
          "iast": "pazhuttamutu tamizhppalakai irukkumoru"
        },
        {
          "n": 2,
          "devanagari": "கவிப்புலவன் இசைக்(கு)உருகி",
          "iast": "kavippulavan ichaik(ku)uruki"
        },
        {
          "n": 3,
          "devanagari": "வரைக்குகையை இடித்துவழி காணும்",
          "iast": "varaikkukaiyai iṭittuvazhi kāṇum"
        },
