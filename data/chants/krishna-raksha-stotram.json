{
  "id": "krishna-raksha-stotram",
  "language": "sanskrit",
  "title": {
    "devanagari": "गोपीकृता श्रीकृष्णरक्षा",
    "iast": "Gōpīkṛtā Śrīkṛṣṇarakṣā"
  },
  "source": {
    "site": "sanskritdocuments.org",
    "devanagari_url": "https://sanskritdocuments.org/doc_vishhnu/bAlarakShA.html",
    "note": "Śrīmad Bhāgavatam 10.6.22-29 (the gopīs' protection of the infant Kṛṣṇa after Pūtanā), numbered 1-8 here as on this page. Its bracketed variant readings are omitted. Also catalogued on sanskritdocuments.org as gopībhiḥ kṛtaṃ śrīkṛṣṇarakṣāstotram (same text). IAST generated by scripts/deva_to_iast.py; English translation prepared for this app."
  },
  "colophon": {
    "devanagari": "॥ इति श्रीमद्भागवते दशमस्कन्धे गोपीकृतबालरक्षा समाप्ता ॥",
    "iast": "॥ iti śrīmadbhāgavatē daśamaskandhē gōpīkṛtabālarakṣā samāptā ॥"
  },
  "sectionUnit": "Verse",
  "sections": [
    {
      "label": "1",
      "lines": [
        {
          "n": 1,
          "devanagari": "अव्यादजोऽङ्घ्रि मणिमांस्तव जान्वथोरू",
          "iast": "avyādajō'ṅghri maṇimāṃstava jānvathōrū"
        },
        {
          "n": 2,
          "devanagari": "यज्ञोऽच्युतः कटितटं जठरं हयास्यः ।",
          "iast": "yajñō'chyutaḥ kaṭitaṭaṃ jaṭharaṃ hayāsyaḥ ।"
        },
        {
          "n": 3,
          "devanagari": "हृत्केशवस्त्वदुर ईश इनस्तु कण्ठं",
          "iast": "hṛtkēśavastvadura īśa inastu kaṇṭhaṃ"
        },
        {
          "n": 4,
          "devanagari": "विष्णुर्भुजं मुखमुरुक्रम ईश्वरः कम् ॥ १॥",
          "iast": "viṣṇurbhujaṃ mukhamurukrama īśvaraḥ kam ॥ 1॥"
        }
      ]
    },
    {
      "label": "2",
      "lines": [
        {
          "n": 5,
          "devanagari": "चक्र्यग्रतः सहगदो हरिरस्तु पश्चात्",
          "iast": "chakryagrataḥ sahagadō harirastu paśchāt"
        },
        {
          "n": 6,
          "devanagari": "त्वत्पार्श्वयोर्धनुरसी मधुहाजनश्च ।",
          "iast": "tvatpārśvayōrdhanurasī madhuhājanaścha ।"
        },
        {
          "n": 7,
          "devanagari": "कोणेषु शङ्ख उरुगाय उपर्युपेन्द्रस्",
          "iast": "kōṇēṣu śaṅkha urugāya uparyupēndras"
        },
        {
          "n": 8,
          "devanagari": "तार्क्ष्यः क्षितौ हलधरः पुरुषः समन्तात् ॥ २॥",
          "iast": "tārkṣyaḥ kṣitau haladharaḥ puruṣaḥ samantāt ॥ 2॥"
        }
      ]
    },
    {
      "label": "3",
      "lines": [
        {
          "n": 9,
          "devanagari": "इन्द्रियाणि हृषीकेशः प्राणान्नारायणोऽवतु ।",
          "iast": "indriyāṇi hṛṣīkēśaḥ prāṇānnārāyaṇō'vatu ।"
        },
        {
          "n": 10,
          "devanagari": "श्वेतद्वीपपतिश्चित्तं मनो योगेश्वरोऽवतु ॥ ३॥",
          "iast": "śvētadvīpapatiśchittaṃ manō yōgēśvarō'vatu ॥ 3॥"
        }
      ]
    },
    {
      "label": "4",
      "lines": [
        {
          "n": 11,
          "devanagari": "पृश्निगर्भस्तु ते बुद्धिमात्मानं भगवान्परः ।",
          "iast": "pṛśnigarbhastu tē buddhimātmānaṃ bhagavānparaḥ ।"
        },
        {
          "n": 12,
          "devanagari": "क्रीडन्तं पातु गोविन्दः शयानं पातु माधवः ॥ ४॥",
          "iast": "krīḍantaṃ pātu gōvindaḥ śayānaṃ pātu mādhavaḥ ॥ 4॥"
        }
      ]
    },
    {
      "label": "5",
      "lines": [
        {
          "n": 13,
          "devanagari": "व्रजन्तमव्याद्वैकुण्ठ आसीनं त्वां श्रियः पतिः ।",
          "iast": "vrajantamavyādvaikuṇṭha āsīnaṃ tvāṃ śriyaḥ patiḥ ।"
        },
        {
          "n": 14,
          "devanagari": "भुञ्जानं यज्ञभुक्पातु सर्वग्रहभयङ्करः ॥ ५॥",
          "iast": "bhuñjānaṃ yajñabhukpātu sarvagrahabhayaṅkaraḥ ॥ 5॥"
        }
      ]
    },
    {
      "label": "6",
      "lines": [
        {
          "n": 15,
          "devanagari": "डाकिन्यो यातुधान्यश्च कुष्माण्डा येऽर्भकग्रहाः ।",
          "iast": "ḍākinyō yātudhānyaścha kuṣmāṇḍā yē'rbhakagrahāḥ ।"
        },
        {
          "n": 16,
          "devanagari": "भूतप्रेतपिशाचाश्च यक्षरक्षोविनायकाः ॥ ६॥",
          "iast": "bhūtaprētapiśāchāścha yakṣarakṣōvināyakāḥ ॥ 6॥"
        }
      ]
    },
    {
      "label": "7",
      "lines": [
        {
          "n": 17,
          "devanagari": "कोटरा रेवती ज्येष्ठा पूतना मातृकादयः ।",
          "iast": "kōṭarā rēvatī jyēṣṭhā pūtanā mātṛkādayaḥ ।"
        },
        {
          "n": 18,
          "devanagari": "उन्मादा ये ह्यपस्मारा देहप्राणेन्द्रियद्रुहः ॥ ७॥",
          "iast": "unmādā yē hyapasmārā dēhaprāṇēndriyadruhaḥ ॥ 7॥"
        }
      ]
    },
    {
      "label": "8",
      "lines": [
        {
          "n": 19,
          "devanagari": "स्वप्नदृष्टा महोत्पाता वृद्धबालग्रहाश्च ये ।",
          "iast": "svapnadṛṣṭā mahōtpātā vṛddhabālagrahāścha yē ।"
        },
        {
          "n": 20,
          "devanagari": "सर्वे नश्यन्तु ते विष्णोर्नामग्रहणभीरवः ॥ ८॥",
          "iast": "sarvē naśyantu tē viṣṇōrnāmagrahaṇabhīravaḥ ॥ 8॥"
        }
      ]
    }
  ]
}
