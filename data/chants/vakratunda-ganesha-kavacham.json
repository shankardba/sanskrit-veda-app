{
  "id": "vakratunda-ganesha-kavacham",
  "language": "sanskrit",
  "title": {
    "devanagari": "वक्रतुण्डगणेशकवचम्",
    "iast": "Vakratuṇḍagaṇēśakavacham"
  },
  "source": {
    "site": "sanskritdocuments.org",
    "devanagari_url": "https://sanskritdocuments.org/doc_ganesha/vakratuNDakavach.html",
    "note": "Also titled Gaṇeśarakṣākaraṃ Stotram; attributed in its own v.13 to the sage Bhṛgu. From sanskritdocuments.org; the opening Gaṇeśa invocation is omitted. IAST generated by scripts/deva_to_iast.py; English translation prepared for this app."
  },
  "colophon": {
    "devanagari": "॥ इति गणेशरक्षाकरं स्तोत्रं समाप्तम् ॥",
    "iast": "॥ iti gaṇēśarakṣākaraṃ stōtraṃ samāptam ॥"
  },
  "sectionUnit": "Verse",
  "sections": [
    {
      "label": "1",
      "lines": [
        {
          "n": 1,
          "devanagari": "मौलिं महेशपुत्रोऽव्याद्भालं पातु विनायकः ।",
          "iast": "mauliṃ mahēśaputrō'vyādbhālaṃ pātu vināyakaḥ ।"
        },
        {
          "n": 2,
          "devanagari": "त्रिनेत्रः पातु मे नेत्रे शूर्पकर्णोऽवतु श्रुती ॥ १॥",
          "iast": "trinētraḥ pātu mē nētrē śūrpakarṇō'vatu śrutī ॥ 1॥"
        }
      ]
    },
    {
      "label": "2",
      "lines": [
        {
          "n": 3,
          "devanagari": "हेरम्बो रक्षतु घ्राणं मुखं पातु गजाननः ।",
          "iast": "hērambō rakṣatu ghrāṇaṃ mukhaṃ pātu gajānanaḥ ।"
        },
        {
          "n": 4,
          "devanagari": "जिह्वां पातु गणेशो मे कण्ठं श्रीकण्ठवल्लभः ॥ २॥",
          "iast": "jihvāṃ pātu gaṇēśō mē kaṇṭhaṃ śrīkaṇṭhavallabhaḥ ॥ 2॥"
        }
      ]
    },
    {
      "label": "3",
      "lines": [
        {
          "n": 5,
          "devanagari": "स्कन्धौ महाबलः पातु विघ्नहा पातु मे भुजौ ।",
          "iast": "skandhau mahābalaḥ pātu vighnahā pātu mē bhujau ।"
        },
        {
          "n": 6,
          "devanagari": "करौ परशुभृत्पातु हृदयं स्कन्दपूर्वजः ॥ ३॥",
          "iast": "karau paraśubhṛtpātu hṛdayaṃ skandapūrvajaḥ ॥ 3॥"
        }
      ]
    },
    {
      "label": "4",
      "lines": [
        {
          "n": 7,
          "devanagari": "मध्यं लम्बोदरः पातु नाभिं सिन्दूरभूषितः ।",
          "iast": "madhyaṃ lambōdaraḥ pātu nābhiṃ sindūrabhūṣitaḥ ।"
        },
        {
          "n": 8,
          "devanagari": "जघनं पार्वतीपुत्रः सक्थिनी पातु पाशभृत् ॥ ४॥",
          "iast": "jaghanaṃ pārvatīputraḥ sakthinī pātu pāśabhṛt ॥ 4॥"
        }
      ]
    },
    {
      "label": "5",
      "lines": [
        {
          "n": 9,
          "devanagari": "जानुनी जगतां नाथो जङ्घे मूषकवाहनः ।",
          "iast": "jānunī jagatāṃ nāthō jaṅghē mūṣakavāhanaḥ ।"
        },
        {
          "n": 10,
          "devanagari": "पादौ पद्मासनः पातु पादाधो दैत्यदर्पहा ॥ ५॥",
          "iast": "pādau padmāsanaḥ pātu pādādhō daityadarpahā ॥ 5॥"
        }
      ]
    },
    {
      "label": "6",
      "lines": [
        {
          "n": 11,
          "devanagari": "एकदन्तोऽग्रतः पातु पृष्ठे पातु गणाधिपः ।",
          "iast": "ēkadantō'grataḥ pātu pṛṣṭhē pātu gaṇādhipaḥ ।"
        },
        {
          "n": 12,
          "devanagari": "पार्श्वयोर्मोदकाहारो दिग्विदिक्षु च सिद्धिदः ॥ ६॥",
          "iast": "pārśvayōrmōdakāhārō digvidikṣu cha siddhidaḥ ॥ 6॥"
        }
      ]
    },
    {
      "label": "7",
      "lines": [
        {
          "n": 13,
          "devanagari": "व्रजतस्तिष्ठतो वापि जाग्रतः स्वपतोऽश्नतः ।",
          "iast": "vrajatastiṣṭhatō vāpi jāgrataḥ svapatō'śnataḥ ।"
        },
        {
          "n": 14,
          "devanagari": "चतुर्थीवल्लभो देवः पातु मे भुक्तिमुक्तिदः ॥ ७॥",
          "iast": "chaturthīvallabhō dēvaḥ pātu mē bhuktimuktidaḥ ॥ 7॥"
        }
      ]
    },
    {
      "label": "8",
      "lines": [
        {
          "n": 15,
          "devanagari": "इदं पवित्रं स्तोत्रं च चतुर्थ्यां नियतः पठेत् ।",
          "iast": "idaṃ pavitraṃ stōtraṃ cha chaturthyāṃ niyataḥ paṭhēt ।"
        },
        {
          "n": 16,
          "devanagari": "सिन्दूररक्तः कुसुमैर्दूर्वया पूज्य विघ्नपम् ॥ ८॥",
          "iast": "sindūraraktaḥ kusumairdūrvayā pūjya vighnapam ॥ 8॥"
        }
      ]
    },
    {
      "label": "9",
      "lines": [
        {
          "n": 17,
          "devanagari": "राजा राजसुतो राजपत्नी मन्त्री कुलं चलम् ।",
          "iast": "rājā rājasutō rājapatnī mantrī kulaṃ chalam ।"
        },
        {
          "n": 18,
          "devanagari": "तस्यावश्यं भवेद्वश्यं विघ्नराजप्रसादतः ॥ ९॥",
          "iast": "tasyāvaśyaṃ bhavēdvaśyaṃ vighnarājaprasādataḥ ॥ 9॥"
        }
      ]
    },
    {
      "label": "10",
      "lines": [
        {
          "n": 19,
          "devanagari": "समन्त्रयन्त्रं यः स्तोत्रं करे संलिख्य धारयेत् ।",
          "iast": "samantrayantraṃ yaḥ stōtraṃ karē saṃlikhya dhārayēt ।"
        },
        {
          "n": 20,
          "devanagari": "धनधान्यसमृद्धिः स्यात्तस्य नास्त्यत्र संशयः ॥ १०॥",
          "iast": "dhanadhānyasamṛddhiḥ syāttasya nāstyatra saṃśayaḥ ॥ 10॥"
        }
      ]
    },
    {
      "label": "11",
      "lines": [
        {
          "n": 21,
          "devanagari": "अस्य मन्त्रः ।",
          "iast": "asya mantraḥ ।"
        },
        {
          "n": 22,
          "devanagari": "ऐं क्लीं ह्रीं वक्रतुण्डाय हुं ।",
          "iast": "aiṃ klīṃ hrīṃ vakratuṇḍāya huṃ ।"
        },
        {
          "n": 23,
          "devanagari": "रसलक्षं सदैकाग्र्यः षडङ्गन्यासपूर्वकम् ।",
          "iast": "rasalakṣaṃ sadaikāgryaḥ ṣaḍaṅganyāsapūrvakam ।"
        },
        {
          "n": 24,
          "devanagari": "हुत्वा तदन्ते विधिवदष्टद्रव्यं पयो घृतम् ॥ ११॥",
          "iast": "hutvā tadantē vidhivadaṣṭadravyaṃ payō ghṛtam ॥ 11॥"
        }
      ]
    },
    {
      "label": "12",
      "lines": [
        {
          "n": 25,
          "devanagari": "यं यं काममभिध्यायन् कुरुते कर्म किञ्चन ।",
          "iast": "yaṃ yaṃ kāmamabhidhyāyan kurutē karma kiñchana ।"
        },
        {
          "n": 26,
          "devanagari": "तं तं सर्वमवाप्नोति वक्रतुण्डप्रसादतः ॥ १२॥",
          "iast": "taṃ taṃ sarvamavāpnōti vakratuṇḍaprasādataḥ ॥ 12॥"
        }
      ]
    },
    {
      "label": "13",
      "lines": [
        {
          "n": 27,
          "devanagari": "भृगुप्रणीतं यः स्तोत्रं पठते भुवि मानवः ।",
          "iast": "bhṛgupraṇītaṃ yaḥ stōtraṃ paṭhatē bhuvi mānavaḥ ।"
        },
        {
          "n": 28,
          "devanagari": "भवेदव्याहतैश्वर्यः स गणेशप्रसादतः ॥ १३॥",
          "iast": "bhavēdavyāhataiśvaryaḥ sa gaṇēśaprasādataḥ ॥ 13॥"
        }
      ]
    }
  ]
}
