  },
  "colophon": {
    "devanagari": "॥ इति श्रीशनिरक्षास्तवः ॥",
    "iast": "॥ iti śrīśanirakṣāstavaḥ ॥"
  },
  "sectionUnit": "",
  "sections": [
    {
      "label": "Pūrvapīṭhikā",
      "lines": [
        {
          "n": 1,
          "devanagari": "श्रीनारद उवाच ।",
          "iast": "śrīnārada uvācha ।"
        },
        {
          "n": 2,
          "devanagari": "ध्यात्वा गणपतिं राजा धर्मराजो युधिष्ठिरः ।",
          "iast": "dhyātvā gaṇapatiṃ rājā dharmarājō yudhiṣṭhiraḥ ।"
        },
        {
          "n": 3,
          "devanagari": "धीरः शनैश्चरस्येमं चकार स्तवमुत्तमम् ॥",
          "iast": "dhīraḥ śanaiścharasyēmaṃ chakāra stavamuttamam ॥"
        }
      ]
    },
    {
      "label": "Viniyoga",
      "lines": [
        {
          "n": 4,
          "devanagari": "ॐ अस्य श्रीशनिस्तवराजस्य सिन्धुद्वीप ऋषिः । गायत्री छन्दः ।",
          "iast": "ōṃ asya śrīśanistavarājasya sindhudvīpa ṛṣiḥ । gāyatrī Chandaḥ ।"
        },
        {
          "n": 5,
          "devanagari": "श्रीशनैश्चर देवता । श्रीशनैश्चरप्रीत्यर्थे पाठे विनियोगः ॥",
          "iast": "śrīśanaiśchara dēvatā । śrīśanaiścharaprītyarthē pāṭhē viniyōgaḥ ॥"
        }
      ]
    },
    {
      "label": "Ṛṣyādinyāsa",
      "lines": [
        {
          "n": 6,
          "devanagari": "शिरसि सिन्धुद्वीपर्षये नमः । मुखे गायत्रीछन्दसे नमः ।",
          "iast": "śirasi sindhudvīparṣayē namaḥ । mukhē gāyatrīChandasē namaḥ ।"
        },
        {
          "n": 7,
          "devanagari": "हृदि श्रीशनैश्चरदेवतायै नमः ।",
          "iast": "hṛdi śrīśanaiścharadēvatāyai namaḥ ।"
        },
        {
          "n": 8,
          "devanagari": "सर्वाङ्गे श्रीशनैश्चरप्रीत्यर्थे विनियोगाय नमः ॥",
          "iast": "sarvāṅgē śrīśanaiścharaprītyarthē viniyōgāya namaḥ ॥"
        }
      ]
    },
    {
      "label": "Stava",
      "lines": [
        {
          "n": 9,
          "devanagari": "शिरो मे भास्करिः पातु भालं छायासुतोऽवतु ।",
          "iast": "śirō mē bhāskariḥ pātu bhālaṃ Chāyāsutō'vatu ।"
        },
        {
          "n": 10,
          "devanagari": "कोटराक्षो दृशौ पातु शिखिकण्ठनिभः श्रुती ॥",
          "iast": "kōṭarākṣō dṛśau pātu śikhikaṇṭhanibhaḥ śrutī ॥"
        },
        {
          "n": 11,
          "devanagari": "घ्राणं मे भीषणः पातु मुखं बलिमुखोऽवतु ।",
          "iast": "ghrāṇaṃ mē bhīṣaṇaḥ pātu mukhaṃ balimukhō'vatu ।"
        },
        {
          "n": 12,
          "devanagari": "स्कन्धौ संवर्तकः पातु भुजौ मे भयदोऽवतु ॥",
          "iast": "skandhau saṃvartakaḥ pātu bhujau mē bhayadō'vatu ॥"
        },
        {
          "n": 13,
          "devanagari": "सौरिर्मे हृदयं पातु नाभिं शनैश्चरोऽवतु ।",
          "iast": "saurirmē hṛdayaṃ pātu nābhiṃ śanaiścharō'vatu ।"
        },
        {
          "n": 14,
          "devanagari": "ग्रहराजः कटिं पातु सर्वतो रविनन्दनः ॥",
          "iast": "graharājaḥ kaṭiṃ pātu sarvatō ravinandanaḥ ॥"
        },
        {
          "n": 15,
          "devanagari": "पादौ मन्दगतिः पातु कृष्णः पात्वखिलं वपुः ॥",
          "iast": "pādau mandagatiḥ pātu kṛṣṇaḥ pātvakhilaṃ vapuḥ ॥"
        }
      ]
    },
    {
      "label": "Phalaśruti",
      "lines": [
        {
          "n": 16,
          "devanagari": "रक्षामेतां पठेन्नित्यं सौरेर्नामाबलैर्युतम् ।",
          "iast": "rakṣāmētāṃ paṭhēnnityaṃ saurērnāmābalairyutam ।"
        },
        {
          "n": 17,
          "devanagari": "सुखी पुत्री चिरायुश्च स भवेन्नात्र संशयः ॥",
          "iast": "sukhī putrī chirāyuścha sa bhavēnnātra saṃśayaḥ ॥"
        }
      ]
    }
  ]
}
