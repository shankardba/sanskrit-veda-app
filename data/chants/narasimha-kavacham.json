{
  "id": "narasimha-kavacham",
  "language": "sanskrit",
  "title": {
    "devanagari": "श्रीनृसिंहकवचम्",
    "iast": "Śrī Nṛsiṃhakavacham"
  },
  "source": {
    "site": "sanskritdocuments.org",
    "devanagari_url": "https://sanskritdocuments.org/doc_vishhnu/narasimhakavach.html",
    "note": "The canonical 31-verse Prahlāda-spoken Narasimha Kavacham of the Brahmāṇḍa Purāṇa, from sanskritdocuments.org. The page's lineage-specific nyāsa/digbandha preamble, its bracketed variant readings and extra lines, and a block of verses it inserts from a later Nṛsiṃhakośa compilation are omitted; its closing verse (numbered 39 there) is verse 31 here, matching the same page's own 31-verse sārtham copy. IAST generated by scripts/deva_to_iast.py; English translation prepared for this app."
  },
  "colophon": {
    "devanagari": "॥ इति श्रीब्रह्माण्डपुराणे प्रह्लादोक्तं श्रीनृसिंहकवचं सम्पूर्णम् ॥",
    "iast": "॥ iti śrībrahmāṇḍapurāṇē prahlādōktaṃ śrīnṛsiṃhakavachaṃ sampūrṇam ॥"
  },
  "sectionUnit": "Verse",
  "sections": [
    {
      "label": "1",
      "lines": [
        {
          "n": 1,
          "devanagari": "नृसिंहकवचं वक्ष्ये प्रह्लादेनोदितं पुरा ।",
          "iast": "nṛsiṃhakavachaṃ vakṣyē prahlādēnōditaṃ purā ।"
        },
        {
          "n": 2,
          "devanagari": "सर्वरक्षाकरं पुण्यं सर्वोपद्रवनाशनम् ॥ १॥",
          "iast": "sarvarakṣākaraṃ puṇyaṃ sarvōpadravanāśanam ॥ 1॥"
        }
      ]
    },
    {
      "label": "2",
      "lines": [
        {
          "n": 3,
          "devanagari": "सर्व सम्पत्करं चैव स्वर्गमोक्षप्रदायकम् ।",
          "iast": "sarva sampatkaraṃ chaiva svargamōkṣapradāyakam ।"
        },
        {
          "n": 4,
          "devanagari": "ध्यात्वा नृसिंहं देवेशं हेमसिंहासनस्थितम् ॥ २॥",
          "iast": "dhyātvā nṛsiṃhaṃ dēvēśaṃ hēmasiṃhāsanasthitam ॥ 2॥"
        }
      ]
    },
    {
      "label": "3",
      "lines": [
        {
          "n": 5,
          "devanagari": "विवृतास्यं त्रिनयनं शरदिन्दुसमप्रभम् ।",
          "iast": "vivṛtāsyaṃ trinayanaṃ śaradindusamaprabham ।"
        },
        {
          "n": 6,
          "devanagari": "लक्ष्म्यालिङ्गितवामाङ्गं विभूतिभिरुपाश्रितम् ॥ ३॥",
          "iast": "lakṣmyāliṅgitavāmāṅgaṃ vibhūtibhirupāśritam ॥ 3॥"
        }
      ]
    },
    {
      "label": "4",
      "lines": [
        {
          "n": 7,
          "devanagari": "चतुर्भुजं कोमलाङ्गं स्वर्णकुण्डलशोभितम् ।",
          "iast": "chaturbhujaṃ kōmalāṅgaṃ svarṇakuṇḍalaśōbhitam ।"
        },
        {
          "n": 8,
          "devanagari": "सरोजशोभितोरस्कं रत्नकेयूरमुद्रितम् ॥ ४॥",
          "iast": "sarōjaśōbhitōraskaṃ ratnakēyūramudritam ॥ 4॥"
        }
      ]
    },
    {
      "label": "5",
      "lines": [
        {
          "n": 9,
          "devanagari": "तप्तकाञ्चनसंकाशं पीतनिर्मलवाससम् ।",
          "iast": "taptakāñchanasaṃkāśaṃ pītanirmalavāsasam ।"
        },
        {
          "n": 10,
          "devanagari": "इन्द्रादिसुरमौलिस्थस्फुरन्माणिक्यदीप्तिभिः ॥ ५॥",
          "iast": "indrādisuramaulisthasphuranmāṇikyadīptibhiḥ ॥ 5॥"
        }
      ]
    },
    {
      "label": "6",
      "lines": [
        {
          "n": 11,
          "devanagari": "विराजितपदद्वन्द्वं शङ्खचक्रादि हेतिभिः ।",
          "iast": "virājitapadadvandvaṃ śaṅkhachakrādi hētibhiḥ ।"
        },
        {
          "n": 12,
          "devanagari": "गरुत्मता च विनयात् स्तूयमानं मुदान्वितम् ॥ ६॥",
          "iast": "garutmatā cha vinayāt stūyamānaṃ mudānvitam ॥ 6॥"
        }
      ]
    },
    {
      "label": "7",
      "lines": [
        {
          "n": 13,
          "devanagari": "स्वहृत्कमलसंवासं कृत्वा तु कवचं पठेत् ।",
          "iast": "svahṛtkamalasaṃvāsaṃ kṛtvā tu kavachaṃ paṭhēt ।"
        },
        {
          "n": 14,
          "devanagari": "नृसिंहो मे शिरः पातु लोकरक्षार्थसम्भवः ॥ ७॥",
          "iast": "nṛsiṃhō mē śiraḥ pātu lōkarakṣārthasambhavaḥ ॥ 7॥"
        }
      ]
    },
    {
      "label": "8",
      "lines": [
        {
          "n": 15,
          "devanagari": "सर्वगोऽपि स्तम्भवासः भालं मे रक्षतु ध्वनिम् ।",
          "iast": "sarvagō'pi stambhavāsaḥ bhālaṃ mē rakṣatu dhvanim ।"
        },
        {
          "n": 16,
          "devanagari": "नृसिंहो मे दृशौ पातु सोमसूर्याग्निलोचनः ॥ ८॥",
          "iast": "nṛsiṃhō mē dṛśau pātu sōmasūryāgnilōchanaḥ ॥ 8॥"
        }
      ]
    },
    {
      "label": "9",
      "lines": [
        {
          "n": 17,
          "devanagari": "स्मृतिं मे पातु नृहरिर्मुनिवर्यस्तुतिप्रियः ।",
          "iast": "smṛtiṃ mē pātu nṛharirmunivaryastutipriyaḥ ।"
        },
        {
          "n": 18,
          "devanagari": "नासं मे सिंहनासस्तु मुखं लक्ष्मीमुखप्रियः ॥ ९॥",
          "iast": "nāsaṃ mē siṃhanāsastu mukhaṃ lakṣmīmukhapriyaḥ ॥ 9॥"
        }
      ]
    },
    {
      "label": "10",
      "lines": [
        {
          "n": 19,
          "devanagari": "सर्वविद्याधिपः पातु नृसिंहो रसनां मम ।",
          "iast": "sarvavidyādhipaḥ pātu nṛsiṃhō rasanāṃ mama ।"
        },
        {
          "n": 20,
          "devanagari": "वक्त्रं पात्विन्दुवदनं सदा प्रह्लादवन्दितः ॥ १०॥",
          "iast": "vaktraṃ pātvinduvadanaṃ sadā prahlādavanditaḥ ॥ 10॥"
        }
      ]
    },
    {
      "label": "11",
      "lines": [
        {
          "n": 21,
          "devanagari": "नृसिंहः पातु मे कण्ठं स्कन्धौ भूभरान्तकृत् ।",
          "iast": "nṛsiṃhaḥ pātu mē kaṇṭhaṃ skandhau bhūbharāntakṛt ।"
        },
        {
          "n": 22,
          "devanagari": "दिव्यास्त्रशोभितभुजो नृसिंहः पातु मे भुजौ ॥ ११॥",
          "iast": "divyāstraśōbhitabhujō nṛsiṃhaḥ pātu mē bhujau ॥ 11॥"
        }
      ]
    },
    {
      "label": "12",
      "lines": [
        {
          "n": 23,
          "devanagari": "करौ मे देववरदो नृसिंहः पातु सर्वतः ।",
          "iast": "karau mē dēvavaradō nṛsiṃhaḥ pātu sarvataḥ ।"
        },
        {
          "n": 24,
          "devanagari": "हृदयं योगिसाध्यश्च निवासं पातु मे हरिः ॥ १२॥",
          "iast": "hṛdayaṃ yōgisādhyaścha nivāsaṃ pātu mē hariḥ ॥ 12॥"
        }
      ]
    },
    {
      "label": "13",
      "lines": [
        {
          "n": 25,
          "devanagari": "मध्यं पातु हिरण्याक्षवक्षःकुक्षिविदारणः ।",
          "iast": "madhyaṃ pātu hiraṇyākṣavakṣaḥkukṣividāraṇaḥ ।"
        },
        {
          "n": 26,
          "devanagari": "नाभिं मे पातु नृहरिः स्वनाभि ब्रह्मसंस्तुतः ॥ १३॥",
          "iast": "nābhiṃ mē pātu nṛhariḥ svanābhi brahmasaṃstutaḥ ॥ 13॥"
        }
      ]
    },
    {
      "label": "14",
      "lines": [
        {
          "n": 27,
          "devanagari": "ब्रह्माण्डकोटयः कट्यां यस्यासौ पातु मे कटिम् ।",
          "iast": "brahmāṇḍakōṭayaḥ kaṭyāṃ yasyāsau pātu mē kaṭim ।"
        },
        {
          "n": 28,
          "devanagari": "गुह्यं मे पातु गुह्यानां मन्त्राणां गुह्यरूपदृक् ॥ १४॥",
          "iast": "guhyaṃ mē pātu guhyānāṃ mantrāṇāṃ guhyarūpadṛk ॥ 14॥"
        }
      ]
    },
    {
      "label": "15",
      "lines": [
        {
          "n": 29,
          "devanagari": "ऊरु मनोभवः पातु जानुनी नररूपधृक् ।",
          "iast": "ūru manōbhavaḥ pātu jānunī nararūpadhṛk ।"
        },
        {
          "n": 30,
          "devanagari": "जङ्घे पातु धराभारहर्ता योऽसौ नृकेसरी ॥ १५॥",
          "iast": "jaṅghē pātu dharābhārahartā yō'sau nṛkēsarī ॥ 15॥"
        }
      ]
    },
    {
      "label": "16",
      "lines": [
        {
          "n": 31,
          "devanagari": "सुरराज्यप्रदः पातु पादौ मे नृहरीश्वरः ।",
          "iast": "surarājyapradaḥ pātu pādau mē nṛharīśvaraḥ ।"
        },
        {
          "n": 32,
          "devanagari": "सहस्रशीर्षा पुरुषः पातु मे सर्वशस्तनुम् ॥ १६॥",
          "iast": "sahasraśīrṣā puruṣaḥ pātu mē sarvaśastanum ॥ 16॥"
        }
      ]
    },
    {
      "label": "17",
      "lines": [
        {
          "n": 33,
          "devanagari": "महोग्रः पूर्वतः पातु महावीराग्रजोऽग्नितः ।",
          "iast": "mahōgraḥ pūrvataḥ pātu mahāvīrāgrajō'gnitaḥ ।"
        },
        {
          "n": 34,
          "devanagari": "महाविष्णुर्दक्षिणे तु महाज्वालस्तु नैरृतौ ॥ १७॥",
          "iast": "mahāviṣṇurdakṣiṇē tu mahājvālastu nairṛtau ॥ 17॥"
        }
      ]
    },
    {
      "label": "18",
      "lines": [
        {
          "n": 35,
          "devanagari": "पश्चिमे पातु सर्वेशो दिशि मे सर्वतोमुखः ।",
          "iast": "paśchimē pātu sarvēśō diśi mē sarvatōmukhaḥ ।"
        },
        {
          "n": 36,
          "devanagari": "नृसिंहः पातु वायव्यां सौम्यां भीषणविग्रहः ॥ १८॥",
          "iast": "nṛsiṃhaḥ pātu vāyavyāṃ saumyāṃ bhīṣaṇavigrahaḥ ॥ 18॥"
        }
      ]
    },
    {
      "label": "19",
      "lines": [
        {
          "n": 37,
          "devanagari": "ईशान्यां पातु भद्रो मे सर्वमङ्गलदायकः ।",
          "iast": "īśānyāṃ pātu bhadrō mē sarvamaṅgaladāyakaḥ ।"
        },
        {
          "n": 38,
          "devanagari": "संसारभयतः पातु मृत्योर्मृत्युर्नृकेसरी ॥ १९॥",
          "iast": "saṃsārabhayataḥ pātu mṛtyōrmṛtyurnṛkēsarī ॥ 19॥"
        }
      ]
    },
    {
      "label": "20",
      "lines": [
        {
          "n": 39,
          "devanagari": "इदं नृसिंहकवचं प्रह्लादमुखमण्डितम् ।",
          "iast": "idaṃ nṛsiṃhakavachaṃ prahlādamukhamaṇḍitam ।"
        },
        {
          "n": 40,
          "devanagari": "भक्तिमान् यः पठेन्नित्यं सर्वपापैः प्रमुच्यते ॥ २०॥",
          "iast": "bhaktimān yaḥ paṭhēnnityaṃ sarvapāpaiḥ pramuchyatē ॥ 20॥"
        }
      ]
    },
    {
      "label": "21",
      "lines": [
        {
          "n": 41,
          "devanagari": "पुत्रवान् धनवान् लोके दीर्घायुरुपजायते ।",
          "iast": "putravān dhanavān lōkē dīrghāyurupajāyatē ।"
        },
        {
          "n": 42,
          "devanagari": "यं यं कामयते कामं तं तं प्राप्नोत्यसंशयम् ॥ २१॥",
          "iast": "yaṃ yaṃ kāmayatē kāmaṃ taṃ taṃ prāpnōtyasaṃśayam ॥ 21॥"
        }
      ]
    },
    {
      "label": "22",
      "lines": [
        {
          "n": 43,
          "devanagari": "सर्वत्र जयमाप्नोति सर्वत्र विजयी भवेत् ।",
          "iast": "sarvatra jayamāpnōti sarvatra vijayī bhavēt ।"
        },
        {
          "n": 44,
          "devanagari": "भूम्यन्तरीक्षदिव्यानां ग्रहाणां विनिवारणम् ॥ २२॥",
          "iast": "bhūmyantarīkṣadivyānāṃ grahāṇāṃ vinivāraṇam ॥ 22॥"
        }
      ]
    },
    {
      "label": "23",
      "lines": [
        {
          "n": 45,
          "devanagari": "वृश्चिकोरगसम्भूत विषापहरणं परम् ।",
          "iast": "vṛśchikōragasambhūta viṣāpaharaṇaṃ param ।"
        },
        {
          "n": 46,
          "devanagari": "ब्रह्मराक्षसयक्षाणां दूरोत्सारणकारणम् ॥ २३॥",
          "iast": "brahmarākṣasayakṣāṇāṃ dūrōtsāraṇakāraṇam ॥ 23॥"
        }
      ]
    },
    {
      "label": "24",
      "lines": [
        {
          "n": 47,
          "devanagari": "भूर्जे वा तालपत्रे वा कवचं लिखितं शुभम् ।",
          "iast": "bhūrjē vā tālapatrē vā kavachaṃ likhitaṃ śubham ।"
        },
        {
          "n": 48,
          "devanagari": "करमूले धृतं येन सिध्येयुः कर्मसिद्धयः ॥ २४॥",
          "iast": "karamūlē dhṛtaṃ yēna sidhyēyuḥ karmasiddhayaḥ ॥ 24॥"
        }
      ]
    },
    {
      "label": "25",
      "lines": [
        {
          "n": 49,
          "devanagari": "देवासुरमनुष्येषु स्वं स्वमेव जयं लभेत् ।",
          "iast": "dēvāsuramanuṣyēṣu svaṃ svamēva jayaṃ labhēt ।"
        },
        {
          "n": 50,
          "devanagari": "एकसन्ध्यं त्रिसन्ध्यं वा यः पठेन्नियतो नरः ॥ २५॥",
          "iast": "ēkasandhyaṃ trisandhyaṃ vā yaḥ paṭhēnniyatō naraḥ ॥ 25॥"
        }
      ]
    },
    {
      "label": "26",
      "lines": [
        {
          "n": 51,
          "devanagari": "सर्वमङ्गलमाङ्गल्यं भुक्तिं मुक्तिं च विन्दति ।",
          "iast": "sarvamaṅgalamāṅgalyaṃ bhuktiṃ muktiṃ cha vindati ।"
        },
        {
          "n": 52,
          "devanagari": "द्वात्रिंशतिसहस्राणि पठेत् शुद्धात्मनां नृणाम् ॥ २६॥",
          "iast": "dvātriṃśatisahasrāṇi paṭhēt śuddhātmanāṃ nṛṇām ॥ 26॥"
        }
      ]
    },
    {
      "label": "27",
      "lines": [
        {
          "n": 53,
          "devanagari": "कवचस्यास्य मन्त्रस्य मन्त्रसिद्धिः प्रजायते ।",
          "iast": "kavachasyāsya mantrasya mantrasiddhiḥ prajāyatē ।"
        },
        {
          "n": 54,
          "devanagari": "अनेन मन्त्रराजेन कृत्वा भस्माभिमन्त्रणम् ॥ २७॥",
          "iast": "anēna mantrarājēna kṛtvā bhasmābhimantraṇam ॥ 27॥"
        }
      ]
    },
    {
      "label": "28",
      "lines": [
        {
          "n": 55,
          "devanagari": "तिलकं विन्यसेद्यस्तु तस्य ग्रहभयं हरेत् ।",
          "iast": "tilakaṃ vinyasēdyastu tasya grahabhayaṃ harēt ।"
        },
        {
          "n": 56,
          "devanagari": "त्रिवारं जपमानस्तु दत्तं वार्यभिमन्त्र्य च ॥ २८॥",
          "iast": "trivāraṃ japamānastu dattaṃ vāryabhimantrya cha ॥ 28॥"
        }
      ]
    },
    {
      "label": "29",
      "lines": [
        {
          "n": 57,
          "devanagari": "प्राशयेद्यो नरो मन्त्रं नृसिंहध्यानमाचरेत् ।",
          "iast": "prāśayēdyō narō mantraṃ nṛsiṃhadhyānamācharēt ।"
        },
        {
          "n": 58,
          "devanagari": "तस्य रोगाः प्रणश्यन्ति ये च स्युः कुक्षिसम्भवाः ॥ २९॥",
          "iast": "tasya rōgāḥ praṇaśyanti yē cha syuḥ kukṣisambhavāḥ ॥ 29॥"
        }
      ]
    },
    {
      "label": "30",
      "lines": [
        {
          "n": 59,
          "devanagari": "किमत्र बहुनोक्तेन नृसिंहसदृशो भवेत् ।",
          "iast": "kimatra bahunōktēna nṛsiṃhasadṛśō bhavēt ।"
