{
  "id": "sri-rudram-chamakam",
  "title": {
    "devanagari": "श्री रुद्रं चमकम्",
    "iast": "Śrī Rudraṁ Chamakam"
  },
  "source": {
    "site": "vignanam.org",
    "devanagari_url": "https://vignanam.org/devanagari/sri-rudram-chamakam.html",
    "iast_url": "https://vignanam.org/english/sri-rudram-chamakam.html"
  },
  "colophon": null,
  "sections": [
    {
      "label": "1",
      "lines": [
        {
          "n": 1,
          "devanagari": "ॐ अग्ना॑विष्णू स॒जोष॑से॒माव॑र्धन्तु वा॒-ङ्गिरः॑ ।",
          "iast": "ōṃ agnā̍viṣṇū sa̠jōṣa̍sē̠māva̍rdhantu vā̠-ṅgira̍ḥ ।"
        },
        {
          "n": 2,
          "devanagari": "द्यु॒म्नैर्वाजे॑भि॒राग॑तम् ।",
          "iast": "dyu̠mnairvājē̍bhi̠rāga̍tam ।"
        },
        {
          "n": 3,
          "devanagari": "वाज॑श्च मे प्रस॒वश्च॑ मे॒",
          "iast": "vāja̍ścha mē prasa̠vaścha̍ mē̠"
        },
        {
          "n": 4,
          "devanagari": "प्रय॑तिश्च मे॒ प्रसि॑तिश्च मे",
          "iast": "praya̍tiścha mē̠ prasi̍tiścha mē"
        },
        {
          "n": 5,
          "devanagari": "धी॒तिश्च॑ मे॒ क्रतु॑श्च मे॒",
          "iast": "dhī̠tiścha̍ mē̠ kratu̍ścha mē̠"
        },
        {
          "n": 6,
          "devanagari": "स्वर॑श्च मे॒ श्लोक॑श्च मे",
          "iast": "svara̍ścha mē̠ ślōka̍ścha mē"
        },
        {
          "n": 7,
          "devanagari": "श्रा॒वश्च॑ मे॒ श्रुति॑श्च मे॒",
          "iast": "śrā̠vaścha̍ mē̠ śruti̍ścha mē̠"
        },
        {
          "n": 8,
          "devanagari": "ज्योति॑श्च मे॒ सुव॑श्च मे",
          "iast": "jyōti̍ścha mē̠ suva̍ścha mē"
        },
        {
          "n": 9,
          "devanagari": "प्रा॒णश्च॑ मे-ऽपा॒नश्च॑ मे",
          "iast": "prā̠ṇaścha̍ mē-'pā̠naścha̍ mē"
        },
        {
          "n": 10,
          "devanagari": "व्या॒नश्च॒ मे-ऽसु॑श्च मे",
          "iast": "vyā̠naścha̠ mē-'su̍ścha mē"
        },
        {
          "n": 11,
          "devanagari": "चि॒त्त-ञ्च॑ म॒ आधी॑त-ञ्च मे॒",
          "iast": "chi̠tta-ñcha̍ ma̠ ādhī̍ta-ñcha mē̠"
        },
        {
          "n": 12,
          "devanagari": "वाक्च॑ मे॒ मन॑श्च मे॒",
          "iast": "vākcha̍ mē̠ mana̍ścha mē̠"
        },
        {
          "n": 13,
          "devanagari": "चक्षु॑श्च मे॒ श्रोत्र॑-ञ्च मे॒",
          "iast": "chakṣu̍ścha mē̠ śrōtra̍-ñcha mē̠"
        },
        {
          "n": 14,
          "devanagari": "दक्ष॑श्च मे॒ बल॑-ञ्च म॒",
          "iast": "dakṣa̍ścha mē̠ bala̍-ñcha ma̠"
        },
        {
          "n": 15,
          "devanagari": "ओज॑श्च मे॒ सह॑श्च म॒",
          "iast": "ōja̍ścha mē̠ saha̍ścha ma̠"
        },
        {
          "n": 16,
          "devanagari": "आयु॑श्च मे ज॒रा च॑ म",
          "iast": "āyu̍ścha mē ja̠rā cha̍ ma"
        },
        {
          "n": 17,
          "devanagari": "आ॒त्मा च॑ मे त॒नूश्च॑ मे॒",
          "iast": "ā̠tmā cha̍ mē ta̠nūścha̍ mē̠"
        },
        {
          "n": 18,
          "devanagari": "शर्म॑ च मे॒ वर्म॑ च॒ मे-ऽङ्गा॑नि च मे॒-ऽस्थानि॑ च मे॒",
          "iast": "śarma̍ cha mē̠ varma̍ cha̠ mē-'ṅgā̍ni cha mē̠-'sthāni̍ cha mē̠"
        },
        {
          "n": 19,
          "devanagari": "परूग्ं॑षि च मे॒ शरी॑राणि च मे ॥ 1 ॥",
          "iast": "parūg̍ṃṣi cha mē̠ śarī̍rāṇi cha mē ॥ 1 ॥"
        }
      ]
    },
    {
      "label": "2",
      "lines": [
        {
          "n": 20,
          "devanagari": "जैष्ठ्य॑-ञ्च म॒ आधि॑पत्य-ञ्च मे",
          "iast": "jaiṣṭhya̍-ñcha ma̠ ādhi̍patya-ñcha mē"
        },
        {
          "n": 21,
          "devanagari": "म॒न्युश्च॑ मे॒ भाम॑श्च॒ मे-ऽम॑श्च॒ मे-ऽम्भ॑श्च मे",
          "iast": "ma̠nyuścha̍ mē̠ bhāma̍ścha̠ mē-'ma̍ścha̠ mē-'mbha̍ścha mē"
        },
        {
          "n": 22,
          "devanagari": "जे॒मा च॑ मे महि॒मा च॑ मे",
          "iast": "jē̠mā cha̍ mē mahi̠mā cha̍ mē"
        },
        {
          "n": 23,
          "devanagari": "वरि॒मा च॑ मे प्रथि॒मा च॑ मे",
          "iast": "vari̠mā cha̍ mē prathi̠mā cha̍ mē"
        },
        {
          "n": 24,
          "devanagari": "व॒र्​ष्मा च॑ मे द्राघु॒या च॑ मे",
          "iast": "va̠r​ṣmā cha̍ mē drāghu̠yā cha̍ mē"
        },
        {
          "n": 25,
          "devanagari": "वृ॒द्ध-ञ्च॑ मे॒ वृद्धि॑श्च मे",
          "iast": "vṛ̠ddha-ñcha̍ mē̠ vṛddhi̍ścha mē"
        },
        {
          "n": 26,
          "devanagari": "स॒त्य-ञ्च॑ मे श्र॒द्धा च॑ मे॒",
          "iast": "sa̠tya-ñcha̍ mē śra̠ddhā cha̍ mē̠"
        },
        {
          "n": 27,
          "devanagari": "जग॑च्च मे॒ धन॑-ञ्च मे॒",
          "iast": "jaga̍chcha mē̠ dhana̍-ñcha mē̠"
        },
        {
          "n": 28,
          "devanagari": "वश॑श्च मे॒ त्विषि॑श्च मे",
          "iast": "vaśa̍ścha mē̠ tviṣi̍ścha mē"
        },
        {
          "n": 29,
          "devanagari": "क्री॒डा च॑ मे॒ मोद॑श्च मे",
          "iast": "krī̠ḍā cha̍ mē̠ mōda̍ścha mē"
        },
        {
          "n": 30,
          "devanagari": "जा॒त-ञ्च॑ मे जनि॒ष्यमा॑ण-ञ्च मे",
          "iast": "jā̠ta-ñcha̍ mē jani̠ṣyamā̍ṇa-ñcha mē"
        },
        {
          "n": 31,
          "devanagari": "सू॒क्त-ञ्च॑ मे सुकृ॒त-ञ्च॑ मे",
          "iast": "sū̠kta-ñcha̍ mē sukṛ̠ta-ñcha̍ mē"
        },
        {
          "n": 32,
          "devanagari": "वि॒त्त-ञ्च॑ मे॒ वेद्य॑-ञ्च मे",
          "iast": "vi̠tta-ñcha̍ mē̠ vēdya̍-ñcha mē"
        },
        {
          "n": 33,
          "devanagari": "भू॒त-ञ्च॑ मे भवि॒ष्यच्च॑ मे",
          "iast": "bhū̠ta-ñcha̍ mē bhavi̠ṣyachcha̍ mē"
        },
        {
          "n": 34,
          "devanagari": "सु॒ग-ञ्च॑ मे सु॒पथ॑-ञ्च म",
          "iast": "su̠ga-ñcha̍ mē su̠patha̍-ñcha ma"
        },
        {
          "n": 35,
          "devanagari": "ऋ॒द्ध-ञ्च॑ म॒ ऋद्धि॑श्च मे",
          "iast": "ṛ̠ddha-ñcha̍ ma̠ ṛddhi̍ścha mē"
        },
        {
          "n": 36,
          "devanagari": "कॢ॒प्त-ञ्च॑ मे॒ कॢप्ति॑श्च मे",
          "iast": "kL​i̠pta-ñcha̍ mē̠ kL​ipti̍ścha mē"
        },
        {
          "n": 37,
          "devanagari": "म॒तिश्च॑ मे सुम॒तिश्च॑ मे ॥ 2 ॥",
          "iast": "ma̠tiścha̍ mē suma̠tiścha̍ mē ॥ 2 ॥"
        }
      ]
    },
    {
      "label": "3",
      "lines": [
        {
          "n": 38,
          "devanagari": "श-ञ्च॑ मे॒ मय॑श्च मे",
          "iast": "śa-ñcha̍ mē̠ maya̍ścha mē"
        },
        {
          "n": 39,
          "devanagari": "प्रि॒य-ञ्च॑ मे-ऽनुका॒मश्च॑ मे॒ काम॑श्च मे",
          "iast": "pri̠ya-ñcha̍ mē-'nukā̠maścha̍ mē̠ kāma̍ścha mē"
        },
        {
          "n": 40,
          "devanagari": "सौमन॒सश्च॑ मे भ॒द्र-ञ्च॑ मे॒",
          "iast": "saumana̠saścha̍ mē bha̠dra-ñcha̍ mē̠"
        },
        {
          "n": 41,
          "devanagari": "श्रेय॑श्च मे॒ वस्य॑श्च मे॒",
          "iast": "śrēya̍ścha mē̠ vasya̍ścha mē̠"
        },
        {
          "n": 42,
          "devanagari": "यश॑श्च मे॒ भग॑श्च मे॒ द्रवि॑ण-ञ्च मे",
          "iast": "yaśa̍ścha mē̠ bhaga̍ścha mē̠ dravi̍ṇa-ñcha mē"
        },
        {
          "n": 43,
          "devanagari": "य॒न्ता च॑ मे ध॒र्ता च॑ मे॒",
          "iast": "ya̠ntā cha̍ mē dha̠rtā cha̍ mē̠"
        },
        {
          "n": 44,
          "devanagari": "क्षेम॑श्च मे॒ धृति॑श्च मे॒",
          "iast": "kṣēma̍ścha mē̠ dhṛti̍ścha mē̠"
        },
        {
          "n": 45,
          "devanagari": "विश्व॑-ञ्च मे॒ मह॑श्च मे",
          "iast": "viśva̍-ñcha mē̠ maha̍ścha mē"
        },
        {
          "n": 46,
          "devanagari": "सं॒​विँच्च॑ मे॒ ज्ञात्र॑-ञ्च मे॒",
          "iast": "sa̠ṃvichcha̍ mē̠ jñātra̍-ñcha mē̠"
        },
        {
          "n": 47,
          "devanagari": "सूश्च॑ मे प्र॒सूश्च॑ मे॒",
          "iast": "sūścha̍ mē pra̠sūścha̍ mē̠"
        },
        {
          "n": 48,
          "devanagari": "सीर॑-ञ्च मे ल॒यश्च॑ म",
          "iast": "sīra̍-ñcha mē la̠yaścha̍ ma"
        },
        {
          "n": 49,
          "devanagari": "ऋ॒त-ञ्च॑ मे॒-ऽमृत॑-ञ्च मे-ऽय॒क्ष्म-ञ्च॒ मे-ऽना॑मयच्च मे",
          "iast": "ṛ̠ta-ñcha̍ mē̠-'mṛta̍-ñcha mē-'ya̠kṣma-ñcha̠ mē-'nā̍mayachcha mē"
        },
        {
          "n": 50,
          "devanagari": "जी॒वातु॑श्च मे दीर्घायु॒त्व-ञ्च॑ मे-ऽनमि॒त्र-ञ्च॒ मे-ऽभ॑य-ञ्च मे",
          "iast": "jī̠vātu̍ścha mē dīrghāyu̠tva-ñcha̍ mē-'nami̠tra-ñcha̠ mē-'bha̍ya-ñcha mē"
        },
        {
          "n": 51,
          "devanagari": "सु॒ग-ञ्च॑ मे॒ शय॑न-ञ्च मे",
          "iast": "su̠ga-ñcha̍ mē̠ śaya̍na-ñcha mē"
        },
        {
          "n": 52,
          "devanagari": "सू॒षा च॑ मे सु॒दिन॑-ञ्च मे ॥ 3 ॥",
          "iast": "sū̠ṣā cha̍ mē su̠dina̍-ñcha mē ॥ 3 ॥"
        }
      ]
    },
    {
      "label": "4",
      "lines": [
        {
          "n": 53,
          "devanagari": "ऊर्क्च॑ मे सू॒नृता॑ च मे॒",
          "iast": "ūrkcha̍ mē sū̠nṛtā̍ cha mē̠"
        },
        {
          "n": 54,
          "devanagari": "पय॑श्च मे॒ रस॑श्च मे",
          "iast": "paya̍ścha mē̠ rasa̍ścha mē"
        },
        {
          "n": 55,
          "devanagari": "घृ॒त-ञ्च॑ मे॒ मधु॑ च मे॒",
          "iast": "ghṛ̠ta-ñcha̍ mē̠ madhu̍ cha mē̠"
        },
        {
          "n": 56,
          "devanagari": "सग्धि॑श्च मे॒ सपी॑तिश्च मे",
          "iast": "sagdhi̍ścha mē̠ sapī̍tiścha mē"
        },
        {
          "n": 57,
          "devanagari": "कृ॒षिश्च॑ मे॒ वृष्टि॑श्च मे॒",
          "iast": "kṛ̠ṣiścha̍ mē̠ vṛṣṭi̍ścha mē̠"
        },
        {
          "n": 58,
          "devanagari": "जैत्र॑-ञ्च म॒ औद्भि॑द्य-ञ्च मे",
          "iast": "jaitra̍-ñcha ma̠ audbhi̍dya-ñcha mē"
        },
        {
          "n": 59,
          "devanagari": "र॒यिश्च॑ मे॒ राय॑श्च मे",
          "iast": "ra̠yiścha̍ mē̠ rāya̍ścha mē"
        },
        {
          "n": 60,
          "devanagari": "पु॒ष्ट-ञ्च॑ मे॒ पुष्टि॑श्च मे",
          "iast": "pu̠ṣṭa-ñcha̍ mē̠ puṣṭi̍ścha mē"
        },
        {
          "n": 61,
          "devanagari": "वि॒भु च॑ मे प्र॒भु च॑ मे",
          "iast": "vi̠bhu cha̍ mē pra̠bhu cha̍ mē"
        },
        {
          "n": 62,
          "devanagari": "ब॒हु च॑ मे॒ भूय॑श्च मे",
          "iast": "ba̠hu cha̍ mē̠ bhūya̍ścha mē"
        },
        {
          "n": 63,
          "devanagari": "पू॒र्ण-ञ्च॑ मे पू॒र्णत॑र-ञ्च॒ मे-ऽक्षि॑तिश्च मे॒\nकूय॑वाश्च॒ मे-ऽन्न॑-ञ्च॒ मे-ऽक्षु॑च्च मे",
          "iast": "pū̠rṇa-ñcha̍ mē pū̠rṇata̍ra-ñcha̠ mē-'kṣi̍tiścha mē̠\nkūya̍vāścha̠ mē-'nna̍-ñcha̠ mē-'kṣu̍chcha mē"
        },
        {
          "n": 64,
          "devanagari": "व्री॒हय॑श्च मे॒ यवा᳚श्च मे॒",
          "iast": "vrī̠haya̍ścha mē̠ yavā̎ścha mē̠"
        },
        {
          "n": 65,
          "devanagari": "माषा᳚श्च मे॒ तिला᳚श्च मे",
          "iast": "māṣā̎ścha mē̠ tilā̎ścha mē"
        },
        {
          "n": 66,
          "devanagari": "मु॒द्गाश्च॑ मे ख॒ल्वा᳚श्च मे",
          "iast": "mu̠dgāścha̍ mē kha̠lvā̎ścha mē"
        },
        {
          "n": 67,
          "devanagari": "गो॒धूमा᳚श्च मे म॒सुरा᳚श्च मे",
          "iast": "gō̠dhūmā̎ścha mē ma̠surā̎ścha mē"
        },
        {
          "n": 68,
          "devanagari": "प्रि॒यङ्ग॑वश्च॒ मे-ऽण॑वश्च मे",
          "iast": "pri̠yaṅga̍vaścha̠ mē-'ṇa̍vaścha mē"
        },
        {
          "n": 69,
          "devanagari": "श्या॒माका᳚श्च मे नी॒वारा᳚श्च मे ॥ 4 ॥",
          "iast": "śyā̠mākā̎ścha mē nī̠vārā̎ścha mē ॥ 4 ॥"
        }
      ]
    },
    {
      "label": "5",
      "lines": [
        {
          "n": 70,
          "devanagari": "अश्मा॑ च मे॒ मृत्ति॑का च मे",
          "iast": "aśmā̍ cha mē̠ mṛtti̍kā cha mē"
        },
        {
          "n": 71,
          "devanagari": "गि॒रय॑श्च मे॒ पर्व॑ताश्च मे॒",
          "iast": "gi̠raya̍ścha mē̠ parva̍tāścha mē̠"
        },
        {
          "n": 72,
          "devanagari": "सिक॑ताश्च मे॒ वन॒स्पत॑यश्च मे॒",
          "iast": "sika̍tāścha mē̠ vana̠spata̍yaścha mē̠"
        },
        {
          "n": 73,
          "devanagari": "हिर॑ण्य-ञ्च॒ मे-ऽय॑श्च मे॒",
          "iast": "hira̍ṇya-ñcha̠ mē-'ya̍ścha mē̠"
        },
        {
          "n": 74,
          "devanagari": "सीस॑-ञ्च॒ मे त्रपु॑श्च मे",
          "iast": "sīsa̍-ñcha̠ mē trapu̍ścha mē"
        },
        {
          "n": 75,
          "devanagari": "श्या॒म-ञ्च॑ मे लो॒ह-ञ्च॑ मे॒-ऽग्निश्च॑ म॒",
          "iast": "śyā̠ma-ñcha̍ mē lō̠ha-ñcha̍ mē̠-'gniścha̍ ma̠"
        },
        {
          "n": 76,
          "devanagari": "आप॑श्च मे वी॒रुध॑श्च म॒ ओष॑धयश्च मे",
          "iast": "āpa̍ścha mē vī̠rudha̍ścha ma̠ ōṣa̍dhayaścha mē"
        },
        {
          "n": 77,
          "devanagari": "कृष्टप॒च्य-ञ्च॑ मे-ऽकृष्टप॒च्य-ञ्च॑ मे",
          "iast": "kṛṣṭapa̠chya-ñcha̍ mē-'kṛṣṭapa̠chya-ñcha̍ mē"
        },
        {
          "n": 78,
          "devanagari": "ग्रा॒म्याश्च॑ मे प॒शव॑ आर॒ण्याश्च॑ य॒ज्ञेन॑ कल्पन्तां",
          "iast": "grā̠myāścha̍ mē pa̠śava̍ āra̠ṇyāścha̍ ya̠jñēna̍ kalpantāṃ"
        },
