{
  "id": "raksha-kala-kara-stava",
  "language": "sanskrit",
  "title": {
    "devanagari": "रक्षाकालकरस्तवः",
    "iast": "Rakṣākālakarastavaḥ"
  },
  "source": {
    "site": "sanskritdocuments.org",
    "devanagari_url": "https://sanskritdocuments.org/doc_z_misc_general/rakShAkAlakarastavaH.html",
    "note": "Buddhist (Newar, Nepal): a hymn to Avalokiteśvara as Lokanātha. From sanskritdocuments.org, whose own colophon marks the title's कर as uncertain. One evident typo corrected (कायवाकचित्त → कायवाक्चित्त); the text's other non-classical forms, typical of Nepalese Buddhist Sanskrit, are kept as they stand. IAST generated by scripts/deva_to_iast.py; English translation prepared for this app."
  },
  "colophon": {
    "devanagari": "इति श्रीमदार्यावलोकितेश्वरभट्टारकस्य रक्षाकालकरस्तवः समाप्तः ॥",
    "iast": "iti śrīmadāryāvalōkitēśvarabhaṭṭārakasya rakṣākālakarastavaḥ samāptaḥ ॥"
  },
  "sectionUnit": "",
  "sections": [
    {
      "label": "Invocation",
      "lines": [
        {
          "n": 1,
          "devanagari": "ॐ नमो लोकनाथाय ।",
          "iast": "ōṃ namō lōkanāthāya ।"
        }
      ]
    },
    {
      "label": "Verse 1",
      "lines": [
        {
          "n": 2,
          "devanagari": "मया कृतानि पापानि कायवाक्चित्तसञ्चयैः ।",
          "iast": "mayā kṛtāni pāpāni kāyavākchittasañchayaiḥ ।"
        },
        {
          "n": 3,
          "devanagari": "तत्सर्वं हर मे नाथ रक्ष मां लोकनायक ॥ १॥",
          "iast": "tatsarvaṃ hara mē nātha rakṣa māṃ lōkanāyaka ॥ 1॥"
        }
      ]
    },
    {
      "label": "Verse 2",
      "lines": [
        {
          "n": 4,
          "devanagari": "नेपाले द्वादशाब्देषु अनावृष्टिर्महाभयम् ।",
          "iast": "nēpālē dvādaśābdēṣu anāvṛṣṭirmahābhayam ।"
        },
        {
          "n": 5,
          "devanagari": "नरेन्द्रदेवं संस्थाप्य रक्ष मां लोकनायक ॥ २॥",
          "iast": "narēndradēvaṃ saṃsthāpya rakṣa māṃ lōkanāyaka ॥ 2॥"
        }
      ]
    },
    {
      "label": "Verse 3",
      "lines": [
        {
          "n": 6,
          "devanagari": "मर्त्यभूमौ च पाताले दुःखिनो बहुलौकिकाः ।",
          "iast": "martyabhūmau cha pātālē duḥkhinō bahulaukikāḥ ।"
        },
        {
          "n": 7,
          "devanagari": "सुखवृद्धिकरस्तेषां रक्ष मां लोकनायक ॥ ३॥",
          "iast": "sukhavṛddhikarastēṣāṃ rakṣa māṃ lōkanāyaka ॥ 3॥"
        }
      ]
    },
    {
      "label": "Verse 4",
      "lines": [
        {
          "n": 8,
          "devanagari": "यत्र यत्र गतस्तत्र सर्वसत्त्वानुकम्पया ।",
          "iast": "yatra yatra gatastatra sarvasattvānukampayā ।"
        },
        {
          "n": 9,
          "devanagari": "समुद्धरसि पापेभ्यो रक्ष मां लोकनायक ॥ ४॥",
          "iast": "samuddharasi pāpēbhyō rakṣa māṃ lōkanāyaka ॥ 4॥"
        }
      ]
    },
    {
      "label": "Verse 5",
      "lines": [
        {
          "n": 10,
          "devanagari": "संसारे व्यापितोऽहं तु कथं पारं प्रयास्यते ।",
          "iast": "saṃsārē vyāpitō'haṃ tu kathaṃ pāraṃ prayāsyatē ।"
        },
        {
          "n": 11,
          "devanagari": "त्वमेव शरणं तत्र रक्ष मां लोकनायक ॥ ५॥",
          "iast": "tvamēva śaraṇaṃ tatra rakṣa māṃ lōkanāyaka ॥ 5॥"
        }
      ]
    },
    {
      "label": "Verse 6",
      "lines": [
        {
          "n": 12,
          "devanagari": "सर्वदेवमयस्त्वं हि सर्वबुद्धमयस्तथा ।",
          "iast": "sarvadēvamayastvaṃ hi sarvabuddhamayastathā ।"
        },
        {
          "n": 13,
          "devanagari": "सर्वसिद्धिमयश्चैव रक्ष मां लोकनायक ॥ ६॥",
          "iast": "sarvasiddhimayaśchaiva rakṣa māṃ lōkanāyaka ॥ 6॥"
        }
      ]
    },
    {
      "label": "Verse 7",
      "lines": [
        {
          "n": 14,
          "devanagari": "सदा कृपामयस्त्वं हि सदा रक्षामयोऽसि च ।",
          "iast": "sadā kṛpāmayastvaṃ hi sadā rakṣāmayō'si cha ।"
        },
        {
          "n": 15,
          "devanagari": "सदा प्रज्ञामयस्त्वं हि रक्ष मां लोकनायक ॥ ७॥",
          "iast": "sadā prajñāmayastvaṃ hi rakṣa māṃ lōkanāyaka ॥ 7॥"
        }
      ]
    },
    {
      "label": "Verse 8",
      "lines": [
        {
          "n": 16,
          "devanagari": "येन येन कृतं कर्म तेन तेनैव धारितम् ।",
          "iast": "yēna yēna kṛtaṃ karma tēna tēnaiva dhāritam ।"
        },
        {
          "n": 17,
          "devanagari": "यद्यदिच्छां प्रदातासि रक्ष मां लोकनायक ॥ ८॥",
          "iast": "yadyadichChāṃ pradātāsi rakṣa māṃ lōkanāyaka ॥ 8॥"
        }
      ]
    },
    {
      "label": "Verse 9",
      "lines": [
        {
          "n": 18,
          "devanagari": "सुखावतीं न संप्राप्तं यावद्धि सर्वसत्त्वकम् ।",
          "iast": "sukhāvatīṃ na saṃprāptaṃ yāvaddhi sarvasattvakam ।"
        },
        {
          "n": 19,
          "devanagari": "तावत्संसारगर्तेऽस्मिन् रक्ष मां लोकनायक ॥ ९॥",
          "iast": "tāvatsaṃsāragartē'smin rakṣa māṃ lōkanāyaka ॥ 9॥"
        }
      ]
    },
    {
      "label": "Verse 10",
      "lines": [
        {
          "n": 20,
          "devanagari": "ज्ञानिनां ज्ञानरूपोऽसि दुःखिनां दुःखहारकः ।",
          "iast": "jñānināṃ jñānarūpō'si duḥkhināṃ duḥkhahārakaḥ ।"
        },
        {
          "n": 21,
          "devanagari": "कामिनां कामरूपोऽसि रक्ष मां लोकनायक ॥ १०॥",
          "iast": "kāmināṃ kāmarūpō'si rakṣa māṃ lōkanāyaka ॥ 10॥"
        }
      ]
    },
    {
      "label": "Verse 11",
      "lines": [
        {
          "n": 22,
          "devanagari": "पूजनीयोऽसि लोकेश प्रणवस्य स्वरूपधृक् ।",
          "iast": "pūjanīyō'si lōkēśa praṇavasya svarūpadhṛk ।"
        },
        {
          "n": 23,
          "devanagari": "वन्दनीयः सदा त्वं हि रक्ष मां लोकनायक ॥ ११॥",
          "iast": "vandanīyaḥ sadā tvaṃ hi rakṣa māṃ lōkanāyaka ॥ 11॥"
        }
      ]
    },
    {
      "label": "Verse 12",
      "lines": [
        {
          "n": 24,
          "devanagari": "भर्ति वा भर्तिको वापि मित्रं वा शत्रुकोऽपि वा ।",
          "iast": "bharti vā bhartikō vāpi mitraṃ vā śatrukō'pi vā ।"
        },
        {
          "n": 25,
          "devanagari": "सर्वत्र च दयायुक्तो रक्ष मां लोकनायक ॥ १२॥",
          "iast": "sarvatra cha dayāyuktō rakṣa māṃ lōkanāyaka ॥ 12॥"
        }
      ]
    },
    {
      "label": "Verse 13",
      "lines": [
        {
          "n": 26,
          "devanagari": "लोकनाथ जगत्स्वामिन् सुभक्तिकृतचेतसा ।",
          "iast": "lōkanātha jagatsvāmin subhaktikṛtachētasā ।"
        },
        {
          "n": 27,
          "devanagari": "त्वां नमामि पुनर्भूयो रक्ष मां लोकनायक ॥ १३॥",
          "iast": "tvāṃ namāmi punarbhūyō rakṣa māṃ lōkanāyaka ॥ 13॥"
        }
      ]
    },
    {
      "label": "Verse 14",
      "lines": [
        {
          "n": 28,
          "devanagari": "अनेकदुःखभागस्मि भीष्मैर्वै कष्टसङ्कटैः ।",
          "iast": "anēkaduḥkhabhāgasmi bhīṣmairvai kaṣṭasaṅkaṭaiḥ ।"
        },
        {
          "n": 29,
          "devanagari": "दयस्व चावलोकेश मोचयस्व च मां क्षणात् ॥ १४॥",
          "iast": "dayasva chāvalōkēśa mōchayasva cha māṃ kṣaṇāt ॥ 14॥"
        }
      ]
    },
    {
      "label": "Verse 15",
      "lines": [
        {
          "n": 30,
          "devanagari": "सर्वदेक्षासुसम्पातं वर्तयन् कुरु मेऽक्षयम् ।",
          "iast": "sarvadēkṣāsusampātaṃ vartayan kuru mē'kṣayam ।"
        },
        {
          "n": 31,
          "devanagari": "अस्तु ते करुणा मह्यं भक्तिं चैवाचलां कुरु ॥ १५॥",
          "iast": "astu tē karuṇā mahyaṃ bhaktiṃ chaivāchalāṃ kuru ॥ 15॥"
        }
      ]
    }
  ]
}
