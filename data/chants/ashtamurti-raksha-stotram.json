{
  "id": "ashtamurti-raksha-stotram",
  "language": "sanskrit",
  "title": {
    "devanagari": "अष्टमूर्तिरक्षास्तोत्रम्",
    "iast": "Aṣṭamūrtirakṣāstōtram"
  },
  "source": {
    "site": "sanskritdocuments.org",
    "devanagari_url": "https://sanskritdocuments.org/doc_deities_misc/aShTamUrtirakShAstotram.html",
    "note": "Attributed to Īśvarānanda Giri. From sanskritdocuments.org, with light orthographic fixes: missing avagrahas restored (तरणेऽखिल, ततोऽग्निः, जलोऽभूत्), योगीन्द्रिसेव्य → योगीन्द्रसेव्य, and v.3's अरुणाद्रिमूर्तेर्बुर्दशैल वासिन् read as अरुणाद्रिमूर्तेऽर्बुदशैलवासिन् (Aruṇa mountain + Arbuda mountain, a transposed letter). IAST generated by scripts/deva_to_iast.py; English translation prepared for this app."
  },
  "colophon": {
    "devanagari": "इति श्रीईश्वरनन्दगिरिविरचितं अष्टमूर्तिरक्षास्तोत्रं सम्पूर्णम् ।",
    "iast": "iti śrīīśvaranandagirivirachitaṃ aṣṭamūrtirakṣāstōtraṃ sampūrṇam ।"
  },
  "sectionUnit": "Verse",
  "sections": [
    {
      "label": "1",
      "lines": [
        {
          "n": 1,
          "devanagari": "हे शर्व भूरूप पर्वतसुतेश",
          "iast": "hē śarva bhūrūpa parvatasutēśa"
        },
        {
          "n": 2,
          "devanagari": "हे धर्म वृषवाह काञ्चीपुरीश ।",
          "iast": "hē dharma vṛṣavāha kāñchīpurīśa ।"
        },
        {
          "n": 3,
          "devanagari": "दववास सौगन्ध्य भुजगेन्द्रभूष",
          "iast": "davavāsa saugandhya bhujagēndrabhūṣa"
        },
        {
          "n": 4,
          "devanagari": "पृथ्वीश मां पाहि प्रथमाष्टमूर्ते ॥ १॥",
          "iast": "pṛthvīśa māṃ pāhi prathamāṣṭamūrtē ॥ 1॥"
        }
      ]
    },
    {
      "label": "2",
      "lines": [
        {
          "n": 5,
          "devanagari": "हे दोषमल जाड्यहर शैलजाप",
          "iast": "hē dōṣamala jāḍyahara śailajāpa"
        },
        {
          "n": 6,
          "devanagari": "हे जम्बुकेशेश भव नीररूप ।",
          "iast": "hē jambukēśēśa bhava nīrarūpa ।"
        },
        {
          "n": 7,
          "devanagari": "गङ्गार्द्र करुणार्द्र नित्याभिषिक्त",
          "iast": "gaṅgārdra karuṇārdra nityābhiṣikta"
        },
        {
          "n": 8,
          "devanagari": "जललिङ्ग मां पाहि द्वितीयाष्टमूर्ते ॥ २॥",
          "iast": "jalaliṅga māṃ pāhi dvitīyāṣṭamūrtē ॥ 2॥"
        }
      ]
    },
    {
      "label": "3",
      "lines": [
        {
          "n": 9,
          "devanagari": "हे रुद्र कालाग्निरूपाघनाशिन्",
          "iast": "hē rudra kālāgnirūpāghanāśin"
        },
        {
          "n": 10,
          "devanagari": "हे भस्मदिग्धाङ्ग मदनान्तकारिन् ।",
          "iast": "hē bhasmadigdhāṅga madanāntakārin ।"
        },
        {
          "n": 11,
          "devanagari": "अरुणाद्रिमूर्तेऽर्बुदशैलवासिन्",
          "iast": "aruṇādrimūrtē'rbudaśailavāsin"
        },
        {
          "n": 12,
          "devanagari": "अनलेश मां पाहि तृतीयाष्टमूर्ते ॥ ३॥",
          "iast": "analēśa māṃ pāhi tṛtīyāṣṭamūrtē ॥ 3॥"
        }
      ]
    },
    {
      "label": "4",
      "lines": [
        {
          "n": 13,
          "devanagari": "हे मातरिश्वन् महाव्योमचारिन्",
          "iast": "hē mātariśvan mahāvyōmachārin"
        },
        {
          "n": 14,
          "devanagari": "हे कालहस्तीश शक्तिप्रदायिन् ।",
          "iast": "hē kālahastīśa śaktipradāyin ।"
        },
        {
          "n": 15,
          "devanagari": "उग्र प्रमथनाथ योगीन्द्रसेव्य",
          "iast": "ugra pramathanātha yōgīndrasēvya"
        },
        {
          "n": 16,
          "devanagari": "पवनेश मां पाहि तुरियाष्टमूर्ते ॥ ४॥",
          "iast": "pavanēśa māṃ pāhi turiyāṣṭamūrtē ॥ 4॥"
        }
      ]
    },
    {
      "label": "5",
      "lines": [
        {
          "n": 17,
          "devanagari": "हे निष्कलाकाश-सङ्काश देह",
          "iast": "hē niṣkalākāśa-saṅkāśa dēha"
        },
        {
          "n": 18,
          "devanagari": "हे चित्सभानाथ विश्वम्भरेश ।",
          "iast": "hē chitsabhānātha viśvambharēśa ।"
        },
        {
          "n": 19,
          "devanagari": "शम्भो विभो भीमदहर प्रविष्ट",
          "iast": "śambhō vibhō bhīmadahara praviṣṭa"
        },
        {
          "n": 20,
          "devanagari": "व्योमेश मां पाहि कृपयाष्टमूर्ते ॥ ५॥",
          "iast": "vyōmēśa māṃ pāhi kṛpayāṣṭamūrtē ॥ 5॥"
        }
      ]
    },
    {
      "label": "6",
      "lines": [
        {
          "n": 21,
          "devanagari": "हे भर्ग तरणेऽखिललोकसूत्र",
          "iast": "hē bharga taraṇē'khilalōkasūtra"
        },
        {
          "n": 22,
          "devanagari": "हे द्वादशात्मन् श्रुतिमन्त्र गात्र ।",
          "iast": "hē dvādaśātman śrutimantra gātra ।"
        },
        {
          "n": 23,
          "devanagari": "ईशान ज्योतिर्मयादित्यनेत्र",
          "iast": "īśāna jyōtirmayādityanētra"
        },
        {
          "n": 24,
          "devanagari": "रविरूप मां पाहि महसाष्टमूर्ते ॥ ६॥",
          "iast": "ravirūpa māṃ pāhi mahasāṣṭamūrtē ॥ 6॥"
        }
      ]
    },
    {
      "label": "7",
      "lines": [
        {
          "n": 25,
          "devanagari": "हे सोम सोमार्द्ध षोडशकलात्मन्",
          "iast": "hē sōma sōmārddha ṣōḍaśakalātman"
        },
        {
          "n": 26,
          "devanagari": "हे तारकान्तस्थ शशिखण्डमौलिन् ।",
          "iast": "hē tārakāntastha śaśikhaṇḍamaulin ।"
        },
        {
          "n": 27,
          "devanagari": "स्वामिन्महादेव मानसविहारिन्",
          "iast": "svāminmahādēva mānasavihārin"
        },
        {
          "n": 28,
          "devanagari": "शशिरूप मां पाहि सुधयाष्टमूर्ते ॥ ७॥",
          "iast": "śaśirūpa māṃ pāhi sudhayāṣṭamūrtē ॥ 7॥"
        }
      ]
    },
    {
      "label": "8",
      "lines": [
        {
          "n": 29,
          "devanagari": "हे विश्वयज्ञेश यजमानवेष",
          "iast": "hē viśvayajñēśa yajamānavēṣa"
        },
        {
          "n": 30,
          "devanagari": "हे सर्वभूतात्मभूतप्रकाश ।",
          "iast": "hē sarvabhūtātmabhūtaprakāśa ।"
        },
        {
          "n": 31,
          "devanagari": "प्रथितः पशूनां पतिरेक ईड्य",
          "iast": "prathitaḥ paśūnāṃ patirēka īḍya"
        },
        {
          "n": 32,
          "devanagari": "आत्मेश मां पाहि परमाष्टमूर्ते ॥ ८॥",
          "iast": "ātmēśa māṃ pāhi paramāṣṭamūrtē ॥ 8॥"
        }
      ]
    },
    {
      "label": "9",
      "lines": [
        {
          "n": 33,
          "devanagari": "परमात्मनः खः प्रथमः प्रसूतः",
          "iast": "paramātmanaḥ khaḥ prathamaḥ prasūtaḥ"
        },
        {
          "n": 34,
          "devanagari": "व्योमाच्च वायुर्जनितस्ततोऽग्निः",
          "iast": "vyōmāchcha vāyurjanitastatō'gniḥ"
        },
        {
          "n": 35,
          "devanagari": "अनलाज्जलोऽभूत् अद्भ्यस्तु धरणिः",
          "iast": "analājjalō'bhūt adbhyastu dharaṇiḥ"
        },
        {
          "n": 36,
          "devanagari": "सूर्येन्दुकलितान् सततं नमामि ।",
          "iast": "sūryēndukalitān satataṃ namāmi ।"
        },
        {
          "n": 37,
          "devanagari": "दिव्याष्टमूर्तीन् सततं नमामि",
          "iast": "divyāṣṭamūrtīn satataṃ namāmi"
        },
        {
          "n": 38,
          "devanagari": "संविन्मयान् तान् सततं नमामि ॥ ९॥",
          "iast": "saṃvinmayān tān satataṃ namāmi ॥ 9॥"
        }
      ]
    }
  ]
}
