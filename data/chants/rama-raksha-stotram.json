{
  "id": "rama-raksha-stotram",
  "language": "sanskrit",
  "title": {
    "devanagari": "श्रीरामरक्षास्तोत्रम्",
    "iast": "Śrī Rāmarakṣāstōtram"
  },
  "source": {
    "site": "sanskritdocuments.org",
    "devanagari_url": "https://sanskritdocuments.org/doc_raama/rraksha.html",
    "note": "Devanagari from sanskritdocuments.org (proofread by Jayesh Mistry). The page's opening Gaṇeśa invocation and closing arpaṇa line are omitted; v.38's first pāda follows the page's own bracketed variant (श्रीराम राम रामेति), the reading most reciters use. IAST generated by scripts/deva_to_iast.py; English translation prepared for this app."
  },
  "colophon": {
    "devanagari": "इति श्रीबुधकौशिकविरचितं श्रीरामरक्षास्तोत्रं सम्पूर्णम् ॥",
    "iast": "iti śrībudhakauśikavirachitaṃ śrīrāmarakṣāstōtraṃ sampūrṇam ॥"
  },
  "sectionUnit": "",
  "sections": [
    {
      "label": "Viniyoga",
      "lines": [
        {
          "n": 1,
          "devanagari": "अस्य श्रीरामरक्षास्तोत्रमन्त्रस्य । बुधकौशिक ऋषिः ।",
          "iast": "asya śrīrāmarakṣāstōtramantrasya । budhakauśika ṛṣiḥ ।"
        },
        {
          "n": 2,
          "devanagari": "श्रीसीतारामचन्द्रो देवता । अनुष्टुप् छन्दः ।",
          "iast": "śrīsītārāmachandrō dēvatā । anuṣṭup Chandaḥ ।"
        },
        {
          "n": 3,
          "devanagari": "सीता शक्तिः । श्रीमद् हनुमान कीलकम् ।",
          "iast": "sītā śaktiḥ । śrīmad hanumāna kīlakam ।"
        },
        {
          "n": 4,
          "devanagari": "श्रीरामचन्द्रप्रीत्यर्थे रामरक्षास्तोत्रजपे विनियोगः ॥",
          "iast": "śrīrāmachandraprītyarthē rāmarakṣāstōtrajapē viniyōgaḥ ॥"
        }
      ]
    },
    {
      "label": "Dhyānam",
      "lines": [
        {
          "n": 5,
          "devanagari": "ध्यायेदाजानुबाहुं धृतशरधनुषं बद्धपद्मासनस्थं",
          "iast": "dhyāyēdājānubāhuṃ dhṛtaśaradhanuṣaṃ baddhapadmāsanasthaṃ"
        },
        {
          "n": 6,
          "devanagari": "पीतं वासो वसानं नवकमलदलस्पर्धिनेत्रं प्रसन्नम् ।",
          "iast": "pītaṃ vāsō vasānaṃ navakamaladalaspardhinētraṃ prasannam ।"
        },
        {
          "n": 7,
          "devanagari": "वामाङ्कारूढ सीतामुखकमलमिलल्लोचनं नीरदाभं",
          "iast": "vāmāṅkārūḍha sītāmukhakamalamilallōchanaṃ nīradābhaṃ"
        },
        {
          "n": 8,
          "devanagari": "नानालङ्कारदीप्तं दधतमुरुजटामण्डनं रामचन्द्रम् ॥",
          "iast": "nānālaṅkāradīptaṃ dadhatamurujaṭāmaṇḍanaṃ rāmachandram ॥"
        }
      ]
    },
    {
      "label": "Verse 1",
      "lines": [
        {
          "n": 9,
          "devanagari": "चरितं रघुनाथस्य शतकोटि प्रविस्तरम् ।",
          "iast": "charitaṃ raghunāthasya śatakōṭi pravistaram ।"
        },
        {
          "n": 10,
          "devanagari": "एकैकमक्षरं पुंसां महापातकनाशनम् ॥ १॥",
          "iast": "ēkaikamakṣaraṃ puṃsāṃ mahāpātakanāśanam ॥ 1॥"
        }
      ]
    },
    {
      "label": "Verse 2",
      "lines": [
        {
          "n": 11,
          "devanagari": "ध्यात्वा नीलोत्पलश्यामं रामं राजीवलोचनम् ।",
          "iast": "dhyātvā nīlōtpalaśyāmaṃ rāmaṃ rājīvalōchanam ।"
        },
        {
          "n": 12,
          "devanagari": "जानकीलक्ष्मणोपेतं जटामुकुटमण्डितम् ॥ २॥",
          "iast": "jānakīlakṣmaṇōpētaṃ jaṭāmukuṭamaṇḍitam ॥ 2॥"
        }
      ]
    },
    {
      "label": "Verse 3",
      "lines": [
        {
          "n": 13,
          "devanagari": "सासितूणधनुर्बाणपाणिं नक्तञ्चरान्तकम् ।",
          "iast": "sāsitūṇadhanurbāṇapāṇiṃ naktañcharāntakam ।"
        },
        {
          "n": 14,
          "devanagari": "स्वलीलया जगत्त्रातुमाविर्भूतमजं विभुम् ॥ ३॥",
          "iast": "svalīlayā jagattrātumāvirbhūtamajaṃ vibhum ॥ 3॥"
        }
      ]
    },
    {
      "label": "Verse 4",
      "lines": [
        {
          "n": 15,
          "devanagari": "रामरक्षां पठेत्प्राज्ञः पापघ्नीं सर्वकामदाम् ।",
          "iast": "rāmarakṣāṃ paṭhētprājñaḥ pāpaghnīṃ sarvakāmadām ।"
        },
        {
          "n": 16,
          "devanagari": "शिरो मे राघवः पातु भालं दशरथात्मजः ॥ ४॥",
          "iast": "śirō mē rāghavaḥ pātu bhālaṃ daśarathātmajaḥ ॥ 4॥"
        }
      ]
    },
    {
      "label": "Verse 5",
      "lines": [
        {
          "n": 17,
          "devanagari": "कौसल्येयो दृशौ पातु विश्वामित्रप्रियः श्रुती ।",
          "iast": "kausalyēyō dṛśau pātu viśvāmitrapriyaḥ śrutī ।"
        },
        {
          "n": 18,
          "devanagari": "घ्राणं पातु मखत्राता मुखं सौमित्रिवत्सलः ॥ ५॥",
          "iast": "ghrāṇaṃ pātu makhatrātā mukhaṃ saumitrivatsalaḥ ॥ 5॥"
        }
      ]
    },
    {
      "label": "Verse 6",
      "lines": [
        {
          "n": 19,
          "devanagari": "जिह्वां विद्यानिधिः पातु कण्ठं भरतवन्दितः ।",
          "iast": "jihvāṃ vidyānidhiḥ pātu kaṇṭhaṃ bharatavanditaḥ ।"
        },
        {
          "n": 20,
          "devanagari": "स्कन्धौ दिव्यायुधः पातु भुजौ भग्नेशकार्मुकः ॥ ६॥",
          "iast": "skandhau divyāyudhaḥ pātu bhujau bhagnēśakārmukaḥ ॥ 6॥"
        }
      ]
    },
    {
      "label": "Verse 7",
      "lines": [
        {
          "n": 21,
          "devanagari": "करौ सीतापतिः पातु हृदयं जामदग्न्यजित् ।",
          "iast": "karau sītāpatiḥ pātu hṛdayaṃ jāmadagnyajit ।"
        },
        {
          "n": 22,
          "devanagari": "मध्यं पातु खरध्वंसी नाभिं जाम्बवदाश्रयः ॥ ७॥",
          "iast": "madhyaṃ pātu kharadhvaṃsī nābhiṃ jāmbavadāśrayaḥ ॥ 7॥"
        }
      ]
    },
    {
      "label": "Verse 8",
      "lines": [
        {
          "n": 23,
          "devanagari": "सुग्रीवेशः कटी पातु सक्थिनी हनुमत्प्रभुः ।",
          "iast": "sugrīvēśaḥ kaṭī pātu sakthinī hanumatprabhuḥ ।"
        },
        {
          "n": 24,
          "devanagari": "ऊरू रघूत्तमः पातु रक्षःकुलविनाशकृत् ॥ ८॥",
          "iast": "ūrū raghūttamaḥ pātu rakṣaḥkulavināśakṛt ॥ 8॥"
        }
      ]
    },
    {
      "label": "Verse 9",
      "lines": [
        {
          "n": 25,
          "devanagari": "जानुनी सेतुकृत्पातु जङ्घे दशमुखान्तकः ।",
          "iast": "jānunī sētukṛtpātu jaṅghē daśamukhāntakaḥ ।"
        },
        {
          "n": 26,
          "devanagari": "पादौ बिभीषणश्रीदः पातु रामोऽखिलं वपुः ॥ ९॥",
          "iast": "pādau bibhīṣaṇaśrīdaḥ pātu rāmō'khilaṃ vapuḥ ॥ 9॥"
        }
      ]
    },
    {
      "label": "Verse 10",
      "lines": [
        {
          "n": 27,
          "devanagari": "एतां रामबलोपेतां रक्षां यः सुकृती पठेत् ।",
          "iast": "ētāṃ rāmabalōpētāṃ rakṣāṃ yaḥ sukṛtī paṭhēt ।"
        },
        {
          "n": 28,
          "devanagari": "स चिरायुः सुखी पुत्री विजयी विनयी भवेत् ॥ १०॥",
          "iast": "sa chirāyuḥ sukhī putrī vijayī vinayī bhavēt ॥ 10॥"
        }
      ]
    },
    {
      "label": "Verse 11",
      "lines": [
        {
          "n": 29,
          "devanagari": "पातालभूतलव्योमचारिणश्छद्मचारिणः ।",
          "iast": "pātālabhūtalavyōmachāriṇaśChadmachāriṇaḥ ।"
        },
        {
          "n": 30,
          "devanagari": "न द्रष्टुमपि शक्तास्ते रक्षितं रामनामभिः ॥ ११॥",
          "iast": "na draṣṭumapi śaktāstē rakṣitaṃ rāmanāmabhiḥ ॥ 11॥"
        }
      ]
    },
    {
      "label": "Verse 12",
      "lines": [
        {
          "n": 31,
          "devanagari": "रामेति रामभद्रेति रामचन्द्रेति वा स्मरन् ।",
          "iast": "rāmēti rāmabhadrēti rāmachandrēti vā smaran ।"
        },
        {
          "n": 32,
          "devanagari": "नरो न लिप्यते पापैः भुक्तिं मुक्तिं च विन्दति ॥ १२॥",
          "iast": "narō na lipyatē pāpaiḥ bhuktiṃ muktiṃ cha vindati ॥ 12॥"
        }
      ]
    },
    {
      "label": "Verse 13",
      "lines": [
        {
          "n": 33,
          "devanagari": "जगज्जैत्रैकमन्त्रेण रामनाम्नाभिरक्षितम् ।",
          "iast": "jagajjaitraikamantrēṇa rāmanāmnābhirakṣitam ।"
        },
        {
          "n": 34,
          "devanagari": "यः कण्ठे धारयेत्तस्य करस्थाः सर्वसिद्धयः ॥ १३॥",
          "iast": "yaḥ kaṇṭhē dhārayēttasya karasthāḥ sarvasiddhayaḥ ॥ 13॥"
        }
      ]
    },
    {
      "label": "Verse 14",
      "lines": [
        {
          "n": 35,
          "devanagari": "वज्रपञ्जरनामेदं यो रामकवचं स्मरेत् ।",
          "iast": "vajrapañjaranāmēdaṃ yō rāmakavachaṃ smarēt ।"
        },
        {
          "n": 36,
          "devanagari": "अव्याहताज्ञः सर्वत्र लभते जयमङ्गलम् ॥ १४॥",
          "iast": "avyāhatājñaḥ sarvatra labhatē jayamaṅgalam ॥ 14॥"
        }
      ]
    },
    {
      "label": "Verse 15",
      "lines": [
        {
          "n": 37,
          "devanagari": "आदिष्टवान् यथा स्वप्ने रामरक्षामिमां हरः ।",
          "iast": "ādiṣṭavān yathā svapnē rāmarakṣāmimāṃ haraḥ ।"
        },
        {
          "n": 38,
          "devanagari": "तथा लिखितवान् प्रातः प्रबुद्धो बुधकौशिकः ॥ १५॥",
          "iast": "tathā likhitavān prātaḥ prabuddhō budhakauśikaḥ ॥ 15॥"
        }
      ]
    },
    {
      "label": "Verse 16",
      "lines": [
        {
          "n": 39,
          "devanagari": "आरामः कल्पवृक्षाणां विरामः सकलापदाम् ।",
          "iast": "ārāmaḥ kalpavṛkṣāṇāṃ virāmaḥ sakalāpadām ।"
        },
        {
          "n": 40,
          "devanagari": "अभिरामस्त्रिलोकानां रामः श्रीमान् स नः प्रभुः ॥ १६॥",
          "iast": "abhirāmastrilōkānāṃ rāmaḥ śrīmān sa naḥ prabhuḥ ॥ 16॥"
        }
      ]
    },
    {
      "label": "Verse 17",
      "lines": [
        {
          "n": 41,
          "devanagari": "तरुणौ रूपसम्पन्नौ सुकुमारौ महाबलौ ।",
          "iast": "taruṇau rūpasampannau sukumārau mahābalau ।"
        },
        {
          "n": 42,
          "devanagari": "पुण्डरीकविशालाक्षौ चीरकृष्णाजिनाम्बरौ ॥ १७॥",
          "iast": "puṇḍarīkaviśālākṣau chīrakṛṣṇājināmbarau ॥ 17॥"
        }
      ]
    },
    {
      "label": "Verse 18",
      "lines": [
        {
          "n": 43,
          "devanagari": "फलमूलाशिनौ दान्तौ तापसौ ब्रह्मचारिणौ ।",
          "iast": "phalamūlāśinau dāntau tāpasau brahmachāriṇau ।"
        },
        {
          "n": 44,
          "devanagari": "पुत्रौ दशरथस्यैतौ भ्रातरौ रामलक्ष्मणौ ॥ १८॥",
          "iast": "putrau daśarathasyaitau bhrātarau rāmalakṣmaṇau ॥ 18॥"
        }
      ]
    },
    {
      "label": "Verse 19",
      "lines": [
        {
          "n": 45,
          "devanagari": "शरण्यौ सर्वसत्त्वानां श्रेष्ठौ सर्वधनुष्मताम् ।",
          "iast": "śaraṇyau sarvasattvānāṃ śrēṣṭhau sarvadhanuṣmatām ।"
        },
        {
          "n": 46,
          "devanagari": "रक्षः कुलनिहन्तारौ त्रायेतां नो रघूत्तमौ ॥ १९॥",
          "iast": "rakṣaḥ kulanihantārau trāyētāṃ nō raghūttamau ॥ 19॥"
        }
      ]
    },
    {
      "label": "Verse 20",
      "lines": [
        {
          "n": 47,
          "devanagari": "आत्तसज्जधनुषाविषुस्पृशावक्षयाशुगनिषङ्गसङ्गिनौ ।",
          "iast": "āttasajjadhanuṣāviṣuspṛśāvakṣayāśuganiṣaṅgasaṅginau ।"
        },
        {
          "n": 48,
          "devanagari": "रक्षणाय मम रामलक्ष्मणावग्रतः पथि सदैव गच्छताम् ॥ २०॥",
          "iast": "rakṣaṇāya mama rāmalakṣmaṇāvagrataḥ pathi sadaiva gachChatām ॥ 20॥"
        }
      ]
    },
    {
      "label": "Verse 21",
      "lines": [
        {
          "n": 49,
          "devanagari": "सन्नद्धः कवची खड्गी चापबाणधरो युवा ।",
          "iast": "sannaddhaḥ kavachī khaḍgī chāpabāṇadharō yuvā ।"
        },
        {
          "n": 50,
          "devanagari": "गच्छन्मनोरथोऽस्माकं रामः पातु सलक्ष्मणः ॥ २१॥",
          "iast": "gachChanmanōrathō'smākaṃ rāmaḥ pātu salakṣmaṇaḥ ॥ 21॥"
        }
      ]
    },
    {
      "label": "Verse 22",
      "lines": [
        {
          "n": 51,
          "devanagari": "रामो दाशरथिः शूरो लक्ष्मणानुचरो बली ।",
          "iast": "rāmō dāśarathiḥ śūrō lakṣmaṇānucharō balī ।"
        },
        {
          "n": 52,
          "devanagari": "काकुत्स्थः पुरुषः पूर्णः कौसल्येयो रघूत्तमः ॥ २२॥",
          "iast": "kākutsthaḥ puruṣaḥ pūrṇaḥ kausalyēyō raghūttamaḥ ॥ 22॥"
        }
      ]
    },
    {
      "label": "Verse 23",
      "lines": [
        {
          "n": 53,
          "devanagari": "वेदान्तवेद्यो यज्ञेशः पुराणपुरुषोत्तमः ।",
          "iast": "vēdāntavēdyō yajñēśaḥ purāṇapuruṣōttamaḥ ।"
        },
        {
          "n": 54,
          "devanagari": "जानकीवल्लभः श्रीमान् अप्रमेय पराक्रमः ॥ २३॥",
          "iast": "jānakīvallabhaḥ śrīmān apramēya parākramaḥ ॥ 23॥"
        }
      ]
    },
    {
      "label": "Verse 24",
      "lines": [
        {
          "n": 55,
          "devanagari": "इत्येतानि जपन्नित्यं मद्भक्तः श्रद्धयान्वितः ।",
          "iast": "ityētāni japannityaṃ madbhaktaḥ śraddhayānvitaḥ ।"
        },
        {
          "n": 56,
          "devanagari": "अश्वमेधाधिकं पुण्यं सम्प्राप्नोति न संशयः ॥ २४॥",
          "iast": "aśvamēdhādhikaṃ puṇyaṃ samprāpnōti na saṃśayaḥ ॥ 24॥"
        }
      ]
    },
    {
      "label": "Verse 25",
      "lines": [
        {
          "n": 57,
          "devanagari": "रामं दूर्वादलश्यामं पद्माक्षं पीतवाससम् ।",
          "iast": "rāmaṃ dūrvādalaśyāmaṃ padmākṣaṃ pītavāsasam ।"
        },
        {
          "n": 58,
          "devanagari": "स्तुवन्ति नामभिर्दिव्यैः न ते संसारिणो नराः ॥ २५॥",
          "iast": "stuvanti nāmabhirdivyaiḥ na tē saṃsāriṇō narāḥ ॥ 25॥"
        }
      ]
    },
    {
      "label": "Verse 26",
      "lines": [
        {
          "n": 59,
          "devanagari": "रामं लक्ष्मणपूर्वजं रघुवरं सीतापतिं सुन्दरम् ।",
          "iast": "rāmaṃ lakṣmaṇapūrvajaṃ raghuvaraṃ sītāpatiṃ sundaram ।"
        },
        {
          "n": 60,
          "devanagari": "काकुत्स्थं करुणार्णवं गुणनिधिं विप्रप्रियं धार्मिकम् ।",
          "iast": "kākutsthaṃ karuṇārṇavaṃ guṇanidhiṃ viprapriyaṃ dhārmikam ।"
        },
        {
          "n": 61,
          "devanagari": "राजेन्द्रं सत्यसन्धं दशरथतनयं श्यामलं शान्तमूर्तिम् ।",
          "iast": "rājēndraṃ satyasandhaṃ daśarathatanayaṃ śyāmalaṃ śāntamūrtim ।"
        },
        {
          "n": 62,
          "devanagari": "वन्दे लोकाभिरामं रघुकुलतिलकं राघवं रावणारिम् ॥ २६॥",
          "iast": "vandē lōkābhirāmaṃ raghukulatilakaṃ rāghavaṃ rāvaṇārim ॥ 26॥"
        }
      ]
    },
    {
      "label": "Verse 27",
      "lines": [
        {
          "n": 63,
          "devanagari": "रामाय रामभद्राय रामचन्द्राय वेधसे ।",
          "iast": "rāmāya rāmabhadrāya rāmachandrāya vēdhasē ।"
        },
        {
          "n": 64,
          "devanagari": "रघुनाथाय नाथाय सीतायाः पतये नमः ॥ २७॥",
          "iast": "raghunāthāya nāthāya sītāyāḥ patayē namaḥ ॥ 27॥"
        }
      ]
    },
    {
      "label": "Verse 28",
      "lines": [
        {
          "n": 65,
          "devanagari": "श्रीराम राम रघुनन्दन राम राम",
          "iast": "śrīrāma rāma raghunandana rāma rāma"
        },
        {
          "n": 66,
          "devanagari": "श्रीराम राम भरताग्रज राम राम ।",
          "iast": "śrīrāma rāma bharatāgraja rāma rāma ।"
        },
        {
          "n": 67,
          "devanagari": "श्रीराम राम रणकर्कश राम राम",
          "iast": "śrīrāma rāma raṇakarkaśa rāma rāma"
        },
        {
          "n": 68,
          "devanagari": "श्रीराम राम शरणं भव राम राम ॥ २८॥",
          "iast": "śrīrāma rāma śaraṇaṃ bhava rāma rāma ॥ 28॥"
        }
      ]
    },
    {
      "label": "Verse 29",
      "lines": [
        {
          "n": 69,
          "devanagari": "श्रीरामचन्द्रचरणौ मनसा स्मरामि",
          "iast": "śrīrāmachandracharaṇau manasā smarāmi"
        },
        {
          "n": 70,
          "devanagari": "श्रीरामचन्द्रचरणौ वचसा गृणामि ।",
          "iast": "śrīrāmachandracharaṇau vachasā gṛṇāmi ।"
        },
        {
          "n": 71,
          "devanagari": "श्रीरामचन्द्रचरणौ शिरसा नमामि",
          "iast": "śrīrāmachandracharaṇau śirasā namāmi"
        },
        {
          "n": 72,
          "devanagari": "श्रीरामचन्द्रचरणौ शरणं प्रपद्ये ॥ २९॥",
          "iast": "śrīrāmachandracharaṇau śaraṇaṃ prapadyē ॥ 29॥"
        }
      ]
    },
    {
      "label": "Verse 30",
      "lines": [
        {
          "n": 73,
          "devanagari": "माता रामो मत्पिता रामचन्द्रः",
          "iast": "mātā rāmō matpitā rāmachandraḥ"
        },
        {
          "n": 74,
          "devanagari": "स्वामी रामो मत्सखा रामचन्द्रः ।",
          "iast": "svāmī rāmō matsakhā rāmachandraḥ ।"
        },
        {
          "n": 75,
          "devanagari": "सर्वस्वं मे रामचन्द्रो दयालु-",
          "iast": "sarvasvaṃ mē rāmachandrō dayālu-"
        },
        {
          "n": 76,
          "devanagari": "र्नान्यं जाने नैव जाने न जाने ॥ ३०॥",
          "iast": "rnānyaṃ jānē naiva jānē na jānē ॥ 30॥"
        }
      ]
    },
    {
      "label": "Verse 31",
      "lines": [
        {
          "n": 77,
          "devanagari": "दक्षिणे लक्ष्मणो यस्य वामे तु जनकात्मजा ।",
          "iast": "dakṣiṇē lakṣmaṇō yasya vāmē tu janakātmajā ।"
        },
        {
          "n": 78,
          "devanagari": "पुरतो मारुतिर्यस्य तं वन्दे रघुनन्दनम् ॥ ३१॥",
          "iast": "puratō mārutiryasya taṃ vandē raghunandanam ॥ 31॥"
        }
      ]
    },
    {
      "label": "Verse 32",
      "lines": [
        {
          "n": 79,
          "devanagari": "लोकाभिरामं रणरङ्गधीरं",
          "iast": "lōkābhirāmaṃ raṇaraṅgadhīraṃ"
        },
        {
          "n": 80,
          "devanagari": "राजीवनेत्रं रघुवंशनाथम् ।",
          "iast": "rājīvanētraṃ raghuvaṃśanātham ।"
        },
        {
          "n": 81,
          "devanagari": "कारुण्यरूपं करुणाकरं तं",
          "iast": "kāruṇyarūpaṃ karuṇākaraṃ taṃ"
        },
        {
          "n": 82,
          "devanagari": "श्रीरामचन्द्रम् शरणं प्रपद्ये ॥ ३२॥",
          "iast": "śrīrāmachandram śaraṇaṃ prapadyē ॥ 32॥"
        }
      ]
    },
    {
      "label": "Verse 33",
      "lines": [
        {
          "n": 83,
          "devanagari": "मनोजवं मारुततुल्यवेगं",
          "iast": "manōjavaṃ mārutatulyavēgaṃ"
        },
        {
          "n": 84,
          "devanagari": "जितेन्द्रियं बुद्धिमतां वरिष्ठम् ।",
          "iast": "jitēndriyaṃ buddhimatāṃ variṣṭham ।"
        },
        {
          "n": 85,
          "devanagari": "वातात्मजं वानरयूथमुख्यं",
          "iast": "vātātmajaṃ vānarayūthamukhyaṃ"
        },
        {
          "n": 86,
          "devanagari": "श्रीरामदूतं शरणं प्रपद्ये ॥ ३३॥",
          "iast": "śrīrāmadūtaṃ śaraṇaṃ prapadyē ॥ 33॥"
        }
      ]
    },
    {
      "label": "Verse 34",
      "lines": [
        {
          "n": 87,
          "devanagari": "कूजन्तं रामरामेति मधुरं मधुराक्षरम् ।",
          "iast": "kūjantaṃ rāmarāmēti madhuraṃ madhurākṣaram ।"
        },
        {
          "n": 88,
          "devanagari": "आरुह्य कविताशाखां वन्दे वाल्मीकिकोकिलम् ॥ ३४॥",
          "iast": "āruhya kavitāśākhāṃ vandē vālmīkikōkilam ॥ 34॥"
        }
      ]
    },
    {
      "label": "Verse 35",
      "lines": [
        {
          "n": 89,
          "devanagari": "आपदामपहर्तारं दातारं सर्वसम्पदाम् ।",
          "iast": "āpadāmapahartāraṃ dātāraṃ sarvasampadām ।"
        },
        {
          "n": 90,
          "devanagari": "लोकाभिरामं श्रीरामं भूयो भूयो नमाम्यहम् ॥ ३५॥",
          "iast": "lōkābhirāmaṃ śrīrāmaṃ bhūyō bhūyō namāmyaham ॥ 35॥"
        }
      ]
    },
    {
      "label": "Verse 36",
      "lines": [
        {
          "n": 91,
          "devanagari": "भर्जनं भवबीजानामर्जनं सुखसम्पदाम् ।",
          "iast": "bharjanaṃ bhavabījānāmarjanaṃ sukhasampadām ।"
        },
        {
          "n": 92,
          "devanagari": "तर्जनं यमदूतानां रामरामेति गर्जनम् ॥ ३६॥",
          "iast": "tarjanaṃ yamadūtānāṃ rāmarāmēti garjanam ॥ 36॥"
        }
      ]
    },
    {
      "label": "Verse 37",
      "lines": [
        {
          "n": 93,
          "devanagari": "रामो राजमणिः सदा विजयते रामं रमेशं भजे",
          "iast": "rāmō rājamaṇiḥ sadā vijayatē rāmaṃ ramēśaṃ bhajē"
        },
        {
          "n": 94,
          "devanagari": "रामेणाभिहता निशाचरचमू रामाय तस्मै नमः ।",
          "iast": "rāmēṇābhihatā niśācharachamū rāmāya tasmai namaḥ ।"
        },
        {
          "n": 95,
          "devanagari": "रामान्नास्ति परायणं परतरं रामस्य दासोऽस्म्यहं",
          "iast": "rāmānnāsti parāyaṇaṃ parataraṃ rāmasya dāsō'smyahaṃ"
        },
        {
          "n": 96,
          "devanagari": "रामे चित्तलयः सदा भवतु मे भो राम मामुद्धर ॥ ३७॥",
          "iast": "rāmē chittalayaḥ sadā bhavatu mē bhō rāma māmuddhara ॥ 37॥"
        }
      ]
    },
    {
      "label": "Verse 38",
      "lines": [
        {
          "n": 97,
          "devanagari": "श्रीराम राम रामेति रमे रामे मनोरमे ।",
          "iast": "śrīrāma rāma rāmēti ramē rāmē manōramē ।"
        },
        {
          "n": 98,
          "devanagari": "सहस्रनाम तत्तुल्यं रामनाम वरानने ॥ ३८॥",
          "iast": "sahasranāma tattulyaṃ rāmanāma varānanē ॥ 38॥"
        }
      ]
    }
  ]
}
