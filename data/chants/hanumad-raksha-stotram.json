{
  "id": "hanumad-raksha-stotram",
  "language": "sanskrit",
  "title": {
    "devanagari": "श्रीहनुमद्रक्षास्तोत्रम्",
    "iast": "Śrī Hanumadrakṣāstōtram"
  },
  "source": {
    "site": "sanskritdocuments.org",
    "devanagari_url": "https://sanskritdocuments.org/doc_hanumaana/hanumadrakShAstotram.html",
    "note": "The traditional Hanumad Rakṣā Stotram (\"vāme karē vairibhidaṃ\"), from sanskritdocuments.org. A second, modern composition of the same name (by Sītārāma Śarmā, modelled on the Rāma Rakṣā) is catalogued there separately and not included. IAST generated by scripts/deva_to_iast.py; English translation prepared for this app."
  },
  "colophon": {
    "devanagari": "इति श्रीहनुमद्रक्षास्तोत्रं सम्पूर्णम् ।",
    "iast": "iti śrīhanumadrakṣāstōtraṃ sampūrṇam ।"
  },
  "sectionUnit": "Verse",
  "sections": [
    {
      "label": "1",
      "lines": [
        {
          "n": 1,
          "devanagari": "वामे करे वैरिभिदं वहन्तं शैलं परे श‍ृङ्खलहारटङ्कम् ।",
          "iast": "vāmē karē vairibhidaṃ vahantaṃ śailaṃ parē śṛṅkhalahāraṭaṅkam ।"
        },
        {
          "n": 2,
          "devanagari": "ददानमच्छाच्छसुवर्णवर्णं भजे ज्वलत्कुण्डलमाञ्जनेयम् ॥ १॥",
          "iast": "dadānamachChāchChasuvarṇavarṇaṃ bhajē jvalatkuṇḍalamāñjanēyam ॥ 1॥"
        }
      ]
    },
    {
      "label": "2",
      "lines": [
        {
          "n": 3,
          "devanagari": "पद्मरागमणिकुण्डलत्विषा पाटलीकृतकपोलमस्तकम् ।",
          "iast": "padmarāgamaṇikuṇḍalatviṣā pāṭalīkṛtakapōlamastakam ।"
        },
        {
          "n": 4,
          "devanagari": "दिव्यहेमकदलीवनान्तरे भावयामि पवमाननन्दनम् ॥ २॥",
          "iast": "divyahēmakadalīvanāntarē bhāvayāmi pavamānanandanam ॥ 2॥"
        }
      ]
    },
    {
      "label": "3",
      "lines": [
        {
          "n": 5,
          "devanagari": "उद्यदादित्यसङ्काशमुदारभुजविक्रमम् ।",
          "iast": "udyadādityasaṅkāśamudārabhujavikramam ।"
        },
        {
          "n": 6,
          "devanagari": "कन्दर्पकोटिलावण्यं सर्वविद्याविशारदम् ॥ ३॥",
          "iast": "kandarpakōṭilāvaṇyaṃ sarvavidyāviśāradam ॥ 3॥"
        }
      ]
    },
    {
      "label": "4",
      "lines": [
        {
          "n": 7,
          "devanagari": "श्रीरामहृदयानन्दं भक्तकल्पमहीरुहम् ।",
          "iast": "śrīrāmahṛdayānandaṃ bhaktakalpamahīruham ।"
        },
        {
          "n": 8,
          "devanagari": "अभयं वरदं दोर्भ्यां कलये मारुतात्मजम् ॥ ४॥",
          "iast": "abhayaṃ varadaṃ dōrbhyāṃ kalayē mārutātmajam ॥ 4॥"
        }
      ]
    },
    {
      "label": "5",
      "lines": [
        {
          "n": 9,
          "devanagari": "वामहस्ते महाकृच्छ्रदशास्यकरमर्दनम् ।",
          "iast": "vāmahastē mahākṛchChradaśāsyakaramardanam ।"
        },
        {
          "n": 10,
          "devanagari": "उद्यद्वीक्षणकोदण्डं हनूमन्तं विचिन्तयेत् ॥ ५॥",
          "iast": "udyadvīkṣaṇakōdaṇḍaṃ hanūmantaṃ vichintayēt ॥ 5॥"
        }
      ]
    },
    {
      "label": "6",
      "lines": [
        {
          "n": 11,
          "devanagari": "स्फटिकाभं स्वर्णकान्तिं द्विभुजं च कृताञ्जलिम् ।",
          "iast": "sphaṭikābhaṃ svarṇakāntiṃ dvibhujaṃ cha kṛtāñjalim ।"
        },
        {
          "n": 12,
          "devanagari": "कुण्डलद्वयसंशोभिमुखाम्भोजं हरिं भजे ॥ ६॥",
          "iast": "kuṇḍaladvayasaṃśōbhimukhāmbhōjaṃ hariṃ bhajē ॥ 6॥"
        }
      ]
    }
  ]
}
