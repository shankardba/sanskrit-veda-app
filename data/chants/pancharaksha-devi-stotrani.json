{
  "id": "pancharaksha-devi-stotrani",
  "language": "sanskrit",
  "title": {
    "devanagari": "पञ्चरक्षादेवीस्तोत्राणि",
    "iast": "Pañcharakṣādēvīstōtrāṇi"
  },
  "source": {
    "site": "sanskritdocuments.org",
    "devanagari_url": "https://sanskritdocuments.org/doc_devii/pancharakShAdevIstotrANi.html",
    "note": "Buddhist (Mahāyāna, Nepalese tradition): five short hymns to the five Pañcarakṣā protective goddesses, one section each. From sanskritdocuments.org, with two evident typos corrected (मन्त्रामुसारिणीम् → मन्त्रानुसारिणीम्, महामायूरीर्यै → महामायूर्यै). IAST generated by scripts/deva_to_iast.py; English translation prepared for this app."
  },
  "sectionUnit": "",
  "sections": [
    {
      "label": "Mahāpratisarā",
      "lines": [
        {
          "n": 1,
          "devanagari": "ॐ नमः श्रीमहाप्रतिसरायै ।",
          "iast": "ōṃ namaḥ śrīmahāpratisarāyai ।"
        },
        {
          "n": 2,
          "devanagari": "तथागताद्यास्तथतां तत्त्वमापुर्महत्तरम् ।",
          "iast": "tathāgatādyāstathatāṃ tattvamāpurmahattaram ।"
        },
        {
          "n": 3,
          "devanagari": "धारणीधारणाद्यस्याः प्रतिसरां नमामि ताम् ॥ १॥",
          "iast": "dhāraṇīdhāraṇādyasyāḥ pratisarāṃ namāmi tām ॥ 1॥"
        },
        {
          "n": 4,
          "devanagari": "रणे शक्रोऽजयद्दैत्यान् धारणीध्वजधृग् बहून् ।",
          "iast": "raṇē śakrō'jayaddaityān dhāraṇīdhvajadhṛg bahūn ।"
        },
        {
          "n": 5,
          "devanagari": "सङ्ग्रामजयदां भीमां प्रतिसरां नमामि ताम् ॥ २॥",
          "iast": "saṅgrāmajayadāṃ bhīmāṃ pratisarāṃ namāmi tām ॥ 2॥"
        },
        {
          "n": 6,
          "devanagari": "यत्प्रभावाद् ब्रह्मदत्तोऽलभद् राज्यमकण्टकम् ।",
          "iast": "yatprabhāvād brahmadattō'labhad rājyamakaṇṭakam ।"
        },
        {
          "n": 7,
          "devanagari": "सार्वभौमप्रदां देवीं प्रतिसरां नमामि ताम् ॥ ३॥",
          "iast": "sārvabhaumapradāṃ dēvīṃ pratisarāṃ namāmi tām ॥ 3॥"
        },
        {
          "n": 8,
          "devanagari": "बह्वपराधोऽपि यद्भक्तो राज्याधिकारमाप्तवान् ।",
          "iast": "bahvaparādhō'pi yadbhaktō rājyādhikāramāptavān ।"
        },
        {
          "n": 9,
          "devanagari": "शस्त्रादिभीतिसंहत्रीं प्रतिसरां नमामि ताम् ॥ ४॥",
          "iast": "śastrādibhītisaṃhatrīṃ pratisarāṃ namāmi tām ॥ 4॥"
        },
        {
          "n": 10,
          "devanagari": "रत्नान्यवापुर्वणिजो यां स्मृत्वोदधिनिर्गताः ।",
          "iast": "ratnānyavāpurvaṇijō yāṃ smṛtvōdadhinirgatāḥ ।"
        },
        {
          "n": 11,
          "devanagari": "सर्वबाधाप्रशमनीं प्रतिसरां नमामि ताम् ॥ ५॥",
          "iast": "sarvabādhāpraśamanīṃ pratisarāṃ namāmi tām ॥ 5॥"
        },
        {
          "n": 12,
          "devanagari": "श्रीमहाप्रतिसरारक्षादेवीस्तोत्रं सम्पूर्णम् ।",
          "iast": "śrīmahāpratisarārakṣādēvīstōtraṃ sampūrṇam ।"
        }
      ]
    },
    {
      "label": "Mahāmantrānusāriṇī",
      "lines": [
        {
          "n": 13,
          "devanagari": "ॐ नमः श्रीमहामन्त्रानुसारिण्यै ।",
          "iast": "ōṃ namaḥ śrīmahāmantrānusāriṇyai ।"
        },
        {
          "n": 14,
          "devanagari": "बुद्धाधिष्ठानतो बुद्धाभयदां भयनाशिनीम् ।",
          "iast": "buddhādhiṣṭhānatō buddhābhayadāṃ bhayanāśinīm ।"
        },
        {
          "n": 15,
          "devanagari": "भवाम्बुधिनिमग्नानां नमो मन्त्रानुसारिणीम् ॥ १॥",
          "iast": "bhavāmbudhinimagnānāṃ namō mantrānusāriṇīm ॥ 1॥"
        },
        {
          "n": 16,
          "devanagari": "यन्मन्त्रोच्चारणादेव षडीतयः सुदारुणाः ।",
          "iast": "yanmantrōchchāraṇādēva ṣaḍītayaḥ sudāruṇāḥ ।"
        },
        {
          "n": 17,
          "devanagari": "नाशं प्रयान्ति वरदां नमो मन्त्रानुसारिणीम् ॥ २॥",
          "iast": "nāśaṃ prayānti varadāṃ namō mantrānusāriṇīm ॥ 2॥"
        },
        {
          "n": 18,
          "devanagari": "मन्त्रानुसारिणो लोकान् नान्ये मन्त्रादयो ग्रहाः ।",
          "iast": "mantrānusāriṇō lōkān nānyē mantrādayō grahāḥ ।"
        },
        {
          "n": 19,
          "devanagari": "पीडयन्ति प्रियांश्चापि नमो मन्त्रानुसारिणीम् ॥ ३॥",
          "iast": "pīḍayanti priyāṃśchāpi namō mantrānusāriṇīm ॥ 3॥"
        },
        {
          "n": 20,
          "devanagari": "बुद्धोऽभ्यभाषद् गाथास्ता यन्मन्त्रकथनान्तरम् ।",
          "iast": "buddhō'bhyabhāṣad gāthāstā yanmantrakathanāntaram ।"
        },
        {
          "n": 21,
          "devanagari": "याभिः सर्वत्र स्वस्ति स्यान्नमो मन्त्रानुसारिणीम् ॥ ४॥",
          "iast": "yābhiḥ sarvatra svasti syānnamō mantrānusāriṇīm ॥ 4॥"
        },
        {
          "n": 22,
          "devanagari": "कलौ बुद्धविहीनेऽस्मिन् लोकानां हितमाचरेत् ।",
          "iast": "kalau buddhavihīnē'smin lōkānāṃ hitamācharēt ।"
        },
        {
          "n": 23,
          "devanagari": "पापोत्पातप्रशमनीं नमो मन्त्रानुसारिणीम् ॥ ५॥",
          "iast": "pāpōtpātapraśamanīṃ namō mantrānusāriṇīm ॥ 5॥"
        },
        {
          "n": 24,
          "devanagari": "श्रीमहामन्त्रानुसारिणीस्तोत्रं सम्पूर्णम् ।",
          "iast": "śrīmahāmantrānusāriṇīstōtraṃ sampūrṇam ।"
        }
      ]
    },
    {
      "label": "Mahāmāyūrī",
      "lines": [
        {
          "n": 25,
          "devanagari": "ॐ नमः श्रीमहामायूर्यै ।",
          "iast": "ōṃ namaḥ śrīmahāmāyūryai ।"
        },
        {
          "n": 26,
          "devanagari": "दुष्टं कृष्णभुजङ्गं च नरः स्वान्तिकं पालयेत् ।",
          "iast": "duṣṭaṃ kṛṣṇabhujaṅgaṃ cha naraḥ svāntikaṃ pālayēt ।"
        },
        {
          "n": 27,
          "devanagari": "यस्या मन्त्रानुभावेन मायूरीं प्रणमामि ताम् ॥ १॥",
          "iast": "yasyā mantrānubhāvēna māyūrīṃ praṇamāmi tām ॥ 1॥"
        },
        {
          "n": 28,
          "devanagari": "ब्रह्मादयो लोकपाला यद्धारण्या समाप्नुवन् ।",
          "iast": "brahmādayō lōkapālā yaddhāraṇyā samāpnuvan ।"
        },
        {
          "n": 29,
          "devanagari": "स्वानि स्वान्यधिकाराणि मायूरीं प्रणमामि ताम् ॥ २॥",
          "iast": "svāni svānyadhikārāṇi māyūrīṃ praṇamāmi tām ॥ 2॥"
        },
        {
          "n": 30,
          "devanagari": "स्वर्णावभासं शिखिनं नालभज्जपिनं कुधीः ।",
          "iast": "svarṇāvabhāsaṃ śikhinaṃ nālabhajjapinaṃ kudhīḥ ।"
        },
        {
          "n": 31,
          "devanagari": "अमोघेनापि पाशेन मायूरीं प्रणमामि ताम् ॥ ३॥",
          "iast": "amōghēnāpi pāśēna māyūrīṃ praṇamāmi tām ॥ 3॥"
        },
        {
          "n": 32,
          "devanagari": "यन्मन्त्रजपतो जीवाः प्राजीवञ्छुष्कपादपाः ।",
          "iast": "yanmantrajapatō jīvāḥ prājīvañChuṣkapādapāḥ ।"
        },
        {
          "n": 33,
          "devanagari": "मृतसञ्जीविनीं देवीं मायूरीं प्रणमामि ताम् ॥ ४॥",
          "iast": "mṛtasañjīvinīṃ dēvīṃ māyūrīṃ praṇamāmi tām ॥ 4॥"
        },
        {
          "n": 34,
          "devanagari": "यन्मन्त्रिसङ्गात् पवनो महोपद्रवशान्तिकृत् ।",
          "iast": "yanmantrisaṅgāt pavanō mahōpadravaśāntikṛt ।"
        },
        {
          "n": 35,
          "devanagari": "बुद्धानां बोधिदां नित्यं मायूरीं प्रणमामि ताम् ॥ ५॥",
          "iast": "buddhānāṃ bōdhidāṃ nityaṃ māyūrīṃ praṇamāmi tām ॥ 5॥"
        },
        {
          "n": 36,
          "devanagari": "श्रीमहामायूरीरक्षादेवीस्तोत्रं सम्पूर्णम् ।",
          "iast": "śrīmahāmāyūrīrakṣādēvīstōtraṃ sampūrṇam ।"
        }
      ]
    },
    {
      "label": "Mahāśītavatī",
      "lines": [
        {
          "n": 37,
          "devanagari": "ॐ नमो महाशीतवत्यै ।",
          "iast": "ōṃ namō mahāśītavatyai ।"
        },
        {
          "n": 38,
          "devanagari": "यद्धारणीमनुजपन् राहुलो भद्रमाप्तवान् ।",
          "iast": "yaddhāraṇīmanujapan rāhulō bhadramāptavān ।"
        },
        {
          "n": 39,
          "devanagari": "विहेठितो ग्रहैः सर्वैः शीतवतीं नमाम्यहम् ॥ १॥",
          "iast": "vihēṭhitō grahaiḥ sarvaiḥ śītavatīṃ namāmyaham ॥ 1॥"
        },
        {
          "n": 40,
          "devanagari": "पापतापे शीतकरीं शीतलाद्युपसर्गतः ।",
          "iast": "pāpatāpē śītakarīṃ śītalādyupasargataḥ ।"
        },
        {
          "n": 41,
          "devanagari": "शीतोष्णदुःखशमनीं शीतवतीं नमाम्यहम् ॥ २॥",
          "iast": "śītōṣṇaduḥkhaśamanīṃ śītavatīṃ namāmyaham ॥ 2॥"
        },
        {
          "n": 42,
          "devanagari": "मन्त्रग्रन्थितसूत्राणां धारणाल्लक्षयोजनम् ।",
          "iast": "mantragranthitasūtrāṇāṃ dhāraṇāllakṣayōjanam ।"
        },
        {
          "n": 43,
          "devanagari": "पथिकानां पालयित्रीं शीतवतीं नमाम्यहम् ॥ ३॥",
          "iast": "pathikānāṃ pālayitrīṃ śītavatīṃ namāmyaham ॥ 3॥"
        },
        {
          "n": 44,
          "devanagari": "श्मशानस्थेन मुनिना या समुच्चारिता पुरा ।",
          "iast": "śmaśānasthēna muninā yā samuchchāritā purā ।"
        },
        {
          "n": 45,
          "devanagari": "ग्रहोपद्रवशान्त्यर्थं शीतवतीं नमाम्यहम् ॥ ४॥",
          "iast": "grahōpadravaśāntyarthaṃ śītavatīṃ namāmyaham ॥ 4॥"
        },
        {
          "n": 46,
          "devanagari": "ग्रहाभिभूतवातानां ग्रन्थिपदविधारिणाम् ।",
          "iast": "grahābhibhūtavātānāṃ granthipadavidhāriṇām ।"
        },
        {
          "n": 47,
          "devanagari": "ग्रहभीतिप्रशमनीं शीतवतीं नमाम्यहम् ॥ ५॥",
          "iast": "grahabhītipraśamanīṃ śītavatīṃ namāmyaham ॥ 5॥"
        },
        {
          "n": 48,
          "devanagari": "श्री महाशीतवतीरक्षादेवीस्तोत्रं सम्पूर्णम् ।",
          "iast": "śrī mahāśītavatīrakṣādēvīstōtraṃ sampūrṇam ।"
        }
      ]
    },
    {
      "label": "Mahāsāhasrapramardinī",
      "lines": [
        {
          "n": 49,
          "devanagari": "ॐ नमः श्रीमहासाहस्रप्रमर्दिन्ये ।",
          "iast": "ōṃ namaḥ śrīmahāsāhasrapramardinyē ।"
        },
        {
          "n": 50,
          "devanagari": "महासाहस्रिके लोके साहस्रहितकारिणाम् ।",
          "iast": "mahāsāhasrikē lōkē sāhasrahitakāriṇām ।"
        },
        {
          "n": 51,
          "devanagari": "सहस्रसत्त्वजननीं नौमि साहस्रमर्दिनीम् ॥ १॥",
          "iast": "sahasrasattvajananīṃ naumi sāhasramardinīm ॥ 1॥"
        },
        {
          "n": 52,
          "devanagari": "सोपद्रवायां वैशाल्यां महोत्सवो यतः सदा ।",
          "iast": "sōpadravāyāṃ vaiśālyāṃ mahōtsavō yataḥ sadā ।"
        },
        {
          "n": 53,
          "devanagari": "महोपसर्गशमनीं नौमि साहस्रमर्दिनीम् ॥ २॥",
          "iast": "mahōpasargaśamanīṃ naumi sāhasramardinīm ॥ 2॥"
        },
        {
          "n": 54,
          "devanagari": "यक्षराक्षसभूतानां दमनीं दुष्टचेतसाम् ।",
          "iast": "yakṣarākṣasabhūtānāṃ damanīṃ duṣṭachētasām ।"
        },
        {
          "n": 55,
          "devanagari": "दुरितोपद्रवहतां नौमि साहस्रमर्दिनीम् ॥ ३॥",
          "iast": "duritōpadravahatāṃ naumi sāhasramardinīm ॥ 3॥"
        },
        {
          "n": 56,
          "devanagari": "यद्धारणीपठनतो रक्षितः शाक्यकेशरी ।",
          "iast": "yaddhāraṇīpaṭhanatō rakṣitaḥ śākyakēśarī ।"
        },
        {
          "n": 57,
          "devanagari": "विषतो विषदिग्धां तां नौमि साहस्रमर्दिनीम् ॥ ४॥",
          "iast": "viṣatō viṣadigdhāṃ tāṃ naumi sāhasramardinīm ॥ 4॥"
        },
        {
          "n": 58,
          "devanagari": "मधुमिश्रितभैषज्यं सर्वरोगनिवारणम् ।",
          "iast": "madhumiśritabhaiṣajyaṃ sarvarōganivāraṇam ।"
        },
        {
          "n": 59,
          "devanagari": "मृतसञ्जीवनं लोके नौमि साहस्रमर्दिनीम् ॥ ५॥",
          "iast": "mṛtasañjīvanaṃ lōkē naumi sāhasramardinīm ॥ 5॥"
        },
        {
          "n": 60,
          "devanagari": "इति श्रीमहासाहस्रमर्दिनीरक्षादेवीस्तोत्रं सम्पूर्णम् ॥",
          "iast": "iti śrīmahāsāhasramardinīrakṣādēvīstōtraṃ sampūrṇam ॥"
        }
      ]
    }
  ]
}
