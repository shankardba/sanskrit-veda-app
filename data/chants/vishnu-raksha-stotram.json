{
  "id": "vishnu-raksha-stotram",
  "language": "sanskrit",
  "title": {
    "devanagari": "सनत्कुमारप्रोक्तं विष्णुरक्षास्तोत्रम्",
    "iast": "Sanatkumāraprōktaṃ Viṣṇurakṣāstōtram"
  },
  "source": {
    "site": "sanskritdocuments.org",
    "devanagari_url": "https://sanskritdocuments.org/doc_vishhnu/sanatkumAraproktaMviShNurakShAstotram.html",
    "note": "Nārada (Bṛhannāradīya) Purāṇa, pūrvabhāga 71.114-127, taught by Sanatkumāra; verse labels keep the Purāṇa's own numbering. IAST generated by scripts/deva_to_iast.py; English translation prepared for this app."
  },
  "colophon": {
    "devanagari": "इति नारदपुराणे पूर्वभागे एकसप्ततितमाध्यायान्तर्गतं सनत्कुमारप्रोक्तं विष्णुरक्षास्तोत्रं समाप्तम् ।",
    "iast": "iti nāradapurāṇē pūrvabhāgē ēkasaptatitamādhyāyāntargataṃ sanatkumāraprōktaṃ viṣṇurakṣāstōtraṃ samāptam ।"
  },
  "sectionUnit": "Verse",
  "sections": [
    {
      "label": "114",
      "lines": [
        {
          "n": 1,
          "devanagari": "अथवा केशवाद्यैस्तु रक्षां कुर्यात्प्रयत्नतः ।",
          "iast": "athavā kēśavādyaistu rakṣāṃ kuryātprayatnataḥ ।"
        },
        {
          "n": 2,
          "devanagari": "केशवः पातु पादौ मे जङ्घे नारायणोऽवतु ॥ ११४॥",
          "iast": "kēśavaḥ pātu pādau mē jaṅghē nārāyaṇō'vatu ॥ 114॥"
        }
      ]
    },
    {
      "label": "115",
      "lines": [
        {
          "n": 3,
          "devanagari": "माधवो मे कटिं पातु गोविन्दो गुह्यमेव च ।",
          "iast": "mādhavō mē kaṭiṃ pātu gōvindō guhyamēva cha ।"
        },
        {
          "n": 4,
          "devanagari": "नाभिं विष्णुश्च मे पातु जठरं मधुसूदनः ॥ ११५॥",
          "iast": "nābhiṃ viṣṇuścha mē pātu jaṭharaṃ madhusūdanaḥ ॥ 115॥"
        }
      ]
    },
    {
      "label": "116",
      "lines": [
        {
          "n": 5,
          "devanagari": "ऊरू त्रिविक्रमः पातु हृदयं पातु मे नरः ।",
          "iast": "ūrū trivikramaḥ pātu hṛdayaṃ pātu mē naraḥ ।"
        },
        {
          "n": 6,
          "devanagari": "श्रीधरः पातु कण्ठं च हृषीकेशो मुखं मम ॥ ११६॥",
          "iast": "śrīdharaḥ pātu kaṇṭhaṃ cha hṛṣīkēśō mukhaṃ mama ॥ 116॥"
        }
      ]
    },
    {
      "label": "117",
      "lines": [
        {
          "n": 7,
          "devanagari": "पद्मनाभः स्तनौ पातु शीर्षं दामोदरोऽवतु ।",
          "iast": "padmanābhaḥ stanau pātu śīrṣaṃ dāmōdarō'vatu ।"
        },
        {
          "n": 8,
          "devanagari": "एवं विन्यस्य चाङ्गेषु जपकाले तु साधकः ॥ ११७॥",
          "iast": "ēvaṃ vinyasya chāṅgēṣu japakālē tu sādhakaḥ ॥ 117॥"
        }
      ]
    },
    {
      "label": "118",
      "lines": [
        {
          "n": 9,
          "devanagari": "निर्भयो जायते भूतवेतालग्रहराक्षसात् ।",
          "iast": "nirbhayō jāyatē bhūtavētālagraharākṣasāt ।"
        },
        {
          "n": 10,
          "devanagari": "पुनर्न्यसेत्प्रयत्नेन ध्यानं कुर्वन्समाहितः ॥ ११८॥",
          "iast": "punarnyasētprayatnēna dhyānaṃ kurvansamāhitaḥ ॥ 118॥"
        }
      ]
    },
    {
      "label": "119",
      "lines": [
        {
          "n": 11,
          "devanagari": "पुरस्तात्केशवः पातु चक्री जाम्बूनदप्रभः ।",
          "iast": "purastātkēśavaḥ pātu chakrī jāmbūnadaprabhaḥ ।"
        },
        {
          "n": 12,
          "devanagari": "पश्चान्नारायणः शङ्खी नीलजीमूतसन्निभः ॥ ११९॥",
          "iast": "paśchānnārāyaṇaḥ śaṅkhī nīlajīmūtasannibhaḥ ॥ 119॥"
        }
      ]
    },
    {
      "label": "120",
      "lines": [
        {
          "n": 13,
          "devanagari": "ऊर्द्ध्वमिन्दीवरश्यामो माधवस्तु गदाधरः ।",
          "iast": "ūrddhvamindīvaraśyāmō mādhavastu gadādharaḥ ।"
        },
        {
          "n": 14,
          "devanagari": "गोविन्दो दक्षिणे पार्श्वे धन्वी चन्द्रप्रभो महान् ॥ १२०॥",
          "iast": "gōvindō dakṣiṇē pārśvē dhanvī chandraprabhō mahān ॥ 120॥"
        }
      ]
    },
    {
      "label": "121",
      "lines": [
        {
          "n": 15,
          "devanagari": "उत्तरे हलधृग्विष्णुः पद्मकिञ्जल्कमसन्निभः ।",
          "iast": "uttarē haladhṛgviṣṇuḥ padmakiñjalkamasannibhaḥ ।"
        },
        {
          "n": 16,
          "devanagari": "आग्नेय्यामरविन्दाक्षो मुसली मधुसूदनः ॥ १२१॥",
          "iast": "āgnēyyāmaravindākṣō musalī madhusūdanaḥ ॥ 121॥"
        }
      ]
    },
    {
      "label": "122",
      "lines": [
        {
          "n": 17,
          "devanagari": "त्रिविक्रमः खड्गपाणिर्नैरृत्यां ज्वलनप्रभः ।",
          "iast": "trivikramaḥ khaḍgapāṇirnairṛtyāṃ jvalanaprabhaḥ ।"
        },
        {
          "n": 18,
          "devanagari": "वायव्यां माधवो वज्री तरुणादित्यसन्निभः ॥ १२२॥",
          "iast": "vāyavyāṃ mādhavō vajrī taruṇādityasannibhaḥ ॥ 122॥"
        }
      ]
    },
    {
      "label": "123",
      "lines": [
        {
          "n": 19,
          "devanagari": "ऐशान्यां पुण्डरीकाक्षः श्रीधरः पट्टिशायुधः ।",
          "iast": "aiśānyāṃ puṇḍarīkākṣaḥ śrīdharaḥ paṭṭiśāyudhaḥ ।"
        },
        {
          "n": 20,
          "devanagari": "विद्युत्प्रभो हृषीकेश ऊर्द्ध्वे पातु समुद्गरः ॥ १२३॥",
          "iast": "vidyutprabhō hṛṣīkēśa ūrddhvē pātu samudgaraḥ ॥ 123॥"
        }
      ]
    },
    {
      "label": "124",
      "lines": [
        {
          "n": 21,
          "devanagari": "अधश्च पद्मनाभो मे सहस्रांशुसमप्रभः ।",
          "iast": "adhaścha padmanābhō mē sahasrāṃśusamaprabhaḥ ।"
        },
        {
          "n": 22,
          "devanagari": "सर्वायुधः सर्वशक्तिः सर्वाद्यःसर्वतोमुखः ॥ १२४॥",
          "iast": "sarvāyudhaḥ sarvaśaktiḥ sarvādyaḥsarvatōmukhaḥ ॥ 124॥"
        }
      ]
    },
    {
      "label": "125",
      "lines": [
        {
          "n": 23,
          "devanagari": "इन्द्रगोपप्रभः पायात्पाशहस्तोऽपराजितः ।",
          "iast": "indragōpaprabhaḥ pāyātpāśahastō'parājitaḥ ।"
        },
        {
          "n": 24,
          "devanagari": "स बाह्याभ्यन्तरे देहमव्याद्दामोदरो हरिः ॥ १२५॥",
          "iast": "sa bāhyābhyantarē dēhamavyāddāmōdarō hariḥ ॥ 125॥"
        }
      ]
    },
    {
      "label": "126",
      "lines": [
        {
          "n": 25,
          "devanagari": "एवं सर्वत्र निश्छिद्रं नामद्वादशपञ्जरम् ।",
          "iast": "ēvaṃ sarvatra niśChidraṃ nāmadvādaśapañjaram ।"
        },
        {
          "n": 26,
          "devanagari": "प्रविष्टोऽहं न मे किञ्चिद्भयमस्ति कदाचन ॥ १२६॥",
          "iast": "praviṣṭō'haṃ na mē kiñchidbhayamasti kadāchana ॥ 126॥"
        }
      ]
    },
    {
      "label": "127",
      "lines": [
        {
          "n": 27,
          "devanagari": "एवं रक्षां विधायाथ दुर्द्धर्षो जायते नरः ।",
          "iast": "ēvaṃ rakṣāṃ vidhāyātha durddharṣō jāyatē naraḥ ।"
        },
        {
          "n": 28,
          "devanagari": "सर्वेषु नृहरेर्मन्त्रवर्गेष्वेवं विधिर्मतः ॥ १२७॥",
          "iast": "sarvēṣu nṛharērmantravargēṣvēvaṃ vidhirmataḥ ॥ 127॥"
        }
      ]
    }
  ]
}
