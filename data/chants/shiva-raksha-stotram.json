{
  "id": "shiva-raksha-stotram",
  "language": "sanskrit",
  "title": {
    "devanagari": "श्रीशिवरक्षास्तोत्रम्",
    "iast": "Śrī Śivarakṣāstōtram"
  },
  "source": {
    "site": "sanskritdocuments.org",
    "devanagari_url": "https://sanskritdocuments.org/doc_shiva/shivaraksha.html",
    "note": "Also called the Abhayaṅkara Kavacham. From sanskritdocuments.org; the opening Gaṇeśa invocation is omitted, and two evident typos in v.3 are corrected (कर्णो सर्पविभूषण → कर्णौ सर्पविभूषणः: the ears are dual like the eyes beside them, and the epithet needs its nominative visarga). IAST generated by scripts/deva_to_iast.py; English translation prepared for this app."
  },
  "colophon": {
    "devanagari": "इति श्रीयाज्ञवल्क्यप्रोक्तं शिवरक्षास्तोत्रं अथवा अभयङ्करकवचं सम्पूर्णम् ॥",
    "iast": "iti śrīyājñavalkyaprōktaṃ śivarakṣāstōtraṃ athavā abhayaṅkarakavachaṃ sampūrṇam ॥"
  },
  "sectionUnit": "",
  "sections": [
    {
      "label": "Viniyoga",
      "lines": [
        {
          "n": 1,
          "devanagari": "अस्य श्रीशिवरक्षास्तोत्रमन्त्रस्य याज्ञवल्क्य ऋषिः ॥",
          "iast": "asya śrīśivarakṣāstōtramantrasya yājñavalkya ṛṣiḥ ॥"
        },
        {
          "n": 2,
          "devanagari": "श्री सदाशिवो देवता ॥ अनुष्टुप् छन्दः ॥",
          "iast": "śrī sadāśivō dēvatā ॥ anuṣṭup Chandaḥ ॥"
        },
        {
          "n": 3,
          "devanagari": "श्रीसदाशिवप्रीत्यर्थं शिवरक्षास्तोत्रजपे विनियोगः ॥",
          "iast": "śrīsadāśivaprītyarthaṃ śivarakṣāstōtrajapē viniyōgaḥ ॥"
        }
      ]
    },
    {
      "label": "Verse 1",
      "lines": [
        {
          "n": 4,
          "devanagari": "चरितं देवदेवस्य महादेवस्य पावनम् ।",
          "iast": "charitaṃ dēvadēvasya mahādēvasya pāvanam ।"
        },
        {
          "n": 5,
          "devanagari": "अपारं परमोदारं चतुर्वर्गस्य साधनम् ॥ १॥",
          "iast": "apāraṃ paramōdāraṃ chaturvargasya sādhanam ॥ 1॥"
        }
      ]
    },
    {
      "label": "Verse 2",
      "lines": [
        {
          "n": 6,
          "devanagari": "गौरीविनायकोपेतं पञ्चवक्त्रं त्रिनेत्रकम् ।",
          "iast": "gaurīvināyakōpētaṃ pañchavaktraṃ trinētrakam ।"
        },
        {
          "n": 7,
          "devanagari": "शिवं ध्यात्वा दशभुजं शिवरक्षां पठेन्नरः ॥ २॥",
          "iast": "śivaṃ dhyātvā daśabhujaṃ śivarakṣāṃ paṭhēnnaraḥ ॥ 2॥"
        }
      ]
    },
    {
      "label": "Verse 3",
      "lines": [
        {
          "n": 8,
          "devanagari": "गंगाधरः शिरः पातु भालं अर्धेन्दुशेखरः ।",
          "iast": "gaṃgādharaḥ śiraḥ pātu bhālaṃ ardhēnduśēkharaḥ ।"
        },
        {
          "n": 9,
          "devanagari": "नयने मदनध्वंसी कर्णौ सर्पविभूषणः ॥ ३॥",
          "iast": "nayanē madanadhvaṃsī karṇau sarpavibhūṣaṇaḥ ॥ 3॥"
        }
      ]
    },
    {
      "label": "Verse 4",
      "lines": [
        {
          "n": 10,
          "devanagari": "घ्राणं पातु पुरारातिः मुखं पातु जगत्पतिः ।",
          "iast": "ghrāṇaṃ pātu purārātiḥ mukhaṃ pātu jagatpatiḥ ।"
        },
        {
          "n": 11,
          "devanagari": "जिह्वां वागीश्वरः पातु कंधरां शितिकंधरः ॥ ४॥",
          "iast": "jihvāṃ vāgīśvaraḥ pātu kaṃdharāṃ śitikaṃdharaḥ ॥ 4॥"
        }
      ]
    },
    {
      "label": "Verse 5",
      "lines": [
        {
          "n": 12,
          "devanagari": "श्रीकण्ठः पातु मे कण्ठं स्कन्धौ विश्वधुरन्धरः ।",
          "iast": "śrīkaṇṭhaḥ pātu mē kaṇṭhaṃ skandhau viśvadhurandharaḥ ।"
        },
        {
          "n": 13,
          "devanagari": "भुजौ भूभारसंहर्ता करौ पातु पिनाकधृक् ॥ ५॥",
          "iast": "bhujau bhūbhārasaṃhartā karau pātu pinākadhṛk ॥ 5॥"
        }
      ]
    },
    {
      "label": "Verse 6",
      "lines": [
        {
          "n": 14,
          "devanagari": "हृदयं शंकरः पातु जठरं गिरिजापतिः ।",
          "iast": "hṛdayaṃ śaṃkaraḥ pātu jaṭharaṃ girijāpatiḥ ।"
        },
        {
          "n": 15,
          "devanagari": "नाभिं मृत्युञ्जयः पातु कटी व्याघ्राजिनाम्बरः ॥ ६॥",
          "iast": "nābhiṃ mṛtyuñjayaḥ pātu kaṭī vyāghrājināmbaraḥ ॥ 6॥"
        }
      ]
    },
    {
      "label": "Verse 7",
      "lines": [
        {
          "n": 16,
          "devanagari": "सक्थिनी पातु दीनार्तशरणागतवत्सलः ।",
          "iast": "sakthinī pātu dīnārtaśaraṇāgatavatsalaḥ ।"
        },
        {
          "n": 17,
          "devanagari": "उरू महेश्वरः पातु जानुनी जगदीश्वरः ॥ ७॥",
          "iast": "urū mahēśvaraḥ pātu jānunī jagadīśvaraḥ ॥ 7॥"
        }
      ]
    },
    {
      "label": "Verse 8",
      "lines": [
        {
          "n": 18,
          "devanagari": "जङ्घे पातु जगत्कर्ता गुल्फौ पातु गणाधिपः ।",
          "iast": "jaṅghē pātu jagatkartā gulphau pātu gaṇādhipaḥ ।"
        },
        {
          "n": 19,
          "devanagari": "चरणौ करुणासिंधुः सर्वाङ्गानि सदाशिवः ॥ ८॥",
          "iast": "charaṇau karuṇāsiṃdhuḥ sarvāṅgāni sadāśivaḥ ॥ 8॥"
        }
      ]
    },
    {
      "label": "Verse 9",
      "lines": [
        {
          "n": 20,
          "devanagari": "एतां शिवबलोपेतां रक्षां यः सुकृती पठेत् ।",
          "iast": "ētāṃ śivabalōpētāṃ rakṣāṃ yaḥ sukṛtī paṭhēt ।"
        },
        {
          "n": 21,
          "devanagari": "स भुक्त्वा सकलान्कामान् शिवसायुज्यमाप्नुयात् ॥ ९॥",
          "iast": "sa bhuktvā sakalānkāmān śivasāyujyamāpnuyāt ॥ 9॥"
        }
      ]
    },
    {
      "label": "Verse 10",
      "lines": [
        {
          "n": 22,
          "devanagari": "ग्रहभूतपिशाचाद्यास्त्रैलोक्ये विचरन्ति ये ।",
          "iast": "grahabhūtapiśāchādyāstrailōkyē vicharanti yē ।"
        },
        {
          "n": 23,
          "devanagari": "दूरादाशु पलायन्ते शिवनामाभिरक्षणात् ॥ १० ॥",
          "iast": "dūrādāśu palāyantē śivanāmābhirakṣaṇāt ॥ 10 ॥"
        }
      ]
    },
    {
      "label": "Verse 11",
      "lines": [
        {
          "n": 24,
          "devanagari": "अभयङ्करनामेदं कवचं पार्वतीपतेः ।",
          "iast": "abhayaṅkaranāmēdaṃ kavachaṃ pārvatīpatēḥ ।"
        },
        {
          "n": 25,
          "devanagari": "भक्त्या बिभर्ति यः कण्ठे तस्य वश्यं जगत्त्रयम् ॥ ११॥",
          "iast": "bhaktyā bibharti yaḥ kaṇṭhē tasya vaśyaṃ jagattrayam ॥ 11॥"
        }
      ]
    },
    {
      "label": "Verse 12",
      "lines": [
        {
          "n": 26,
          "devanagari": "इमां नारायणः स्वप्ने शिवरक्षां यथाऽऽदिशत् ।",
          "iast": "imāṃ nārāyaṇaḥ svapnē śivarakṣāṃ yathā''diśat ।"
        },
        {
          "n": 27,
          "devanagari": "प्रातरुत्थाय योगीन्द्रो याज्ञवल्क्यः तथाऽलिखत् ॥ १२॥",
          "iast": "prātarutthāya yōgīndrō yājñavalkyaḥ tathā'likhat ॥ 12॥"
        }
      ]
    }
  ]
}
