{
  "id": "kanninun-cirutampu",
  "language": "tamil",
  "title": {
    "devanagari": "கண்ணிநுண் சிறுத்தாம்பு",
    "iast": "kaNNinuN chiRuththAmbu"
  },
  "source": {
    "site": "divyaprabandham.koyil.org",
    "devanagari_url": "https://divyaprabandham.koyil.org/index.php/2020/03/kanninun-chiruth-thambu-tamil-simple/",
    "iast_url": "https://divyaprabandham.koyil.org/index.php/2020/04/kanninun-chiruth-thambu-simple/"
  },
  "colophon": {
    "devanagari": "மதுரகவி ஆழ்வார் அருளிச்செய்த கண்ணிநுண் சிறுத்தாம்பு",
    "iast": "Composed by Madhurakavi Alvar in devotion to his guru Nammalvar. Famously, when the Naalayira Divya Prabandham had been lost, the scholar Nathamuni recited these eleven verses 12,000 times to recover it."
  },
  "sectionUnit": "",
  "sections": [
    {
      "label": "1",
      "lines": [
        {
          "n": 1,
          "devanagari": "கண்ணி நுண் சிறுத்தாம்பினால் கட்டுண்ணப்",
          "iast": "kaNNi nuN chiRuththAmbinAl kattuNNap"
        },
        {
          "n": 2,
          "devanagari": "பண்ணிய பெரு மாயன் என் அப்பனில்",
          "iast": "paNNiya peru mAyan en appanil"
        },
        {
          "n": 3,
          "devanagari": "நண்ணித் தென் குருகூர் நம்பி என்றக்கால்",
          "iast": "naNNith then kurugUr nambi enRakkAl"
        },
        {
          "n": 4,
          "devanagari": "அண்ணிக்கும் அமுது ஊறும் என் நாவுக்கே",
          "iast": "aNNikkum amudhURum en nAvukkE"
        }
      ]
    },
    {
      "label": "2",
      "lines": [
        {
          "n": 1,
          "devanagari": "நாவினால் நவிற்று இன்பம் எய்தினேன்",
          "iast": "nAvinAl naviRRu inbam eydhinEn"
        },
        {
          "n": 2,
          "devanagari": "மேவினேன் அவன் பொன்னடி மெய்ம்மையே",
          "iast": "mEvinEn avan ponnadi meymmaiyE"
        },
        {
          "n": 3,
          "devanagari": "தேவு மற்று அறியேன் குருகூர் நம்பி",
          "iast": "dhEvu maRRu aRiyEn kurugUr nambi"
        },
        {
          "n": 4,
          "devanagari": "பாவின் இன்னிசை பாடித் திரிவனே",
          "iast": "pAvin innisai pAdith thirivanE"
        }
      ]
    },
    {
      "label": "3",
      "lines": [
        {
          "n": 1,
          "devanagari": "திரிதந்து ஆகிலும் தேவபிரான் உடைக்",
          "iast": "thiri thandhAgilum dhEvapirAn udai"
        },
        {
          "n": 2,
          "devanagari": "கரிய கோலத் திருவுருக் காண்பன் நான்",
          "iast": "kariya kOlath thiru uruk kANban nAn"
        },
        {
          "n": 3,
          "devanagari": "பெரிய வண் குருகூர் நகர் நம்பிக்கு ஆள்",
          "iast": "periya vaN kurugUr nagar nambikku AL"
        },
        {
          "n": 4,
          "devanagari": "உரியனாய் அடியேன் பெற்ற நன்மையே",
          "iast": "uriyanAy adiyEn peRRa nanmaiyE"
        }
      ]
    },
    {
      "label": "4",
      "lines": [
        {
          "n": 1,
          "devanagari": "நன்மையால் மிக்க நான்மறையாளர்கள்",
          "iast": "nanmaiyAl mikka nAnmaRaiyALargaL"
        },
        {
          "n": 2,
          "devanagari": "புன்மை ஆகக் கருதுவர் ஆதலில்",
          "iast": "punmai Agak karudhuvar Adhalil"
        },
        {
          "n": 3,
          "devanagari": "அன்னையாய் அத்தனாய் என்னை ஆண்டிடும்",
          "iast": "annaiyAy aththanAy ennai ANdidum"
        },
        {
          "n": 4,
          "devanagari": "தன்மையான் சடகோபன் என் நம்பியே",
          "iast": "thanmaiyAn sadagOpan en nambiyE"
        }
      ]
    },
    {
      "label": "5",
      "lines": [
        {
          "n": 1,
          "devanagari": "நம்பினேன் பிறர் நன்பொருள் தன்னையும்",
          "iast": "nambinEn piRar nanporuL thannaiyum"
        },
        {
          "n": 2,
          "devanagari": "நம்பினேன் மடவாரையும் முன்னெலாம்",
          "iast": "nambinEn madavAraiyum munnelAm"
        },
        {
          "n": 3,
          "devanagari": "செம்பொன் மாடத் திருக் குருகூர் நம்பிக்கு",
          "iast": "sem pon mAdath thukkurugUr nambikku"
        },
        {
          "n": 4,
          "devanagari": "அன்பனாய் அடியேன் சதிர்த்தேன் இன்றே",
          "iast": "anbanAy adiyEn sadhirththEn inRE"
        }
      ]
    },
    {
      "label": "6",
      "lines": [
        {
          "n": 1,
          "devanagari": "இன்று தொட்டும் எழுமையும் எம்பிரான்",
          "iast": "inRu thottum ezhumaiyum empirAn"
        },
        {
          "n": 2,
          "devanagari": "நின்று தன் புகழ் ஏத்த அருளினான்",
          "iast": "ninRu than pugazh Eththa aruLinAn"
        },
        {
          "n": 3,
          "devanagari": "குன்ற மாடத் திருக் குருகூர் நம்பி",
          "iast": "kunRa mAdath thirukkurugUr nambi"
        },
        {
          "n": 4,
          "devanagari": "என்றும் என்னை இகழ்வு இலன் காண்மினே",
          "iast": "enRum ennai igazhvu ilan kANminE"
        }
      ]
    },
    {
      "label": "7",
      "lines": [
        {
          "n": 1,
          "devanagari": "கண்டு கொண்டு என்னைக் காரிமாறப் பிரான்",
          "iast": "kaNdu koNdu ennaik kArimARap pirAn"
        },
        {
          "n": 2,
          "devanagari": "பண்டை வல் வினை பாற்றி அருளினான்",
          "iast": "paNdai valvinai pARRi aruLinAn"
        },
        {
          "n": 3,
          "devanagari": "எண் திசையும் அறிய இயம்புகேன்",
          "iast": "eN thisaiyum aRiya iyambugEn"
        },
        {
          "n": 4,
          "devanagari": "ஒண் தமிழ்ச் சடகோபன் அருளையே",
          "iast": "oN thamizh sadagOpan aruLaiyE"
        }
      ]
    },
    {
      "label": "8",
      "lines": [
        {
          "n": 1,
          "devanagari": "அருள் கொண்டாடும் அடியவர் இன்புற",
          "iast": "aruL koNdAdum adiyavar inbuRa"
        },
        {
          "n": 2,
          "devanagari": "அருளினான் அவ்வருமறையின் பொருள்",
          "iast": "aruLinAn avvarumaRaiyin poruL"
        },
        {
          "n": 3,
          "devanagari": "அருள்கொண்டு ஆயிரம் இன் தமிழ் பாடினான்",
          "iast": "aruL koNdu Ayiram in thamizh pAdinAn"
        },
        {
          "n": 4,
          "devanagari": "அருள் கண்டீர் இவ் உலகினில் மிக்கதே",
          "iast": "aruL kaNdIr iv vulaginil mikkadhE"
        }
      ]
    },
    {
      "label": "9",
      "lines": [
        {
          "n": 1,
          "devanagari": "மிக்க வேதியர் வேதத்தின் உட்பொருள்",
          "iast": "mikka vEdhiyar vEdhaththin utporuL"
        },
        {
          "n": 2,
          "devanagari": "நிற்கப் பாடி என் நெஞ்சுள் நிறுத்தினான்",
          "iast": "niRkap pAdi en nenjuL niRuththinAn"
        },
        {
          "n": 3,
          "devanagari": "தக்க சீர்ச் சடகோபன் என் நம்பிக்கு ஆட்",
          "iast": "thakka sIrch chatakOpan en nambikku At"
        },
        {
          "n": 4,
          "devanagari": "புக்க காதல் அடிமைப் பயன் அன்றே",
          "iast": "pukka kAdhal adimaip payan anRE"
        }
      ]
    },
    {
      "label": "10",
      "lines": [
        {
          "n": 1,
          "devanagari": "பயன் அன்று ஆகிலும் பாங்கு அல்லர் ஆகிலும்",
          "iast": "payan anRu Agilum pAngu allar Agilum"
        },
        {
          "n": 2,
          "devanagari": "செயல் நன்றாகத் திருத்திப் பணி கொள்வான்",
          "iast": "seyal nanRAgath thiruththip paNi koLvAn"
        },
        {
          "n": 3,
          "devanagari": "குயில் நின்று ஆர் பொழில் சூழ் குருகூர் நம்பி",
          "iast": "kuyil ninRu Ar pozhil sUzh kurugUr nambi"
        },
        {
          "n": 4,
          "devanagari": "முயல்கின்றேன் உன்தன் மொய் கழற்கு அன்பையே",
          "iast": "muyalginREn un than moy kazhaRku anbaiyE"
        }
      ]
    },
    {
      "label": "11",
      "lines": [
        {
          "n": 1,
          "devanagari": "அன்பன் தன்னை அடைந்தவர்கட்கு எல்லாம்",
          "iast": "anban thannai adaindhavargatku ellAm"
        },
        {
          "n": 2,
          "devanagari": "அன்பன் தென் குருகூர் நகர் நம்பிக்கு",
          "iast": "anban then kurugUr nagar nambikku"
        },
        {
          "n": 3,
          "devanagari": "அன்பனாய் மதுரகவி சொன்ன சொல்",
          "iast": "anbanAy madhurakavi sonna sol"
        },
        {
          "n": 4,
          "devanagari": "நம்புவார் பதி வைகுந்தம் காண்மினே",
          "iast": "nambuvAr padhi vaikundham kANminE"
        }
      ]
    }
  ]
}