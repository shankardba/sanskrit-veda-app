{
  "id": "raghavendra-raksha-kavacham",
  "language": "sanskrit",
  "title": {
    "devanagari": "श्रीराघवेन्द्ररक्षाकवचम्",
    "iast": "Śrī Rāghavēndrarakṣākavacham"
  },
  "source": {
    "site": "sanskritdocuments.org",
    "devanagari_url": "https://sanskritdocuments.org/doc_deities_misc/rAghavendrarakShAkavacham.html",
    "note": "Composed by Kṛṣṇāvadhūta Paṇḍita, the fifth chapter of his Śrī Rāghavendra Tantra. From sanskritdocuments.org, with five evident typos corrected: गुल्भौ → गुल्फौ (ankles), पश्चाश्च → पश्चाच्च, स्थिवासकारी → स्थिरवासकारी, राघवेनद्रार्य → राघवेन्द्रार्य, असद्भाधाहरं → असद्बाधाहरं. IAST generated by scripts/deva_to_iast.py; English translation prepared for this app."
  },
  "colophon": {
    "devanagari": "इति श्रीमत्कृष्णावधूतपण्डितकृतौ श्रीराघवेन्द्रतन्त्रे श्रीराघवेन्द्ररक्षाकवचं नाम पञ्चमपटलः सम्पूर्णः ।",
    "iast": "iti śrīmatkṛṣṇāvadhūtapaṇḍitakṛtau śrīrāghavēndratantrē śrīrāghavēndrarakṣākavachaṃ nāma pañchamapaṭalaḥ sampūrṇaḥ ।"
  },
  "sectionUnit": "Verse",
  "sections": [
    {
      "label": "1",
      "lines": [
        {
          "n": 1,
          "devanagari": "अथ श्रीराघवेन्द्रार्यरक्षाकवचमद्भुतम् ।",
          "iast": "atha śrīrāghavēndrāryarakṣākavachamadbhutam ।"
        },
        {
          "n": 2,
          "devanagari": "वक्ष्यामि दंशितो येन क्षेमवान् विजयी भवेत् ॥ १॥",
          "iast": "vakṣyāmi daṃśitō yēna kṣēmavān vijayī bhavēt ॥ 1॥"
        }
      ]
    },
    {
      "label": "2",
      "lines": [
        {
          "n": 3,
          "devanagari": "गुरुराजप्रेमपुत्रः तत्प्रसादपुरस्कृतः ।",
          "iast": "gururājaprēmaputraḥ tatprasādapuraskṛtaḥ ।"
        },
        {
          "n": 4,
          "devanagari": "कृष्णावधूतनामाऽहं तस्य सन्निधिकारकम् ॥ २॥",
          "iast": "kṛṣṇāvadhūtanāmā'haṃ tasya sannidhikārakam ॥ 2॥"
        }
      ]
    },
    {
      "label": "3",
      "lines": [
        {
          "n": 5,
          "devanagari": "छन्दः त्रिष्टुप् समाख्यातं देवता गुरुराट् स्मृतः ।",
          "iast": "Chandaḥ triṣṭup samākhyātaṃ dēvatā gururāṭ smṛtaḥ ।"
        },
        {
          "n": 6,
          "devanagari": "मन्त्रन्यासः प्रकर्तव्यो ध्यानं वक्ष्यामि सद्गुरोः ॥ ३॥",
          "iast": "mantranyāsaḥ prakartavyō dhyānaṃ vakṣyāmi sadgurōḥ ॥ 3॥"
        }
      ]
    },
    {
      "label": "4",
      "lines": [
        {
          "n": 7,
          "devanagari": "करधृतलगुढं धृताक्षमालं दरविवृतेक्षणमम्बुजासनस्थम् ।",
          "iast": "karadhṛtalaguḍhaṃ dhṛtākṣamālaṃ daravivṛtēkṣaṇamambujāsanastham ।"
        },
        {
          "n": 8,
          "devanagari": "दरचलदधरं गुरुं दधानं वरमभयप्रणतेष्टदं स्मरामि ॥ ४॥",
          "iast": "darachaladadharaṃ guruṃ dadhānaṃ varamabhayapraṇatēṣṭadaṃ smarāmi ॥ 4॥"
        }
      ]
    },
    {
      "label": "5",
      "lines": [
        {
          "n": 9,
          "devanagari": "ॐ पूर्वेऽत्र मां रक्षतु राघवेन्द्रो",
          "iast": "ōṃ pūrvē'tra māṃ rakṣatu rāghavēndrō"
        },
        {
          "n": 10,
          "devanagari": "मां दक्षिणेऽव्याद्घनपापहन्ता ।",
          "iast": "māṃ dakṣiṇē'vyādghanapāpahantā ।"
        },
        {
          "n": 11,
          "devanagari": "अव्यात्प्रतीच्यामभयप्रदाता",
          "iast": "avyātpratīchyāmabhayapradātā"
        },
        {
          "n": 12,
          "devanagari": "पातूत्तरस्यां दिशि शान्तिकर्ता ॥ ५॥",
          "iast": "pātūttarasyāṃ diśi śāntikartā ॥ 5॥"
        }
      ]
    },
    {
      "label": "6",
      "lines": [
        {
          "n": 13,
          "devanagari": "आग्नेयभागेऽवतु दिव्यतेजाः नैऋत्यभागेऽवतु दुष्टहन्ता ।",
          "iast": "āgnēyabhāgē'vatu divyatējāḥ naiṛtyabhāgē'vatu duṣṭahantā ।"
        },
        {
          "n": 14,
          "devanagari": "वायुव्यभागेऽवतु वज्रकायो मामीशभागेऽवतु सिद्धिदाता ॥ ६॥",
          "iast": "vāyuvyabhāgē'vatu vajrakāyō māmīśabhāgē'vatu siddhidātā ॥ 6॥"
        }
      ]
    },
    {
      "label": "7",
      "lines": [
        {
          "n": 15,
          "devanagari": "पायात् शिखां मे श्रितरामपादः",
          "iast": "pāyāt śikhāṃ mē śritarāmapādaḥ"
        },
        {
          "n": 16,
          "devanagari": "पायात् शिरो मे शशिशीतवृत्तिः ।",
          "iast": "pāyāt śirō mē śaśiśītavṛttiḥ ।"
        },
        {
          "n": 17,
          "devanagari": "भालं ममाव्याद्दुरदृष्टहर्ता",
          "iast": "bhālaṃ mamāvyādduradṛṣṭahartā"
        },
        {
          "n": 18,
          "devanagari": "भ्रुवौ ममाव्याद्भवतापहर्ता ॥ ७॥",
          "iast": "bhruvau mamāvyādbhavatāpahartā ॥ 7॥"
        }
      ]
    },
    {
      "label": "8",
      "lines": [
        {
          "n": 19,
          "devanagari": "कूर्चं ममाव्यात् कुलशीलशाली",
          "iast": "kūrchaṃ mamāvyāt kulaśīlaśālī"
        },
        {
          "n": 20,
          "devanagari": "नेत्रे ममाव्यान्नयनप्रदाता ।",
          "iast": "nētrē mamāvyānnayanapradātā ।"
        },
        {
          "n": 21,
          "devanagari": "कर्णौ ममाव्याद्बधिरत्वहारी",
          "iast": "karṇau mamāvyādbadhiratvahārī"
        },
        {
          "n": 22,
          "devanagari": "गण्डौ ममाव्याद्गरदोषहारी ॥ ८॥",
          "iast": "gaṇḍau mamāvyādgaradōṣahārī ॥ 8॥"
        }
      ]
    },
    {
      "label": "9",
      "lines": [
        {
          "n": 23,
          "devanagari": "ओष्ठाधरौ मेऽवतु कष्टहारी",
          "iast": "ōṣṭhādharau mē'vatu kaṣṭahārī"
        },
        {
          "n": 24,
          "devanagari": "नासां सदा मेऽवतु नादकारी ।",
          "iast": "nāsāṃ sadā mē'vatu nādakārī ।"
        },
        {
          "n": 25,
          "devanagari": "जिह्वां सदा रक्षतु वाक्प्रदाता",
          "iast": "jihvāṃ sadā rakṣatu vākpradātā"
        },
        {
          "n": 26,
          "devanagari": "दन्तान् सदा रक्षतु भक्ष्यदाता ॥ ९॥",
          "iast": "dantān sadā rakṣatu bhakṣyadātā ॥ 9॥"
        }
      ]
    },
    {
      "label": "10",
      "lines": [
        {
          "n": 27,
          "devanagari": "पायात् सदा मे चिबुकं यतीशः ।",
          "iast": "pāyāt sadā mē chibukaṃ yatīśaḥ ।"
        },
        {
          "n": 28,
          "devanagari": "पायात् सदा मे वदनं व्रतीशः ।",
          "iast": "pāyāt sadā mē vadanaṃ vratīśaḥ ।"
        },
        {
          "n": 29,
          "devanagari": "कण्ठं नु कण्ठीरवभक्तवर्यः",
          "iast": "kaṇṭhaṃ nu kaṇṭhīravabhaktavaryaḥ"
        },
        {
          "n": 30,
          "devanagari": "स्कन्धौ ममाव्याद्धृतपुष्पमालः ॥ १०॥",
          "iast": "skandhau mamāvyāddhṛtapuṣpamālaḥ ॥ 10॥"
        }
      ]
    },
    {
      "label": "11",
      "lines": [
        {
          "n": 31,
          "devanagari": "भुजौ ममाव्यादिह बाहुदाता",
          "iast": "bhujau mamāvyādiha bāhudātā"
        },
        {
          "n": 32,
          "devanagari": "करौ ममाव्याद्वरदानशूरः ।",
          "iast": "karau mamāvyādvaradānaśūraḥ ।"
        },
        {
          "n": 33,
          "devanagari": "हस्ताङ्गुलीन् मे मनुजापकोऽव्यात्",
          "iast": "hastāṅgulīn mē manujāpakō'vyāt"
        },
        {
          "n": 34,
          "devanagari": "वक्षो ममाव्याद्घनसंशयच्छित् ॥ ११॥",
          "iast": "vakṣō mamāvyādghanasaṃśayachChit ॥ 11॥"
        }
      ]
    },
    {
      "label": "12",
      "lines": [
        {
          "n": 35,
          "devanagari": "कुक्षिं ममाव्यादयमामयघ्नः",
          "iast": "kukṣiṃ mamāvyādayamāmayaghnaḥ"
        },
        {
          "n": 36,
          "devanagari": "पार्श्वे ममाव्याद्भवभीतिहर्ता ।",
          "iast": "pārśvē mamāvyādbhavabhītihartā ।"
        },
        {
          "n": 37,
          "devanagari": "साहाय्यकर्ता मम पातु पृष्ठं",
          "iast": "sāhāyyakartā mama pātu pṛṣṭhaṃ"
        },
        {
          "n": 38,
          "devanagari": "कटिं सदा मे कनकाम्बरोऽव्यात् ॥ १२॥",
          "iast": "kaṭiṃ sadā mē kanakāmbarō'vyāt ॥ 12॥"
        }
      ]
    },
    {
      "label": "13",
      "lines": [
        {
          "n": 39,
          "devanagari": "मेहामयघ्नोऽवतु मे तु गुह्यं",
          "iast": "mēhāmayaghnō'vatu mē tu guhyaṃ"
        },
        {
          "n": 40,
          "devanagari": "ऊरू सदा मेऽवतु वेगशीलः ।",
          "iast": "ūrū sadā mē'vatu vēgaśīlaḥ ।"
        },
        {
          "n": 41,
          "devanagari": "मौनव्रती मेऽवतु जानुनी च",
          "iast": "maunavratī mē'vatu jānunī cha"
        },
        {
          "n": 42,
          "devanagari": "जङ्घे ममाव्याज्जवनत्वदायी ॥ १३॥",
          "iast": "jaṅghē mamāvyājjavanatvadāyī ॥ 13॥"
        }
      ]
    },
    {
      "label": "14",
      "lines": [
        {
          "n": 43,
          "devanagari": "गुल्फौ ममाव्याद्गुणवर्णनीयः",
          "iast": "gulphau mamāvyādguṇavarṇanīyaḥ"
        },
        {
          "n": 44,
          "devanagari": "पादौ ममाव्यात्परपीडितारिः ।",
          "iast": "pādau mamāvyātparapīḍitāriḥ ।"
        },
        {
          "n": 45,
          "devanagari": "यद्यन्ममाङ्गं न मयोक्तमत्र",
          "iast": "yadyanmamāṅgaṃ na mayōktamatra"
        },
        {
          "n": 46,
          "devanagari": "तत्तत्समस्तं च दयालुरव्यात् ॥ १४॥",
          "iast": "tattatsamastaṃ cha dayāluravyāt ॥ 14॥"
        }
      ]
    },
    {
      "label": "15",
      "lines": [
        {
          "n": 47,
          "devanagari": "पितॄंश्च पत्नींश्च सुतांश्च बन्धून्",
          "iast": "pitṝṃścha patnīṃścha sutāṃścha bandhūn"
        },
        {
          "n": 48,
          "devanagari": "पौत्रादिकान्मे सुतवत्सलोऽव्यात् ।",
          "iast": "pautrādikānmē sutavatsalō'vyāt ।"
        },
        {
          "n": 49,
          "devanagari": "व्याघ्राऽहिभल्लूकवराहदन्ती",
          "iast": "vyāghrā'hibhallūkavarāhadantī"
        },
        {
          "n": 50,
          "devanagari": "लुलायसिंहांश्च सृगाल चोरान् ॥ १५॥",
          "iast": "lulāyasiṃhāṃścha sṛgāla chōrān ॥ 15॥"
        }
      ]
    },
    {
      "label": "16",
      "lines": [
        {
          "n": 51,
          "devanagari": "हत्वा च दुष्टान् कृमिवृश्चिकाण्ड-",
          "iast": "hatvā cha duṣṭān kṛmivṛśchikāṇḍa-"
        },
        {
          "n": 52,
          "devanagari": "जातान् ममाव्याद्गुरुराजदण्डः ।",
          "iast": "jātān mamāvyādgururājadaṇḍaḥ ।"
        },
        {
          "n": 53,
          "devanagari": "भिन्द्यात्पिशाचासुरयक्षरक्षो",
          "iast": "bhindyātpiśāchāsurayakṣarakṣō"
        },
        {
          "n": 54,
          "devanagari": "भूतग्रहादीन् गुरुपादरेणुः ॥ १६॥",
          "iast": "bhūtagrahādīn gurupādarēṇuḥ ॥ 16॥"
        }
      ]
    },
    {
      "label": "17",
      "lines": [
        {
          "n": 55,
          "devanagari": "अग्न्यम्बुशैलाशनिराजशत्रु-",
          "iast": "agnyambuśailāśanirājaśatru-"
        },
        {
          "n": 56,
          "devanagari": "विषादितोऽव्याद्गुरुपादतीर्थम् ।",
          "iast": "viṣāditō'vyādgurupādatīrtham ।"
        },
        {
          "n": 57,
          "devanagari": "कुष्ठज्वरार्शःक्षयमुख्यरोगान्",
          "iast": "kuṣṭhajvarārśaḥkṣayamukhyarōgān"
        },
        {
          "n": 58,
          "devanagari": "विनाशयित्वाऽवतु मृत्तिका सा ॥ १७॥",
          "iast": "vināśayitvā'vatu mṛttikā sā ॥ 17॥"
        }
      ]
    },
    {
      "label": "18",
      "lines": [
        {
          "n": 59,
          "devanagari": "धान्यं धनं भूषणवस्त्रगेह-",
          "iast": "dhānyaṃ dhanaṃ bhūṣaṇavastragēha-"
        },
        {
          "n": 60,
          "devanagari": "धैर्यं ममाव्याद्गुरुराघवेन्द्रः ।",
          "iast": "dhairyaṃ mamāvyādgururāghavēndraḥ ।"
        },
        {
          "n": 61,
          "devanagari": "राजारिनारीनरवश्यसिद्धिं",
          "iast": "rājārinārīnaravaśyasiddhiṃ"
        },
        {
          "n": 62,
          "devanagari": "मित्रादिकप्रेमकवित्वविद्याः ॥ १८॥",
          "iast": "mitrādikaprēmakavitvavidyāḥ ॥ 18॥"
        }
      ]
    },
    {
      "label": "19",
      "lines": [
        {
          "n": 63,
          "devanagari": "सर्वानुकूल्यं सकलार्थसिद्धिं",
          "iast": "sarvānukūlyaṃ sakalārthasiddhiṃ"
        },
        {
          "n": 64,
          "devanagari": "दधातु मे सिद्धगणाग्रगण्यः ।",
          "iast": "dadhātu mē siddhagaṇāgragaṇyaḥ ।"
        },
        {
          "n": 65,
          "devanagari": "ज्ञानं सदाचारमुदारभावं",
          "iast": "jñānaṃ sadāchāramudārabhāvaṃ"
        },
        {
          "n": 66,
          "devanagari": "चित्तेन्द्रियादीनि च पातु सूज्ञः ॥ १९॥",
          "iast": "chittēndriyādīni cha pātu sūjñaḥ ॥ 19॥"
        }
      ]
    },
    {
      "label": "20",
      "lines": [
        {
          "n": 67,
          "devanagari": "धर्मानुकूल्यं कृतपुण्यकर्म",
          "iast": "dharmānukūlyaṃ kṛtapuṇyakarma"
        },
        {
          "n": 68,
          "devanagari": "विवेकमित्यादि पिता ममाव्यात् ।",
          "iast": "vivēkamityādi pitā mamāvyāt ।"
        },
        {
          "n": 69,
          "devanagari": "सङ्कल्पसिद्धिं मम वाक्यसिद्धिं",
          "iast": "saṅkalpasiddhiṃ mama vākyasiddhiṃ"
        },
        {
          "n": 70,
          "devanagari": "जयं च सर्वत्र ददात्वभीष्टः ॥ २०॥",
          "iast": "jayaṃ cha sarvatra dadātvabhīṣṭaḥ ॥ 20॥"
        }
      ]
    },
    {
      "label": "21",
      "lines": [
        {
          "n": 71,
          "devanagari": "पुरश्च मेऽव्याद्वरदानकारी",
          "iast": "puraścha mē'vyādvaradānakārī"
        },
        {
          "n": 72,
          "devanagari": "पश्चाच्च मेऽव्याद्बलदानकारी ।",
          "iast": "paśchāchcha mē'vyādbaladānakārī ।"
        },
        {
          "n": 73,
          "devanagari": "ऊर्ध्वं ममाऽव्यात्परितापहारी",
          "iast": "ūrdhvaṃ mamā'vyātparitāpahārī"
        },
        {
          "n": 74,
          "devanagari": "अधश्च मेऽव्यात् स्थिरवासकारी ॥ २१॥",
          "iast": "adhaścha mē'vyāt sthiravāsakārī ॥ 21॥"
        }
      ]
    },
    {
      "label": "22",
      "lines": [
        {
          "n": 75,
          "devanagari": "दिवा प्रभाते निशि च प्रदोषे",
          "iast": "divā prabhātē niśi cha pradōṣē"
        },
        {
          "n": 76,
          "devanagari": "मध्यन्दिनेऽव्यान्मम जागरूकः ।",
          "iast": "madhyandinē'vyānmama jāgarūkaḥ ।"
        },
        {
          "n": 77,
          "devanagari": "सर्वेषु कार्येषु च सर्वदा मां",
          "iast": "sarvēṣu kāryēṣu cha sarvadā māṃ"
        },
        {
          "n": 78,
          "devanagari": "पायाद्गुरुर्मत्कृतसन्निधानः ॥ २२॥",
          "iast": "pāyādgururmatkṛtasannidhānaḥ ॥ 22॥"
        }
      ]
    },
    {
      "label": "23",
      "lines": [
        {
          "n": 79,
          "devanagari": "इदं श्रीराघवेन्द्रार्यकवचं रक्षकः परम् ।",
          "iast": "idaṃ śrīrāghavēndrāryakavachaṃ rakṣakaḥ param ।"
        },
        {
          "n": 80,
          "devanagari": "त्रिकालं वा द्विकालं वा सकृद्वा पठितां दिनम् ॥ २३॥",
          "iast": "trikālaṃ vā dvikālaṃ vā sakṛdvā paṭhitāṃ dinam ॥ 23॥"
        }
      ]
    },
    {
      "label": "24",
      "lines": [
        {
          "n": 81,
          "devanagari": "कुष्ठादि रोगशमनं सर्वपीडाहरं शुभम् ।",
          "iast": "kuṣṭhādi rōgaśamanaṃ sarvapīḍāharaṃ śubham ।"
        },
        {
          "n": 82,
          "devanagari": "कविताशास्त्रविज्ञानप्रदं वादिजयप्रदम् ॥ २४॥",
          "iast": "kavitāśāstravijñānapradaṃ vādijayapradam ॥ 24॥"
        }
      ]
    },
    {
      "label": "25",
      "lines": [
        {
          "n": 83,
          "devanagari": "सर्वसाध्वसरक्षार्थं ब्रह्मास्त्रसदृशं कलौ ॥ २५॥",
          "iast": "sarvasādhvasarakṣārthaṃ brahmāstrasadṛśaṃ kalau ॥ 25॥"
        }
      ]
    },
    {
      "label": "26",
      "lines": [
        {
          "n": 84,
          "devanagari": "वन्दे श्रीगुरुराजमुग्रतपसं सर्वारिदर्पापहं",
          "iast": "vandē śrīgururājamugratapasaṃ sarvāridarpāpahaṃ"
        },
        {
          "n": 85,
          "devanagari": "देवेन्द्राभसमृद्धसम्पदममुं भक्तिप्रियं सद्गुरुम् ।",
          "iast": "dēvēndrābhasamṛddhasampadamamuṃ bhaktipriyaṃ sadgurum ।"
        },
        {
          "n": 86,
          "devanagari": "भक्तत्राणनबद्धकङ्कणमसद्बाधाहरं स्वर्गवी-",
          "iast": "bhaktatrāṇanabaddhakaṅkaṇamasadbādhāharaṃ svargavī-"
        },
        {
          "n": 87,
          "devanagari": "स्वारत्नस्वरगात्युदारहृदयं तं रिष्टतातिं प्रभुम् ॥ २६॥",
          "iast": "svāratnasvaragātyudārahṛdayaṃ taṃ riṣṭatātiṃ prabhum ॥ 26॥"
        }
      ]
    }
  ]
}
